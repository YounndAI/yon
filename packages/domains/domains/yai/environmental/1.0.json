{
  "$schema": "https://domains.younndai.com/schemas/domain.json",
  "domain": "yai.environmental",
  "version": "1.0",
  "status": "active",
  "tier": "official",
  "verified": true,
  "score": 1,
  "notice": null,
  "description": "Corporate sustainability reporting, GHG inventories, ESG disclosure, and EU Taxonomy alignment",
  "defaultMode": "struct",
  "defaultProfile": "core",
  "defaultFormat": "canon",
  "records": [
    {
      "tag": "DISCLOSURE",
      "description": "ESG disclosure — framework-aligned sustainability metric reported per GRI, ISSB, or CSRD requirements",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "disc:GRI-305-1-2026"
        },
        {
          "name": "framework",
          "type": "string",
          "required": false,
          "enum": [
            "GRI",
            "ISSB",
            "CDP",
            "TCFD",
            "CSRD",
            "SEC",
            "SASB",
            "TNFD"
          ],
          "description": "Reporting Framework (8 allowed values)",
          "example": "GRI"
        },
        {
          "name": "period",
          "type": "string",
          "required": false,
          "description": "Reporting Period",
          "example": "2026-FY"
        },
        {
          "name": "standard_ref",
          "type": "string",
          "required": false,
          "description": "Standard Reference",
          "example": "GRI 305-1"
        },
        {
          "name": "metric",
          "type": "string",
          "required": false,
          "description": "Metric Name",
          "example": "Direct GHG emissions (Scope 1)"
        },
        {
          "name": "value",
          "type": "float",
          "required": false,
          "description": "Value",
          "example": "12450.0"
        },
        {
          "name": "unit",
          "type": "string",
          "required": false,
          "description": "Unit",
          "example": "tCO₂e"
        },
        {
          "name": "assured",
          "type": "bool",
          "required": false,
          "description": "Externally Assured indicator",
          "example": "true"
        },
        {
          "name": "assurer",
          "type": "string",
          "required": false,
          "description": "Assurance Provider",
          "example": "PwC"
        },
        {
          "name": "comparable",
          "type": "bool",
          "required": false,
          "description": "Comparable YoY indicator",
          "example": "true"
        }
      ]
    },
    {
      "tag": "GHG_INVENTORY",
      "description": "Greenhouse gas inventory — corporate emissions accounting per GHG Protocol and ISO 14064",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "ghg:2026-scope1-natgas"
        },
        {
          "name": "scope",
          "type": "int",
          "required": false,
          "range": [
            1,
            3
          ],
          "description": "GHG Scope (1–3) (1–3)",
          "example": "1"
        },
        {
          "name": "category",
          "type": "string",
          "required": false,
          "description": "Scope 3 Category",
          "example": "Category 6 – Business Travel"
        },
        {
          "name": "source",
          "type": "string",
          "required": false,
          "description": "Emission Source",
          "example": "Natural gas combustion"
        },
        {
          "name": "co2e_tonnes",
          "type": "float",
          "required": false,
          "description": "CO₂ Equivalent in tonnes",
          "unit": "tonnes",
          "example": "1247.3"
        },
        {
          "name": "methodology",
          "type": "string",
          "required": false,
          "enum": [
            "ghg-protocol",
            "iso-14064",
            "epa-mandatory",
            "defra",
            "ipcc-tier-1",
            "ipcc-tier-2",
            "ipcc-tier-3"
          ],
          "description": "Methodology (7 allowed values)",
          "example": "ghg-protocol"
        },
        {
          "name": "base_year",
          "type": "int",
          "required": false,
          "description": "Base Year",
          "example": "2019"
        },
        {
          "name": "reporting_year",
          "type": "int",
          "required": false,
          "description": "Reporting Year",
          "example": "2026"
        },
        {
          "name": "verified",
          "type": "bool",
          "required": false,
          "description": "Third-Party Verified indicator",
          "example": "true"
        },
        {
          "name": "uncertainty_pct",
          "type": "float",
          "required": false,
          "description": "Uncertainty in %",
          "unit": "%",
          "example": "5.0"
        }
      ]
    },
    {
      "tag": "TARGET",
      "description": "Science-based target — emissions reduction commitment with SBTi pathway alignment",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "tgt:scope1-2-nearterm"
        },
        {
          "name": "scope",
          "type": "int",
          "required": false,
          "range": [
            1,
            3
          ],
          "description": "GHG Scope (1–3) (1–3)",
          "example": "1"
        },
        {
          "name": "baseline_year",
          "type": "int",
          "required": false,
          "description": "Baseline Year",
          "example": "2019"
        },
        {
          "name": "baseline_value",
          "type": "float",
          "required": false,
          "description": "Baseline Value in tCO₂e",
          "unit": "tCO₂e",
          "example": "15000.0"
        },
        {
          "name": "target_year",
          "type": "int",
          "required": false,
          "description": "Target Year",
          "example": "2030"
        },
        {
          "name": "reduction_pct",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "Reduction Target in % (0–100)",
          "unit": "%",
          "example": "42.0"
        },
        {
          "name": "pathway",
          "type": "string",
          "required": false,
          "enum": [
            "1.5C",
            "well-below-2C",
            "2C",
            "net-zero"
          ],
          "description": "Temperature Pathway: 1.5C, well-below-2C, 2C, net-zero",
          "example": "1.5C"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "committed",
            "submitted",
            "validated",
            "approved",
            "achieved",
            "expired"
          ],
          "description": "Target Status (6 allowed values)",
          "example": "validated"
        },
        {
          "name": "sbti_validated",
          "type": "bool",
          "required": false,
          "description": "SBTi Validated indicator",
          "example": "true"
        },
        {
          "name": "near_term",
          "type": "bool",
          "required": false,
          "description": "Near-Term Target indicator",
          "example": "true"
        }
      ]
    },
    {
      "tag": "WATER",
      "description": "Water stewardship — withdrawal, consumption, and discharge metrics per CDP Water and GRI 303",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "wtr:plant-A-2026-Q1"
        },
        {
          "name": "source",
          "type": "string",
          "required": false,
          "enum": [
            "surface",
            "ground",
            "municipal",
            "rainwater",
            "seawater",
            "produced",
            "wastewater-third-party"
          ],
          "description": "Water Source (7 allowed values)",
          "example": "municipal"
        },
        {
          "name": "withdrawal_m3",
          "type": "float",
          "required": false,
          "description": "Withdrawal in m³",
          "unit": "m³",
          "example": "25000.0"
        },
        {
          "name": "consumption_m3",
          "type": "float",
          "required": false,
          "description": "Consumption in m³",
          "unit": "m³",
          "example": "18000.0"
        },
        {
          "name": "discharge_m3",
          "type": "float",
          "required": false,
          "description": "Discharge in m³",
          "unit": "m³",
          "example": "7000.0"
        },
        {
          "name": "stress_level",
          "type": "string",
          "required": false,
          "enum": [
            "low",
            "low-medium",
            "medium-high",
            "high",
            "extremely-high"
          ],
          "description": "Water Stress Level: low, low-medium, medium-high, high, extremely-high",
          "example": "medium-high"
        },
        {
          "name": "quality",
          "type": "string",
          "required": false,
          "description": "Discharge Quality",
          "example": "BOD < 20 mg/L"
        },
        {
          "name": "facility",
          "type": "string",
          "required": false,
          "description": "Facility",
          "example": "Manufacturing Plant A"
        },
        {
          "name": "recycled_pct",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "Recycled Percentage in % (0–100)",
          "unit": "%",
          "example": "35.0"
        }
      ]
    },
    {
      "tag": "WASTE",
      "description": "Waste management — generation, diversion, and disposition tracking per GRI 306",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "wst:plant-A-2026-Q1-hazard"
        },
        {
          "name": "type",
          "type": "string",
          "required": false,
          "enum": [
            "non-hazardous",
            "hazardous",
            "radioactive",
            "electronic",
            "construction-demolition",
            "organic",
            "medical"
          ],
          "description": "Waste Type (7 allowed values)",
          "example": "hazardous"
        },
        {
          "name": "disposition",
          "type": "string",
          "required": false,
          "enum": [
            "recycled",
            "composted",
            "incinerated-energy-recovery",
            "incinerated",
            "landfill",
            "recovered",
            "reused",
            "deep-well-injection"
          ],
          "description": "Disposition Method (8 allowed values)",
          "example": "recycled"
        },
        {
          "name": "weight_tonnes",
          "type": "float",
          "required": false,
          "description": "Weight in tonnes",
          "unit": "tonnes",
          "example": "42.5"
        },
        {
          "name": "diversion_rate_pct",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "Diversion Rate in % (0–100)",
          "unit": "%",
          "example": "78.0"
        },
        {
          "name": "facility",
          "type": "string",
          "required": false,
          "description": "Facility",
          "example": "Manufacturing Plant A"
        },
        {
          "name": "reporting_year",
          "type": "int",
          "required": false,
          "description": "Reporting Year",
          "example": "2026"
        }
      ]
    },
    {
      "tag": "TAXONOMY_ALIGNMENT",
      "description": "EU Taxonomy alignment — activity-level classification with DNSH and substantial contribution criteria",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "tax:solar-gen-2026"
        },
        {
          "name": "activity",
          "type": "string",
          "required": false,
          "description": "Economic Activity",
          "example": "Electricity generation from solar PV"
        },
        {
          "name": "nace_code",
          "type": "string",
          "required": false,
          "description": "NACE Code",
          "example": "D35.11"
        },
        {
          "name": "objective",
          "type": "string",
          "required": false,
          "enum": [
            "climate-mitigation",
            "climate-adaptation",
            "water-marine",
            "circular-economy",
            "pollution-prevention",
            "biodiversity"
          ],
          "description": "Environmental Objective (6 allowed values)",
          "example": "climate-mitigation"
        },
        {
          "name": "eligible",
          "type": "bool",
          "required": false,
          "description": "Taxonomy Eligible indicator",
          "example": "true"
        },
        {
          "name": "aligned",
          "type": "bool",
          "required": false,
          "description": "Taxonomy Aligned indicator",
          "example": "true"
        },
        {
          "name": "turnover_pct",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "Turnover Allocation in % (0–100)",
          "unit": "%",
          "example": "22.0"
        },
        {
          "name": "capex_pct",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "CapEx Allocation in % (0–100)",
          "unit": "%",
          "example": "35.0"
        },
        {
          "name": "opex_pct",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "OpEx Allocation in % (0–100)",
          "unit": "%",
          "example": "18.0"
        },
        {
          "name": "dnsh_met",
          "type": "bool",
          "required": false,
          "description": "DNSH Criteria Met indicator",
          "example": "true"
        },
        {
          "name": "minimum_safeguards",
          "type": "bool",
          "required": false,
          "description": "Minimum Safeguards Met indicator",
          "example": "true"
        }
      ]
    }
  ],
  "meta": {
    "tagline": "Corporate sustainability and ESG disclosure for climate AI",
