          "Track @WASTE generation and diversion rates",
          "Assess @BIODIVERSITY impact near operational sites",
          "File @COMPLIANCE_EVENT reports for regulatory agencies"
        ],
        "example": "@AIR_QUALITY rid=aq:1 | pollutant=\"PM2.5\" | value:float=18.3 | unit=\"µg/m³\" | aqi:int=63 | status=\"moderate\"",
        "tags_used": [
          "WATER",
          "WASTE"
        ],
        "description": "Deploy sensor networks for continuous air, water, soil, and wildlife monitoring. Trigger alerts when measurements breach regulatory thresholds or baseline deviations.",
