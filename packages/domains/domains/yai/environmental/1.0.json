        "id": "carbon-accounting",
        "title": "Enterprise Carbon Accounting Pipeline",
        "steps": [
          "Collect Scope 1 direct @EMISSION from facility meters",
          "Calculate Scope 2 @EMISSION from energy consumption data",
          "Estimate Scope 3 @EMISSION across value chain",
          "Validate against @COMPLIANCE_EVENT regulatory thresholds",
          "Generate CSRD/SEC climate disclosure report"
        ],
        "example": "@EMISSION rid=em:1 | scope=\"scope-1\" | co2e_tonnes:float=1247.3 | source=\"natural_gas\" | verified:bool=true",
