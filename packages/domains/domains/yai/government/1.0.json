{
  "$schema": "https://domains.younndai.com/schemas/domain.json",
  "domain": "yai.government",
  "version": "1.0",
  "status": "active",
  "tier": "official",
  "verified": true,
  "score": 1,
  "notice": null,
  "description": "Civic administration, public services, procurement, and regulatory management",
  "defaultMode": "struct",
  "defaultProfile": "audit",
  "defaultFormat": "canon",
  "records": [
    {
      "tag": "PERMIT",
      "description": "Government permit or license — application tracking with jurisdiction and conditions",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "pmt:BLD-2026-042"
        },
        {
          "name": "type",
          "type": "string",
          "required": false,
          "description": "Permit Type",
          "example": "building"
        },
        {
          "name": "applicant_encrypted",
          "type": "string",
          "required": false,
          "description": "Applicant (Encrypted)",
          "example": "enc:aes256:..."
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "applied",
            "under-review",
            "approved",
            "denied",
            "expired",
            "revoked"
          ],
          "description": "Permit Status (6 allowed values)",
          "example": "approved"
        },
        {
          "name": "issued",
          "type": "ts",
          "required": false,
          "description": "Issue Date as ISO 8601 timestamp",
          "example": "2026-02-15T00:00:00Z"
        },
        {
          "name": "expires",
          "type": "ts",
          "required": false,
          "description": "Expiry Date as ISO 8601 timestamp",
          "example": "2027-02-15T00:00:00Z"
        },
        {
          "name": "jurisdiction",
          "type": "string",
          "required": false,
          "description": "Jurisdiction",
          "example": "City of Portland"
        },
        {
          "name": "conditions",
          "type": "string",
          "required": false,
          "description": "Conditions",
          "example": "Fire suppression required; ADA compliance"
        },
        {
          "name": "fee",
          "type": "float",
          "required": false,
          "description": "Permit Fee in USD",
          "unit": "USD",
          "example": "750.00"
        }
      ]
    },
    {
      "tag": "CASE",
      "description": "Administrative case — government matter with assignment and docket tracking",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "cas:CE-2026-142"
        },
        {
          "name": "type",
          "type": "string",
          "required": false,
          "description": "Case Type",
          "example": "code-enforcement"
        },
        {
          "name": "parties_encrypted",
          "type": "string",
          "required": false,
          "description": "Parties (Encrypted)",
          "example": "enc:aes256:..."
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "open",
            "assigned",
            "under-review",
            "hearing",
            "decided",
            "closed",
            "appealed"
          ],
          "description": "Case Status (7 allowed values)",
          "example": "under-review"
        },
        {
          "name": "assigned_to",
          "type": "string",
          "required": false,
          "description": "Assigned To",
          "example": "Inspector Williams"
        },
        {
          "name": "priority",
          "type": "string",
          "required": false,
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ],
          "description": "Priority: low, normal, high, urgent",
          "example": "high"
        },
        {
          "name": "opened",
          "type": "ts",
          "required": false,
          "description": "Opened Date as ISO 8601 timestamp",
          "example": "2026-01-20T00:00:00Z"
        },
        {
          "name": "jurisdiction",
          "type": "string",
          "required": false,
          "description": "Jurisdiction",
          "example": "Multnomah County"
        },
        {
          "name": "docket_no",
          "type": "string",
          "required": false,
          "description": "Docket Number",
          "example": "2026-CE-0142"
        }
      ]
    },
    {
      "tag": "SERVICE_REQUEST",
      "description": "Citizen service request — 311-style intake with SLA and department routing",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "sr:311-2026-4200"
        },
        {
          "name": "service_type",
          "type": "string",
          "required": false,
          "description": "Service Type",
          "example": "pothole-repair"
        },
        {
          "name": "requestor_encrypted",
          "type": "string",
          "required": false,
          "description": "Requestor (Encrypted)",
          "example": "enc:aes256:..."
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "submitted",
            "acknowledged",
            "in-progress",
            "completed",
            "closed"
          ],
          "description": "Request Status: submitted, acknowledged, in-progress, completed, closed",
          "example": "in-progress"
        },
        {
          "name": "submitted",
          "type": "ts",
          "required": false,
          "description": "Submitted Date as ISO 8601 timestamp",
          "example": "2026-02-20T09:30:00Z"
        },
        {
          "name": "resolved",
          "type": "ts",
          "required": false,
          "description": "Resolved Date as ISO 8601 timestamp",
          "example": "2026-02-22T14:00:00Z"
        },
        {
          "name": "channel",
          "type": "string",
          "required": false,
          "enum": [
            "web",
            "phone",
            "in-person",
            "app",
            "email"
          ],
          "description": "Intake Channel: web, phone, in-person, app, email",
          "example": "app"
        },
        {
          "name": "department",
          "type": "string",
          "required": false,
          "description": "Department",
          "example": "Public Works"
        },
        {
          "name": "sla_hours",
          "type": "int",
          "required": false,
          "description": "SLA Target in hours",
          "unit": "hours",
          "example": "48"
        }
      ]
    },
    {
      "tag": "REGULATION",
      "description": "Regulatory item — codified rule with effective date and supersession chain",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "reg:EPA-HQ-2026-001"
        },
        {
          "name": "code",
          "type": "string",
          "required": false,
          "description": "Regulation Code",
          "example": "40 CFR 60.5397a"
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "Title",
          "example": "Standards of Performance for Crude Oil and Natural Gas"
        },
        {
          "name": "effective_date",
          "type": "ts",
          "required": false,
          "description": "Effective Date as ISO 8601 timestamp",
          "example": "2026-07-01T00:00:00Z"
        },
        {
          "name": "agency",
          "type": "string",
          "required": false,
          "description": "Issuing Agency",
          "example": "EPA"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "proposed",
            "final",
            "effective",
            "amended",
            "repealed"
          ],
          "description": "Status: proposed, final, effective, amended, repealed",
          "example": "final"
        },
        {
          "name": "supersedes",
          "type": "string",
          "required": false,
          "description": "Supersedes",
          "example": "reg:EPA-HQ-2024-100"
        },
        {
          "name": "cfr_ref",
          "type": "string",
          "required": false,
          "description": "CFR Reference",
          "example": "40 CFR Part 60"
        },
        {
          "name": "jurisdiction",
          "type": "string",
          "required": false,
          "description": "Jurisdiction",
          "example": "Federal (US)"
        }
      ]
    },
    {
      "tag": "PROCUREMENT",
      "description": "Public procurement — competitive bid with award tracking",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "proc:GSA-2026-042"
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "Solicitation Title",
          "example": "IT Infrastructure Modernization"
        },
        {
          "name": "agency",
          "type": "string",
          "required": false,
          "description": "Procuring Agency",
          "example": "GSA"
        },
        {
          "name": "value",
          "type": "float",
          "required": false,
          "description": "Contract Value",
          "example": "2500000.00"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "solicitation",
            "evaluation",
            "awarded",
            "protested",
            "cancelled"
          ],
          "description": "Procurement Status: solicitation, evaluation, awarded, protested, cancelled",
          "example": "awarded"
        },
        {
          "name": "vendor",
          "type": "string",
          "required": false,
          "description": "Awarded Vendor",
          "example": "TechCorp Inc."
        },
        {
          "name": "award_date",
          "type": "ts",
          "required": false,
          "description": "Award Date as ISO 8601 timestamp",
          "example": "2026-03-15T00:00:00Z"
        },
        {
          "name": "contract_type",
          "type": "string",
          "required": false,
          "enum": [
            "firm-fixed",
            "cost-plus",
            "time-materials",
            "idiq",
            "bpa"
          ],
          "description": "Contract Type: firm-fixed, cost-plus, time-materials, idiq, bpa",
          "example": "firm-fixed"
        },
        {
          "name": "solicitation_no",
          "type": "string",
          "required": false,
          "description": "Solicitation Number",
          "example": "47QFCA-26-R-0042"
        }
      ]
    },
    {
      "tag": "BENEFIT",
      "description": "Government benefit or grant — program disbursement with eligibility tracking",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "ben:SNAP-2026-42000"
        },
        {
          "name": "program",
          "type": "string",
          "required": false,
          "description": "Benefit Program",
          "example": "SNAP"
        },
        {
          "name": "recipient_encrypted",
          "type": "string",
          "required": false,
          "description": "Recipient (Encrypted)",
          "example": "enc:aes256:..."
        },
        {
          "name": "amount",
          "type": "float",
          "required": false,
          "description": "Benefit Amount in USD",
          "unit": "USD",
          "example": "425.00"
        },
        {
          "name": "period",
          "type": "string",
          "required": false,
          "description": "Benefit Period",
          "example": "2026-03"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "applied",
            "eligible",
            "approved",
            "disbursed",
            "denied",
            "terminated"
          ],
          "description": "Benefit Status (6 allowed values)",
          "example": "disbursed"
        },
        {
          "name": "eligibility",
          "type": "string",
          "required": false,
          "description": "Eligibility Criteria",
          "example": "Income < 130% FPL, household size 3"
        },
        {
          "name": "disbursed",
          "type": "bool",
          "required": false,
          "description": "Disbursed indicator",
          "example": "true"
        }
      ]
    }
  ],
  "meta": {
    "tagline": "Civic administration and public services for GovTech AI",
    "highlights": [
      "PERMIT",
