    ],
    "use_cases": [
      {
        "id": "digital-services",
        "title": "Digital Government Service Delivery",
        "steps": [
          "Authenticate @CITIZEN via eIDAS-compliant digital identity",
          "Submit @SERVICE_REQUEST through unified portal",
          "Attach supporting @DOCUMENT with digital signatures",
          "Route request through departmental workflow",
          "Issue @DOCUMENT response with legally-binding certification"
        ],
        "example": "@SERVICE_REQUEST rid=sr:1 | type=\"building-permit\" | status=\"under-review\" | submitted=\"2026-02-15\" | department=\"urban-planning\"",
        "tags_used": [
          "SERVICE_REQUEST"
        ],
        "description": "Manage citizen service requests from intake through resolution with SLA tracking, department routing, and multi-channel access (web, phone, in-person, app).",
        "tags": [
          "SERVICE_REQUEST",
          "PERMIT",
          "CASE",
          "BENEFIT"
        ],
        "tags_planned": [
          "CITIZEN",
          "DOCUMENT"
        ]
      },
      {
        "id": "fiscal-transparency",
        "title": "Public Budget Transparency",
        "steps": [
          "Publish @BUDGET allocations in machine-readable XBRL format",
          "Track expenditure against @BUDGET line items",
          "Cross-reference spending with @ORDINANCE appropriation authority",
          "Generate citizen-facing @BUDGET visualization dashboards",
          "File @ELECTION campaign finance disclosures"
        ],
        "example": "@BUDGET rid=bg:1 | fiscal_year:int=2026 | department=\"health\" | allocated:float=12500000.0 | spent:float=8750000.0 | status=\"active\"",
        "tags_used": [],
        "description": "Track procurement solicitations, contract awards, and benefit disbursements with full audit trails. Generate public dashboards showing spending by agency and program.",
        "tags": [
          "PROCUREMENT",
          "BENEFIT",
          "REGULATION",
