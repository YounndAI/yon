      },
      "VEHICLE_POSITION": {
        "purpose": "Real-time GPS position of a transit vehicle with occupancy and congestion status",
        "when_to_use": "Live vehicle tracking, arrival prediction, crowding alerts, fleet management",
        "related_standards": [
          "GTFS Realtime VehiclePosition",
