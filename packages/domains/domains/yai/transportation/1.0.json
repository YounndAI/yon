          "MDS"
        ]
      },
      "ALERT": {
        "purpose": "Service disruption notice with structured cause, effect, severity, and temporal scope",
        "when_to_use": "Delay notifications, detour announcements, service suspensions, planned engineering works",
        "related_standards": [
          "GTFS Realtime Alert",
