  "meta": {
    "tagline": "Hotel operations and guest experience for hospitality AI",
    "highlights": [
      "PROPERTY",
      "RESERVATION",
      "REVIEW"
    ],
    "use_cases": [
      {
        "id": "guest-journey",
        "title": "End-to-End Guest Journey Orchestration",
        "steps": [
          "Create @RESERVATION with room type, dates, and rate plan",
          "Build @GUEST profile with preferences and loyalty tier",
          "Assign @ROOM based on availability and guest preference",
          "Track charges on @FOLIO throughout the stay",
          "Trigger @HOUSEKEEPING workflow on checkout"
        ],
        "example": "@RESERVATION rid=res:1 | guest_ref=\"gst:42\" | room_type=\"deluxe\" | check_in=\"2026-03-10\" | check_out=\"2026-03-14\" | status=\"confirmed\"",
        "tags_used": [
          "RESERVATION"
        ],
        "description": "Manage the complete guest lifecycle from reservation through checkout, including room allocation, amenity requests, dining, and loyalty program integration.",
        "tags": [
          "RESERVATION",
          "GUEST",
          "ROOM",
          "AMENITY",
          "DINING",
          "REVIEW"
        ],
        "tags_planned": [
          "GUEST",
          "ROOM",
          "FOLIO",
          "HOUSEKEEPING"
        ]
      },
      {
        "id": "revenue-optimization",
        "title": "Revenue Management and Optimization",
        "steps": [
          "Analyze @RESERVATION demand patterns by season and channel",
          "Adjust @ROOM pricing using yield management algorithms",
          "Upsell @AMENITY packages during booking and check-in",
          "Monitor @FOLIO average daily rate (ADR) and RevPAR",
          "Forecast occupancy from @RESERVATION pipeline"
        ],
        "example": "@ROOM rid=rm:1 | number=\"1204\" | type=\"suite\" | rate:float=450.0 | status=\"available\" | floor:int=12",
        "tags_used": [
          "RESERVATION"
        ],
        "description": "Analyze booking patterns, occupancy rates, and competitive pricing to dynamically adjust room rates. Factor in seasonal demand, events, and channel mix for yield optimization.",
        "tags": [
          "RESERVATION",
          "ROOM",
          "GUEST",
          "REVIEW"
        ],
        "tags_planned": [
          "ROOM",
          "AMENITY",
          "FOLIO"
        ]
      }
    ],
