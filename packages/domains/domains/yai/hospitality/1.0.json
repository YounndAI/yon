          "description": "Total Rooms",
          "example": "271"
        },
        {
          "name": "address",
          "type": "string",
          "required": false,
          "description": "Address",
          "example": "Apollolaan 138, Amsterdam"
        },
        {
          "name": "lat",
          "type": "float",
          "required": false,
          "range": [
            -90,
            90
