        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "prop:hilton-ams-01"
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Property Name",
          "example": "Hilton Amsterdam"
        },
        {
          "name": "brand",
          "type": "string",
          "required": false,
          "description": "Brand",
          "example": "Hilton Hotels & Resorts"
        },
        {
          "name": "chain",
          "type": "string",
          "required": false,
          "description": "Chain",
          "example": "Hilton"
        },
        {
          "name": "star_rating",
          "type": "int",
          "required": false,
          "range": [
            1,
            5
