{
  "$schema": "https://domains.younndai.com/schemas/domain.json",
  "domain": "yai.gaming",
  "version": "1.0",
  "status": "active",
  "tier": "official",
  "verified": true,
  "score": 1,
  "notice": null,
  "description": "Game economy, progression systems, moderation, and player interaction analytics",
  "defaultMode": "struct",
  "defaultProfile": "core",
  "defaultFormat": "canon",
  "records": [
    {
      "tag": "PLAYER",
      "description": "Player identity — anonymized profile with level, rank, and account status",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "plr:42"
        },
        {
          "name": "username",
          "type": "string",
          "required": false,
          "description": "Username",
          "example": "ShadowRacer"
        },
        {
          "name": "level",
          "type": "int",
          "required": false,
          "description": "Level",
          "example": "57"
        },
        {
          "name": "rank",
          "type": "string",
          "required": false,
          "description": "Rank",
          "example": "Diamond II"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "active",
            "banned",
            "suspended",
            "inactive"
          ],
          "description": "Account Status: active, banned, suspended, inactive",
          "example": "active"
        },
        {
          "name": "playtime_hours",
          "type": "float",
          "required": false,
          "description": "Total Playtime in hours",
          "unit": "hours",
          "example": "342.5"
        },
        {
          "name": "region",
          "type": "string",
          "required": false,
          "description": "Region",
          "example": "EU-West"
        }
      ]
    },
    {
      "tag": "ITEM",
      "description": "In-game item — virtual asset with rarity, value, and tradability",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "itm:sword-of-dawn"
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Item Name",
          "example": "Sword of Dawn"
        },
        {
          "name": "type",
          "type": "string",
          "required": false,
          "enum": [
            "weapon",
            "armor",
            "consumable",
            "material",
            "cosmetic",
            "currency",
            "key"
          ],
          "description": "Item Type (7 allowed values)",
          "example": "weapon"
        },
        {
          "name": "rarity",
          "type": "string",
          "required": false,
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "legendary",
            "mythic"
          ],
          "description": "Rarity (6 allowed values)",
          "example": "legendary"
        },
        {
          "name": "value",
          "type": "float",
          "required": false,
          "description": "In-Game Value",
          "example": "5000.0"
        },
        {
          "name": "tradable",
          "type": "bool",
          "required": false,
          "description": "Tradable indicator",
          "example": "true"
        },
        {
          "name": "bound",
          "type": "bool",
          "required": false,
          "description": "Soulbound indicator",
          "example": "false"
        }
      ]
    },
    {
      "tag": "MATCH",
      "description": "Game match — session result with participants, outcome, and MMR adjustment",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "m:ranked-1847"
        },
        {
          "name": "mode",
          "type": "string",
          "required": false,
          "enum": [
            "ranked",
            "casual",
            "tournament",
            "custom",
            "practice",
            "co-op"
          ],
          "description": "Game Mode (6 allowed values)",
          "example": "ranked"
        },
        {
          "name": "map",
          "type": "string",
          "required": false,
          "description": "Map",
          "example": "Crimson Arena"
        },
        {
          "name": "duration_sec",
          "type": "int",
          "required": false,
          "description": "Duration in seconds",
          "unit": "seconds",
          "example": "1847"
        },
        {
          "name": "players",
          "type": "int",
          "required": false,
          "description": "Player Count",
          "example": "10"
        },
        {
          "name": "winner",
          "type": "string",
          "required": false,
          "description": "Winner",
          "example": "plr:42"
        },
        {
          "name": "score",
          "type": "string",
          "required": false,
          "description": "Final Score",
          "example": "3-2"
        },
        {
          "name": "mmr_delta",
          "type": "int",
          "required": false,
          "description": "MMR Delta",
          "example": "18"
        }
      ]
    },
    {
      "tag": "ACHIEVEMENT",
      "description": "Achievement or trophy — unlockable milestone with progress tracking",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "ach:first-blood"
        },
        {
          "name": "player_ref",
          "type": "string",
          "required": false,
          "description": "Player Reference",
          "example": "plr:42"
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Achievement Name",
          "example": "First Blood"
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "description": "Description",
          "example": "Win your first ranked match"
        },
        {
          "name": "progress_pct",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "Progress in % (0–100)",
          "unit": "%",
          "example": "100.0"
        },
        {
          "name": "unlocked",
          "type": "bool",
          "required": false,
          "description": "Unlocked indicator",
          "example": "true"
        },
        {
          "name": "rarity",
          "type": "string",
          "required": false,
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "legendary"
          ],
          "description": "Rarity: common, uncommon, rare, epic, legendary",
          "example": "uncommon"
        }
      ]
    },
    {
      "tag": "ECONOMY",
      "description": "Virtual economy event — currency flow with source, sink, and balance tracking",
      "fields": [
        {
          "name": "player_ref",
          "type": "string",
          "required": false,
          "description": "Player Reference",
          "example": "plr:42"
        },
        {
          "name": "currency",
          "type": "string",
          "required": false,
          "description": "Currency",
          "example": "gold"
        },
        {
          "name": "amount",
          "type": "float",
          "required": false,
          "description": "Amount in units",
          "unit": "units",
          "example": "500.0"
        },
        {
          "name": "balance",
          "type": "float",
          "required": false,
          "description": "Balance After",
          "example": "12500.0"
        },
        {
          "name": "source",
          "type": "string",
          "required": false,
          "enum": [
            "quest",
            "trade",
            "purchase",
            "drop",
            "craft",
            "reward",
            "admin"
          ],
          "description": "Source/Sink (7 allowed values)",
          "example": "quest"
        },
        {
          "name": "ts",
          "type": "ts",
          "required": false,
          "description": "Timestamp as ISO 8601 timestamp",
          "example": "2026-03-01T14:30:00Z"
        }
      ]
    },
    {
      "tag": "QUEST",
      "description": "Quest or mission — structured objective with reward and prerequisite chain",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "q:defend-the-keep"
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "Quest Title",
          "example": "Defend the Keep"
        },
        {
          "name": "type",
          "type": "string",
          "required": false,
          "enum": [
            "main",
            "side",
            "daily",
            "weekly",
            "event",
            "hidden"
          ],
          "description": "Quest Type (6 allowed values)",
          "example": "daily"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "available",
            "accepted",
            "in-progress",
            "completed",
            "failed",
            "expired"
          ],
          "description": "Quest Status (6 allowed values)",
          "example": "in-progress"
        },
        {
          "name": "reward",
          "type": "string",
          "required": false,
          "description": "Reward (JSON)",
          "example": "itm:health-potion x3"
        },
        {
          "name": "xp",
          "type": "int",
          "required": false,
          "description": "XP Reward",
          "example": "250"
        },
        {
          "name": "prerequisite",
          "type": "string",
          "required": false,
          "description": "Prerequisite Quest",
          "example": "q:scout-the-walls"
        }
      ]
    },
    {
      "tag": "BOUNDARY",
      "description": "Game boundary — spatial or rule-based scope definition for play areas",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "bnd:arena-ranked-1"
        },
        {
          "name": "type",
          "type": "string",
          "required": false,
          "enum": [
            "map",
            "zone",
            "region",
            "instance",
            "arena",
            "lobby"
          ],
          "description": "Boundary Type (6 allowed values)",
          "example": "arena"
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Name",
          "example": "Crimson Arena"
        },
        {
          "name": "max_players",
          "type": "int",
          "required": false,
          "description": "Max Players",
          "example": "10"
        },
        {
          "name": "rules",
          "type": "string",
          "required": false,
          "description": "Rules (JSON)",
          "example": "{\"friendly_fire\":false}"
        }
      ]
    },
    {
      "tag": "MOD_LOG",
      "description": "Moderation log — player conduct action with evidence and appeal status",
      "fields": [
        {
          "name": "player_ref",
          "type": "string",
          "required": false,
          "description": "Player Reference",
          "example": "plr:42"
        },
        {
          "name": "violation",
          "type": "string",
          "required": false,
          "description": "Violation",
          "example": "Toxicity in ranked match"
        },
        {
          "name": "action",
          "type": "string",
          "required": false,
          "enum": [
            "warning",
            "mute",
            "kick",
            "temp-ban",
            "permanent-ban"
          ],
          "description": "Action Taken: warning, mute, kick, temp-ban, permanent-ban",
          "example": "temp-ban"
        },
        {
          "name": "moderator",
          "type": "string",
          "required": false,
          "description": "Moderator",
          "example": "mod:admin-07"
        },
        {
          "name": "evidence",
          "type": "string",
          "required": true,
          "description": "Evidence Ref",
          "example": "replay:match-1847"
        },
        {
          "name": "appeal_status",
          "type": "string",
          "required": false,
          "enum": [
            "none",
            "pending",
            "upheld",
            "overturned"
          ],
          "description": "Appeal Status: none, pending, upheld, overturned",
          "example": "pending"
        }
      ]
    },
    {
      "tag": "MOD_ACTION",
      "description": "Moderation action — automated or manual enforcement triggered by behavior detection",
      "fields": [
        {
          "name": "trigger",
          "type": "string",
          "required": false,
          "description": "Trigger Source",
          "example": "anti-cheat-model-v4"
        },
        {
          "name": "action_type",
          "type": "string",
          "required": false,
          "description": "Action Type",
          "example": "temp-ban-7d"
        },
        {
          "name": "automated",
          "type": "bool",
          "required": false,
          "description": "Automated indicator",
          "example": "true"
        },
        {
          "name": "confidence",
          "type": "float",
          "required": false,
          "range": [
            0,
            1
          ],
          "description": "Confidence (0–1) (0–1)",
          "example": "0.92"
        },
        {
          "name": "ts",
          "type": "ts",
          "required": false,
          "description": "Timestamp as ISO 8601 timestamp",
          "example": "2026-03-01T14:35:00Z"
        }
      ]
    },
    {
      "tag": "MOD_INPUT",
      "description": "Moderation input — raw content flagged for review (text, image ref, replay ref)",
      "fields": [
        {
          "name": "player_ref",
          "type": "string",
          "required": true,
          "description": "Player Reference",
          "example": "plr:99"
        },
        {
          "name": "content_type",
          "type": "string",
          "required": false,
          "enum": [
            "text",
            "image",
            "audio",
            "replay",
            "profile"
          ],
          "description": "Content Type: text, image, audio, replay, profile",
          "example": "text"
        },
        {
          "name": "content",
          "type": "string",
          "required": false,
          "description": "Content",
          "example": "Offensive message in chat"
        },
        {
          "name": "flagged_by",
          "type": "string",
          "required": false,
          "description": "Flagged By",
          "example": "plr:42"
        },
        {
          "name": "category",
          "type": "string",
          "required": false,
          "enum": [
            "toxicity",
            "hate-speech",
            "spam",
            "cheating",
            "harassment",
            "inappropriate-content"
          ],
          "description": "Category (6 allowed values)",
          "example": "toxicity"
        },
        {
          "name": "severity",
          "type": "string",
          "required": false,
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Severity: low, medium, high, critical",
          "example": "high"
        }
      ]
    }
  ],
  "meta": {
    "tagline": "Game economy and player systems for gaming AI",
    "highlights": [
      "PLAYER",
      "MATCH",
      "ECONOMY"
    ],
    "use_cases": [
      {
        "id": "live-ops",
        "title": "Live Operations Event Pipeline",
        "steps": [
          "Schedule time-limited @QUEST campaigns with reward tiers",
          "Track @PLAYER engagement via @EVENT telemetry",
          "Update @LEADERBOARD rankings from @MATCH outcomes in real-time",
          "Distribute @INVENTORY_ITEM rewards to top @PLAYER performers",
          "Settle @ECONOMY_TX for premium content purchases"
        ],
        "example": "@MATCH rid=m:1 | mode=\"ranked\" | duration_sec:int=1847 | winner=\"player:42\" | elo_delta:int=18",
        "tags_used": [
          "QUEST",
          "PLAYER",
          "MATCH"
        ],
        "description": "Track player progression, in-game economy transactions, match outcomes, and achievement unlocks in real-time to drive engagement analytics and live-ops decisions.",
        "tags": [
          "PLAYER",
          "MATCH",
          "ECONOMY",
          "ACHIEVEMENT",
          "LEADERBOARD"
        ],
        "tags_planned": [
          "EVENT",
          "LEADERBOARD",
          "INVENTORY_ITEM",
          "ECONOMY_TX"
        ]
      },
      {
        "id": "anti-cheat-fairness",
        "title": "Anti-Cheat and Fairness Analytics",
        "steps": [
          "Analyze @SESSION duration and input patterns for anomalies",
          "Cross-reference @MATCH win-rate spikes with @EVENT telemetry",
          "Flag suspicious @ECONOMY_TX volume per @PLAYER account",
          "Review @ACHIEVEMENT unlock velocity against expected distributions",
          "Issue sanctions and update @PLAYER trust score"
        ],
        "example": "@EVENT rid=ev:1 | player_ref=\"player:42\" | type=\"suspicious_input\" | confidence:float=0.92 | details=\"inhuman reaction time\"",
        "tags_used": [
          "MATCH",
          "PLAYER",
          "ACHIEVEMENT"
        ],
        "description": "Analyze player behavior patterns, flag suspicious activity, process moderation reports, and enforce penalties while maintaining appeal workflows and audit trails.",
        "tags": [
          "MOD_LOG",
          "MOD_INPUT",
          "MATCH",
          "PLAYER",
          "LEADERBOARD"
        ],
        "tags_planned": [
          "SESSION",
          "EVENT",
          "ECONOMY_TX"
        ]
      }
    ],
