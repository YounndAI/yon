        ]
      },
      "PARTICIPANT": {
        "purpose": "Session participant entity (user, agent, or service) with role and access permissions",
        "when_to_use": "Multi-party session management, access control, collaborative editing, agent handoff tracking",
        "related_standards": [
          "W3C WebRTC",
          "Schema.org Person",
          "SCIM 2.0"
        ]
      },
      "TRANSFER": {
        "purpose": "Session ownership or context migration between agents, systems, or environments",
        "when_to_use": "Agent handoff, escalation to human, cross-system context migration, load balancing",
        "related_standards": [
          "ActivityStreams 2.0 (W3C)",
          "MCP Handoff",
          "XMPP MUC"
        ]
      }
    },
    "links": [
      {
        "label": "OASIS WS-Session",
