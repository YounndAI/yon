        "related_standards": [
          "OpenTelemetry Session",
          "W3C Navigation Timing",
          "GA4 Session"
        ]
      },
      "STATE": {
        "purpose": "Key-value snapshot of session variables with versioning and TTL for state persistence",
        "when_to_use": "Session variable persistence, state rehydration, cross-turn context retention, undo/redo support",
        "related_standards": [
          "Redux (de facto)",
