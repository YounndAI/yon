        ]
      },
      "CHECKPOINT": {
        "purpose": "Restorable session snapshot for crash recovery, branching, and milestone preservation",
        "when_to_use": "Session recovery after errors, branching conversations, milestone preservation, rollback support",
        "related_standards": [
          "MLflow Tracking",
