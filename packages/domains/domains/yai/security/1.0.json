{
  "$schema": "https://domains.younndai.com/schemas/domain.json",
  "domain": "yai.security",
  "version": "1.0",
  "status": "active",
  "tier": "official",
  "verified": true,
  "score": 1,
  "notice": null,
  "description": "Cybersecurity operations, incident response, threat intelligence, and vulnerability management with STIX/MITRE ATT&CK alignment",
  "defaultMode": "struct",
  "defaultProfile": "audit",
  "defaultFormat": "canon",
  "records": [
    {
      "tag": "IOC",
      "description": "Indicator of compromise — STIX 2.1 Indicator aligned, observable artifact with detection pattern and temporal validity",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "ioc:2026-0042"
        },
        {
          "name": "type",
          "type": "string",
          "required": false,
          "enum": [
            "ip",
            "domain",
            "hash-md5",
            "hash-sha256",
            "url",
            "email",
            "file",
            "registry-key"
          ],
          "description": "Indicator Type (8 allowed values)",
          "example": "ip"
        },
        {
          "name": "value",
          "type": "string",
          "required": false,
          "description": "Indicator Value",
          "example": "203.0.113.42"
        },
        {
          "name": "pattern",
          "type": "string",
          "required": false,
          "description": "Detection Pattern",
          "example": "[ipv4-addr:value = '203.0.113.42']"
        },
        {
          "name": "pattern_type",
          "type": "string",
          "required": false,
          "enum": [
            "stix",
            "sigma",
            "yara",
            "snort",
            "suricata"
          ],
          "description": "Pattern Type: stix, sigma, yara, snort, suricata",
          "example": "stix"
        },
        {
          "name": "valid_from",
          "type": "ts",
          "required": false,
          "description": "Valid From as ISO 8601 timestamp",
          "example": "2026-03-01T00:00:00Z"
        },
        {
          "name": "valid_until",
          "type": "ts",
          "required": false,
          "description": "Valid Until as ISO 8601 timestamp",
          "example": "2026-06-01T00:00:00Z"
        },
        {
          "name": "confidence",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "Confidence (0–100)",
          "example": "85.0"
        },
        {
          "name": "first_seen",
          "type": "ts",
          "required": false,
          "description": "First Seen as ISO 8601 timestamp",
          "example": "2026-03-01T14:30:00Z"
        },
        {
          "name": "tlp",
          "type": "string",
          "required": false,
          "enum": [
            "white",
            "green",
            "amber",
            "amber-strict",
            "red"
          ],
          "description": "TLP Level: white, green, amber, amber-strict, red",
          "example": "amber"
        },
        {
          "name": "port",
          "type": "int",
          "required": false,
          "range": [
            1,
            65535
          ],
          "description": "Port (1–65535)",
          "example": "443"
        },
        {
          "name": "direction",
          "type": "string",
          "required": false,
          "enum": [
            "inbound",
            "outbound",
            "internal",
            "lateral"
          ],
          "description": "Direction: inbound, outbound, internal, lateral",
          "example": "outbound"
        }
      ]
    },
    {
      "tag": "ASSET",
      "description": "Asset inventory — network-connected resource with criticality rating and patch posture",
      "fields": [
        {
          "name": "host",
          "type": "string",
          "required": false,
          "description": "Hostname",
          "example": "web-prod-01.corp.local"
        },
        {
          "name": "role",
          "type": "string",
          "required": false,
          "enum": [
            "server",
            "workstation",
            "network",
            "storage",
            "cloud",
            "iot",
            "mobile"
          ],
          "description": "Asset Role (7 allowed values)",
          "example": "server"
        },
        {
          "name": "os",
          "type": "string",
          "required": false,
          "description": "Operating System",
          "example": "Ubuntu 24.04 LTS"
        },
        {
          "name": "patch_level",
          "type": "ts",
          "required": false,
          "description": "Patch Level as ISO 8601 timestamp",
          "example": "2026-03-01"
        },
        {
          "name": "criticality",
          "type": "string",
          "required": false,
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "description": "Criticality: critical, high, medium, low",
          "example": "high"
        }
      ]
    },
    {
      "tag": "TLINE",
      "description": "Incident timeline — chronological event during incident response with evidence chain",
      "fields": [
        {
          "name": "ts",
          "type": "ts",
          "required": false,
          "description": "Event Timestamp as ISO 8601 timestamp",
          "example": "2026-03-10T14:32:15Z"
        },
        {
          "name": "action",
          "type": "string",
          "required": false,
          "description": "Action",
          "example": "process_creation"
        },
        {
          "name": "actor",
          "type": "string",
          "required": false,
          "description": "Actor",
          "example": "NT AUTHORITY\\SYSTEM"
        },
        {
          "name": "evidence",
          "type": "string",
          "required": false,
          "description": "Evidence",
          "example": "powershell.exe -enc base64..."
        }
      ]
    },
    {
      "tag": "CONTAINMENT",
      "description": "Containment action — isolation or blocking measures during active incident",
      "fields": [
        {
          "name": "action",
          "type": "string",
          "required": false,
          "enum": [
            "isolate",
            "block-ip",
            "disable-account",
            "quarantine",
            "sinkhole",
            "network-segment"
          ],
          "description": "Containment Action (6 allowed values)",
          "example": "isolate"
        },
        {
          "name": "target",
          "type": "string",
          "required": false,
          "description": "Target",
          "example": "web-prod-01"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "pending",
            "active",
            "completed",
            "failed",
            "rolled-back"
          ],
          "description": "Status: pending, active, completed, failed, rolled-back",
          "example": "active"
        },
        {
          "name": "automated",
          "type": "bool",
          "required": false,
          "description": "Automated indicator",
          "example": "true"
        }
      ]
    },
    {
      "tag": "ERADICATION",
      "description": "Eradication action — removal of threat artifacts and verification of clean state",
      "fields": [
        {
          "name": "action",
          "type": "string",
          "required": false,
          "enum": [
            "malware-removal",
            "credential-reset",
            "patch-apply",
            "reimage",
            "persistence-cleanup",
            "account-disable"
          ],
          "description": "Eradication Action (6 allowed values)",
          "example": "malware-removal"
        },
        {
          "name": "target",
          "type": "string",
          "required": false,
          "description": "Target",
          "example": "web-prod-01"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "pending",
            "in-progress",
            "completed",
            "verified"
          ],
          "description": "Status: pending, in-progress, completed, verified",
          "example": "completed"
        },
        {
          "name": "verification",
          "type": "string",
          "required": false,
          "description": "Verification",
          "example": "EDR clean scan + network baseline restored"
        }
      ]
    },
    {
      "tag": "SIEM_ALERT",
      "description": "SIEM alert — correlated security event from detection rules",
      "fields": [
        {
          "name": "severity",
          "type": "string",
          "required": false,
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Severity: info, low, medium, high, critical",
          "example": "high"
        },
        {
          "name": "rule",
          "type": "string",
          "required": false,
          "description": "Detection Rule",
          "example": "Suspicious PowerShell Execution"
        },
        {
          "name": "source_ip",
          "type": "string",
          "required": false,
          "description": "Source IP",
          "example": "10.0.1.42"
        },
        {
          "name": "dest_ip",
          "type": "string",
          "required": false,
          "description": "Destination IP",
          "example": "203.0.113.42"
        },
        {
          "name": "protocol",
          "type": "string",
          "required": false,
          "enum": [
            "TCP",
            "UDP",
            "ICMP",
            "HTTP",
            "HTTPS",
            "DNS",
            "SSH",
            "SMB",
            "RDP",
            "other"
          ],
          "description": "Protocol (10 allowed values)",
          "example": "TCP"
        }
      ]
    },
    {
      "tag": "VULNERABILITY",
      "description": "Vulnerability record — CVE-referenced finding with CVSS scoring and exploit status",
      "fields": [
        {
          "name": "cve",
          "type": "string",
          "required": false,
          "pattern": "^CVE-\\d{4}-\\d{4,}$",
          "description": "CVE ID in structured format",
          "example": "CVE-2026-1234"
        },
        {
          "name": "cvss",
          "type": "float",
          "required": false,
          "range": [
            0,
            10
          ],
          "description": "CVSS Score in 0-10 (0–10)",
          "unit": "0-10",
          "example": "9.1"
        },
        {
          "name": "severity",
          "type": "string",
          "required": false,
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Severity: none, low, medium, high, critical",
          "example": "critical"
        },
        {
          "name": "affected",
          "type": "string",
          "required": false,
          "description": "Affected System",
          "example": "Apache HTTP Server 2.4.x"
        },
        {
          "name": "patch_available",
          "type": "bool",
          "required": false,
          "description": "Patch Available indicator",
          "example": "true"
        },
        {
          "name": "exploited",
          "type": "bool",
          "required": false,
          "description": "Exploited in Wild indicator",
          "example": "false"
        }
      ]
    },
    {
      "tag": "THREAT",
      "description": "Threat intelligence — STIX ThreatActor aligned, actor profiles and TTP mapping with MITRE ATT&CK and TLP marking",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Threat Actor Name",
          "example": "APT28 (Fancy Bear)"
        },
        {
          "name": "category",
          "type": "string",
          "required": false,
          "enum": [
            "apt",
            "cybercrime",
            "hacktivism",
            "insider",
            "nation-state"
          ],
          "description": "Category: apt, cybercrime, hacktivism, insider, nation-state",
          "example": "apt"
        },
        {
          "name": "confidence",
          "type": "float",
          "required": false,
          "range": [
            0,
            100
          ],
          "description": "Confidence (0–100)",
          "example": "85.0"
        },
        {
          "name": "tlp",
          "type": "string",
          "required": false,
          "enum": [
            "white",
            "green",
            "amber",
            "amber-strict",
            "red"
          ],
          "description": "TLP Level: white, green, amber, amber-strict, red",
          "example": "amber"
        },
        {
          "name": "source",
          "type": "string",
          "required": false,
          "description": "Intelligence Source",
          "example": "CISA Advisory"
        },
        {
          "name": "ttps",
          "type": "string",
          "required": false,
          "description": "TTPs (ATT&CK)",
          "example": "T1566.001, T1059.001, T1003.001"
        },
        {
          "name": "actor",
          "type": "string",
          "required": false,
          "description": "Actor Attribution",
          "example": "GRU Unit 26165"
        }
      ]
    }
  ],
  "meta": {
    "tagline": "Cybersecurity incident response and threat intelligence for AI SOCs",
    "highlights": [
      "IOC",
      "VULNERABILITY",
      "THREAT"
    ],
    "use_cases": [
      {
        "id": "soc-operations",
        "title": "Security Operations Center (SOC) Pipeline",
        "steps": [
          "Ingest @ALERT from SIEM with Sigma rule matching",
          "Correlate @ACCESS_EVENT logs for lateral movement detection",
          "Enrich @THREAT intelligence from STIX/TAXII feeds",
          "Assess @VULNERABILITY exposure in affected systems",
          "Escalate confirmed @INCIDENT with severity and containment plan"
        ],
        "example": "@ALERT rid=al:1 | rule=\"sigma:lateral_movement\" | severity=\"high\" | source_ip=\"10.0.1.42\" | status=\"investigating\"",
        "tags_used": [
          "THREAT",
          "VULNERABILITY"
        ],
        "description": "Correlate SIEM alerts with threat intelligence IOCs, triage incidents, and execute containment/eradication playbooks. Track asset criticality for prioritized response.",
        "tags": [
          "SIEM_ALERT",
          "IOC",
          "TLINE",
          "CONTAINMENT",
          "ERADICATION",
          "ASSET"
        ],
        "tags_planned": [
          "ALERT",
          "ACCESS_EVENT",
          "INCIDENT"
        ]
      },
      {
        "id": "vulnerability-management",
        "title": "Continuous Vulnerability Management",
        "steps": [
          "Execute @SCAN across infrastructure and applications",
          "Prioritize @VULNERABILITY by CVSS score and exploit availability",
          "Map @VULNERABILITY to @THREAT actor TTPs (ATT&CK)",
          "Verify @POLICY compliance against CIS/NIST benchmarks",
          "Track remediation via @CREDENTIAL rotation and patching"
        ],
        "example": "@VULNERABILITY rid=vln:1 | cve=\"CVE-2026-1234\" | cvss:float=9.1 | status=\"open\" | affected_asset=\"web-server-01\"",
        "tags_used": [
          "VULNERABILITY",
          "THREAT"
        ],
        "description": "Scan assets for CVEs, prioritize by CVSS score and exploit availability, and track remediation through patch deployment verification across the network.",
        "tags": [
          "VULNERABILITY",
          "ASSET",
          "THREAT",
          "IOC"
        ],
        "tags_planned": [
          "SCAN",
          "POLICY",
          "CREDENTIAL"
        ]
      }
    ],
