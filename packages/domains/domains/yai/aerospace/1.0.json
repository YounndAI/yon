          "EASA Part-ORO"
        ]
      },
      "MAINTENANCE": {
        "purpose": "Scheduled or unscheduled maintenance action tracked against component lifecycle",
        "when_to_use": "MRO workflows, airworthiness directives, service bulletins, inspection tracking",
        "related_standards": [
          "ATA iSpec 2200",
          "MSG-3",
          "EASA Part-145"
        ]
      },
      "CLEARANCE": {
        "purpose": "Air traffic control instruction with altitude, heading, and speed assignments",
        "when_to_use": "Departure clearance, enroute instructions, approach vectors, holding patterns",
        "related_standards": [
          "ICAO Doc 4444 PANS-ATM",
          "FAA 7110.65",
          "EUROCONTROL ATFM"
        ]
      }
    },
