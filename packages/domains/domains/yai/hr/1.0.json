{
  "$schema": "https://domains.younndai.com/schemas/domain.json",
  "domain": "yai.hr",
  "version": "1.0",
  "status": "active",
  "tier": "official",
  "verified": true,
  "score": 1,
  "notice": null,
  "description": "Workforce management, recruitment, performance tracking, and employee lifecycle operations",
  "defaultMode": "struct",
  "defaultProfile": "core",
  "defaultFormat": "canon",
  "records": [
    {
      "tag": "REQUISITION",
      "description": "Job requisition — headcount request with salary range and remote eligibility",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "req:2026-042"
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "Job Title",
          "example": "Senior Data Engineer"
        },
        {
          "name": "department",
          "type": "string",
          "required": false,
          "description": "Department",
          "example": "Engineering"
        },
        {
          "name": "hiring_manager",
          "type": "string",
          "required": false,
          "description": "Hiring Manager",
          "example": "Sarah Chen"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "enum": [
            "draft",
            "open",
            "interviewing",
            "offer",
            "filled",
            "cancelled"
          ],
          "description": "Requisition Status (6 allowed values)",
          "example": "open"
        },
        {
          "name": "headcount",
          "type": "int",
          "required": false,
          "description": "Headcount",
          "example": "2"
        },
        {
          "name": "priority",
          "type": "string",
          "required": false,
          "enum": [
            "low",
            "normal",
            "high",
            "urgent"
          ],
          "description": "Priority: low, normal, high, urgent",
          "example": "high"
        },
        {
          "name": "location",
          "type": "string",
          "required": false,
          "description": "Location",
          "example": "Berlin, Germany"
        },
        {
          "name": "remote",
          "type": "bool",
          "required": false,
          "description": "Remote Eligible indicator",
          "example": "true"
        },
        {
          "name": "salary_min",
          "type": "float",
          "required": false,
          "description": "Salary Min in EUR/year",
          "unit": "EUR/year",
          "example": "75000.0"
        },
        {
          "name": "salary_max",
          "type": "float",
          "required": false,
          "description": "Salary Max in EUR/year",
          "unit": "EUR/year",
          "example": "95000.0"
        }
      ]
    },
    {
      "tag": "APPLICANT",
      "description": "Job applicant — candidate tracking through hiring pipeline stages",
      "fields": [
        {
          "name": "rid",
          "type": "string",
          "required": true,
          "description": "Record ID",
          "example": "app:2026-1234"
        },
        {
          "name": "requisition_ref",
          "type": "string",
          "required": false,
          "description": "Requisition Reference",
          "example": "req:2026-042"
        },
        {
          "name": "name_encrypted",
          "type": "string",
          "required": false,
          "description": "Name (Encrypted)",
          "example": "enc:aes256:..."
        },
        {
          "name": "stage",
          "type": "string",
          "required": false,
          "enum": [
            "applied",
            "screening",
            "phone-screen",
            "interview",
            "assessment",
            "offer",
            "hired",
            "rejected"
          ],
          "description": "Pipeline Stage (8 allowed values)",
          "example": "interview"
