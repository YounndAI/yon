          "description": "Source (6 allowed values)",
          "example": "linkedin"
        },
        {
          "name": "applied_date",
          "type": "ts",
          "required": false,
          "description": "Applied Date as ISO 8601 timestamp",
          "example": "2026-03-01T00:00:00Z"
        },
        {
          "name": "rating",
          "type": "float",
          "required": false,
          "range": [
            0,
            5
          ],
          "description": "Rating (0–5)",
          "example": "4.2"
        },
        {
          "name": "resume_ref",
          "type": "string",
          "required": false,
          "description": "Resume Reference",
          "example": "doc:resume-1234"
        },
        {
          "name": "referrer",
          "type": "string",
          "required": false,
          "description": "Referrer",
          "example": "emp:42"
        }
      ]
    },
