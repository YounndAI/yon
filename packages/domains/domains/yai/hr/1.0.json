  "meta": {
    "tagline": "Workforce management and recruitment for HR AI",
    "highlights": [
      "REQUISITION",
      "EMPLOYEE",
      "REVIEW"
    ],
    "use_cases": [
      {
        "id": "employee-lifecycle",
        "title": "Employee Lifecycle Management",
        "steps": [
          "Open @POSITION with job description and compensation band",
          "Onboard @EMPLOYEE with benefits enrollment",
          "Configure @BENEFIT elections (health, retirement, PTO)",
          "Process monthly @PAYROLL with tax and deduction calculations",
          "Conduct quarterly @PERFORMANCE reviews with goal tracking"
        ],
        "example": "@EMPLOYEE rid=emp:1 | name=\"Jane Doe\" | position_ref=\"pos:42\" | hire_date=\"2026-01-15\" | status=\"active\"",
        "tags_used": [
          "POSITION",
          "EMPLOYEE"
        ],
        "description": "Track employees from onboarding through offboarding, including position changes, benefits enrollment, leave management, and performance review cycles.",
        "tags": [
          "EMPLOYEE",
          "POSITION",
          "BENEFIT",
          "LEAVE",
          "REVIEW"
        ],
        "tags_planned": [
