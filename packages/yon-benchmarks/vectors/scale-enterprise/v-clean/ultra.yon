@DOC ver=2.0 | id=chunk-1-2 | title="API and Compliance Rules" | domain=technical | kind=rule | profile=exec | fmt=ultra
@INTENT goal="Outline compliance and rate limiting requirements" | audience="system administrators"
@SEC name="Authentication and Rate Limiting"
@RULE lvl=must | when="Bearer token OAuth2" | then="OAuth2 token TTL 3600s"
@RULE lvl=must | when="Rate limit exceeded" | then="Rate limit 500/min, 429 on exceed"
@SEC name="Users API"
@RULE lvl=must | when="POST /users" | then="POST /users requires name, email, role"
@RULE lvl=must | when="GET /users/:id" | then="GET /users/:id includes last_login, created_at"
@SEC name="Orders API"
@RULE lvl=must | when="POST /orders" | then="POST /orders requires customer_id, items[], total, currency"
@RULE lvl=must | when=Currency | then="Currency ISO 4217"
@SEC name="Products API"
@RULE lvl=must | when="POST /products" | then="POST /products requires name, description, price, category, active [200] [2000]"
@SEC name="Invoices API"
@RULE lvl=must | when="POST /invoices" | then="POST /invoices requires customer_id, items, due_date, payment_terms"
@SEC name="Global Validation Rules"
@RULE lvl=must | when=Email | then="Email RFC 5322"
@RULE lvl=must | when=Dates | then="Dates ISO 8601 UTC [2026]"
@SEC name=Webhooks
@RULE lvl=must | when=Security | then="HMAC-SHA256 payloads"
@SEC name=Subscriptions
@RULE lvl=must | when="POST /subscriptions" | then="POST /subscriptions requires customer_id, plan_id, trial_days, payment_method_id"
@SEC name=Payments
@RULE lvl=must | when="POST /payments" | then="POST /payments requires amount, currency, method_id, description [4217]"
@SEC name="GDPR Compliance"
@RULE lvl=must | when="PII at rest" | then="Encrypt PII at rest AES-256"
@RULE lvl=must | when="Data breaches" | then="Report breaches 72h"
@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | when="Access controls are configured" | then="Least privilege access"
@RULE lvl=must | when="Audit logs are configured" | then="Log all data access events"
@RULE lvl=must | when="Vulnerability scans are conducted" | then="Monthly vulnerability scans"
@RULE lvl=must | when="Critical findings are identified" | then="Remediate critical findings in 48h"
@RULE lvl=must | when="Penetration testing is performed" | then="Annual third-party pen tests"
@RULE lvl=must | when="Incident response procedures are executed" | then="Incident response phases"
@RULE lvl=must | when="Business continuity plans are tested" | then="Semi-annual BCP tests"
@RULE lvl=must | when="Tier 1 services are recovered" | then="RTO 4h for Tier 1"
@RULE lvl=must | when="Backups are managed" | then="Encrypt and test backups quarterly"
@RULE lvl=must | when="Administrative access is granted" | then="MFA for admin access"
@RULE lvl=must | when="SMS-based MFA is used" | then="Deprecate SMS MFA"
@RULE lvl=must | when="System access is granted" | then="Background checks before access"
@RULE lvl=must | when="Vendor security assessments are conducted" | then="Annual vendor security assessments"
@SEC name="PCI-DSS Level 1 Compliance"
@RULE lvl=must | when="Card numbers are stored" | then="Do not store full card numbers"
@RULE lvl=must | when="Payment data is stored" | then="Tokenize payment data"
@RULE lvl=must | when="Payment processing network is configured" | then="Segment payment network"
@RULE lvl=must | when="Network traffic is monitored" | then="Real-time IDS monitoring"
@RULE lvl=must | when="Encryption keys are managed" | then="Rotate keys annually"
@RULE lvl=must | when="Physical access to servers is controlled" | then="Restrict server access"
@RULE lvl=must | when="Payment processing code is deployed" | then="Security review for code"
@RULE lvl=must | when="ASV scans are conducted" | then="Quarterly ASV scans"
@SEC name="Rate Limiting"
@RULE lvl=must | when="Rate limiting is configured" | then="Global limit 1000/min"
@RULE lvl=must | when="Rate limiting is configured" | then="Per-user limit 100/min"
@RULE lvl=must | when="Burst limit is configured" | then="Burst limit 50/1s"
@RULE lvl=must | when="Throttle strategy is configured" | then="Sliding window throttle"
@RULE lvl=must | when="Rate limit headers are included" | then="Include rate limit headers [RateLimit]"
@RULE lvl=must | when="Rate limited" | then="Retry-After specifies wait"
@RULE lvl=must | when="Authenticated requests are made" | then="Higher limits for authenticated"
@RULE lvl=must | when="Webhook deliveries are made" | then="Webhooks not rate limited"
@RULE lvl=must | when="Batch endpoints are used" | then="Batch limits per item"
@MAP id=ErrorCodes | pairs=["ERR_AUTH"->"invalid/expired token","ERR_NOT_FOUND"->"resource doesn't exist","ERR_VALIDATION"->"request body failed schema validation","ERR_CONFLICT"->"duplicate resource","ERR_RATE_LIMIT"->"too many requests","ERR_PAYMENT_FAILED"->"payment provider rejected","ERR_INSUFFICIENT_FUNDS"->"account balance too low","ERR_PERMISSION_DENIED"->"token lacks required scope","ERR_RESOURCE_LOCKED"->"concurrent modification in progress"]
@MAP id=RateLimiting | pairs=["note"->"order.created","note"->"order.updated","note"->"order.completed","note"->"payment.succeeded","note"->"payment.failed","note"->"invoice.paid","note"->"402","note"->"1234567890","note"->"30s","note"->"1.3","note"->"Standard Contractual Clauses","note"->"JSON"]
