@DOC ver=2.0 | id=internal-task-management-system | title="Internal Task Management System Specification" | kind=spec | profile=decl | fmt=ultra
@SEC name="API Design"
@RULE lvl=MUST | when="API requests" | then="Rate limit: 100/min"
@SEC name="Performance Requirements"
@RULE lvl=MUST | when="Page load" | then="Page load <2s [1.5]"
@RULE lvl=MUST | when="API response" | then="API response: 200ms [500ms]"
