@MAP id=ProjectOverview | pairs=["project"->"Project: TaskFlow [Internal Task Management System]","status"->"Status: Early requirements"]
@MAP id=CoreFeatures | pairs=["Task creation"->"title, description, assignee, due date","Kanban board"->"To Do, In Progress, Review, Done","Search and filtering"->"assignee, status, tags","Real-time updates"->"WebSocket"]
@MAP id=Database | pairs=["database_choice"->"PostgreSQL preferred","users"->"","teams"->"","projects"->"","tasks"->"","comments"->"","attachments"->"","labels"->"","activity_log"->""]
@MAP id=ApiDesign | pairs=["api_type"->"REST API, possible GraphQL"]
@MAP id=IntegrationPoints | pairs=["notifications"->"Slack notifications, email fallback","calendar_sync"->"Google Calendar sync"]
@MAP id=OpenQuestions | pairs=["multi_tenancy"->"Multi-tenancy question","note"->"100ms","note"->"JSON"]
