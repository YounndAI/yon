@DOC ver=2.0 | id=enterprise-compliance | title="Enterprise Compliance Framework" | kind=rule | profile=decl | fmt=canon

@INTENT goal="Define enterprise-wide compliance requirements across data retention, access control, incident response, audit, training, and vendor management" | audience="Compliance officers, security teams, HR, vendor management"
@SCOPE context="enterprise compliance" | compliance="SOC 2, ISO 27001, AML/KYC"

@SEC name="Data Retention - Customer Records"
@RULE lvl=MUST | when="customer account closed" | then="retain data for 7 years"
@RULE lvl=MUST | when="transaction completed" | then="retain records for 5 years"
@RULE lvl=MUST | when="customer communication" | then="retain logs for 3 years"
@RULE lvl=MUST | when="retention expiry" | then="certify and document destruction within 90 days"
@CHECK rid=chk:cust-retention | assert="customer account data retained 7 years from closure" | fail=ABORT | msg="Customer data retention is a regulatory requirement"

@SEC name="Data Retention - Employee Records"
@RULE lvl=MUST | when="employee terminated" | then="retain personnel files for 7 years"
@RULE lvl=MUST | when="payroll processed" | then="retain records for 5 years from payment date"
@RULE lvl=MUST | when="training completed" | then="retain records for 3 years"
@RULE lvl=MUST | when="retention expiry" | then="certify and document destruction within 90 days"

@SEC name="Access Control - Production Systems"
@RULE lvl=MUST | when="accessing production" | then="use multi-factor authentication"
@RULE lvl=MUST | when="quarterly" | then="system owner conducts access review"
@RULE lvl=MUST | when="temporary access granted" | then="expire after 24 hours unless renewed"
@RULE lvl=MUST | when="access provisioned" | then="department head approval required"
@CHECK rid=chk:prod-mfa | assert="all production access requires MFA" | fail=ABORT | msg="Production MFA is non-negotiable"

@SEC name="Access Control - Development Systems"
@RULE lvl=MUST | when="accessing development" | then="use multi-factor authentication"
@RULE lvl=MUST | when="semi-annually" | then="team lead conducts access review"
@RULE lvl=MUST | when="temporary access granted" | then="expire after 72 hours unless renewed"
@RULE lvl=MUST | when="access provisioned" | then="engineering manager approval required"

@SEC name="Incident Response - Security Incidents"
@RULE lvl=MUST | when="security incident detected" | then="report within 1 hour"
@RULE lvl=MUST | when="incident reported" | then="classify within 4 hours"
@RULE lvl=MUST | when="incident closed" | then="complete post-incident review within 5 business days"
@RULE lvl=MUST | when="incident evidence" | then="preserve for 12 months from closure"

@SEC name="Incident Response - Operational Incidents"
@RULE lvl=MUST | when="operational incident detected" | then="report within 4 hours"
@RULE lvl=MUST | when="incident reported" | then="classify within 8 hours"
@RULE lvl=MUST | when="incident closed" | then="complete post-incident review within 10 business days"
@RULE lvl=MUST | when="incident evidence" | then="preserve for 6 months from closure"

@SEC name="Audit Requirements - Internal"
@RULE lvl=MUST | when="quarterly" | then="conduct internal audit"
@RULE lvl=MUST | when="critical audit finding" | then="remediate within 30 days"
@RULE lvl=MUST | when="non-critical audit finding" | then="remediate within 90 days"
@RULE lvl=MUST | when="audit completed" | then="retain report for 5 years"

@SEC name="Audit Requirements - External"
@RULE lvl=MUST | when="annually" | then="conduct external audit by accredited firm"
@RULE lvl=MUST | when="critical external finding" | then="remediate within 60 days"
@RULE lvl=MUST | when="non-critical external finding" | then="remediate within 180 days"
@RULE lvl=MUST | when="external audit completed" | then="retain report for 7 years"

@SEC name="Training Requirements - Security"
@RULE lvl=MUST | when="annually" | then="all staff complete security awareness training"
@RULE lvl=MUST | when="new hire" | then="complete security training within 14 days"
@RULE lvl=MUST | when="monthly" | then="conduct phishing simulation exercises"
@RULE lvl=MUST | when="quarterly" | then="report completion records to CISO"

@SEC name="Training Requirements - Compliance"
@RULE lvl=MUST | when="annually" | then="all staff complete compliance training"
@RULE lvl=MUST | when="new hire" | then="complete compliance training within 30 days"
@RULE lvl=MUST | when="semi-annually" | then="conduct AML refresher training"
@RULE lvl=MUST | when="quarterly" | then="report completion records to Chief Compliance Officer"

@SEC name="Vendor Management - Critical Vendors"
@RULE lvl=MUST | when="critical vendor" | then="complete security assessment annually"
@RULE lvl=MUST | when="vendor contract" | then="include data processing agreement"
@RULE lvl=MUST | when="quarterly" | then="review vendor access"
@RULE lvl=MUST | when="vendor incident" | then="report within 24 hours"

@SEC name="Vendor Management - Non-Critical Vendors"
@RULE lvl=MUST | when="non-critical vendor" | then="complete security assessment every 2 years"
@RULE lvl=MUST | when="vendor contract" | then="include data processing agreement"
@RULE lvl=MUST | when="annually" | then="review vendor access"
@RULE lvl=MUST | when="vendor incident" | then="report within 72 hours"
