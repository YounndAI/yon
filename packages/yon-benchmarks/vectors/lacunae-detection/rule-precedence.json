{
  "id": "deploy-rules",
  "title": "Deploy Requirements",
  "intent": "Define deployment requirements with explicit priority levels",
  "sections": {
    "Production Deploy": {
      "rules": [
        { "level": "MUST", "context": "production deploy", "requirement": "require 2 reviewer approvals before merge" },
        { "level": "SHOULD", "context": "production deploy", "requirement": "include performance benchmarks in PR" },
