@DOC ver=2.0 | id=api-rules | title="API Rules and Guidelines" | kind=rule | profile=exec | fmt=ultra
@INTENT goal="Extract API rules and guidelines"
@SEC name=Authentication
@RULE lvl=must | when="Rate limit exceeded" | then="Rate limit 500 req/min, 429 on exceed"
@RULE lvl=must | when="Authorization required" | then="Require Authorization header"
@SEC name="Users CRUD"
@RULE lvl=must | when="Creating user" | then="POST /users require name, email, role"
@RULE lvl=must | when="Email change" | then="Email change requires verification"
@RULE lvl=must | when="Deleting user" | then="Soft-delete user, status→archived"
@SEC name="Orders API"
@RULE lvl=must | when="Creating order" | then="POST /orders require customer_id, items[], total, currency"
@RULE lvl=must | when="Order total" | then="Total = Σ(qty × unit_price)"
@RULE lvl=must | when="Order currency" | then="Currency ISO 4217, no mixed"
@SEC name="Products API"
@RULE lvl=must | when="Creating product" | then="POST /products require name, description, price, category, active [2000]"
@RULE lvl=must | when="Deleting product" | then="Block delete if active orders"
@SEC name="Invoices API"
@RULE lvl=must | when="Creating invoice" | then="POST /invoices require customer_id, items, due_date, payment_terms"
@RULE lvl=must | when="Voiding invoice" | then="Cannot void paid invoices"
@SEC name="Global Validation Rules"
@RULE lvl=must | when="Validating email" | then="Email RFC 5322"
@RULE lvl=must | when="Validating phone" | then="Phone E.164 [1234567890]"
@RULE lvl=must | when="Validating dates" | then="Dates ISO 8601 UTC [2026]"
@SEC name=Webhooks
@RULE lvl=must | when="Processing webhook" | then="Verify HMAC-SHA256 signature"
@RULE lvl=must | when="Webhook delivery" | then="Respond 200 within 30s"
@MAP id=Authentication | pairs=["auth"->"Bearer token OAuth2, TTL 3600s","refresh"->"Refresh 30-day, single-use","token_endpoint"->"Token endpoint /auth/token"]
@MAP id=ErrorCodes | pairs=["ERR_AUTH"->"invalid/expired token","ERR_NOT_FOUND"->"resource doesn't exist","ERR_VALIDATION"->"request body failed schema validation","ERR_CONFLICT"->"duplicate resource","ERR_RATE_LIMIT"->"too many requests","ERR_PAYMENT_FAILED"->"payment provider rejected","ERR_INSUFFICIENT_FUNDS"->"account balance too low","ERR_PERMISSION_DENIED"->"token lacks required scope","ERR_RESOURCE_LOCKED"->"concurrent modification in progress"]
@MAP id=Webhooks | pairs=["note"->"order.created","note"->"order.updated","note"->"order.completed","note"->"payment.succeeded","note"->"payment.failed","note"->"invoice.paid"]
