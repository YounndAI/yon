{
  "system": {
    "name": "Payment Processing System",
    "version": "2.1.0"
  },
  "compliance": {
    "rules": [
      {
        "trigger": "transaction > $10,000",
        "action": "Report to FinCEN within 24 hours",
        "severity": "critical"
      },
      {
        "trigger": "new account",
        "action": "Complete KYC verification before first transaction",
        "severity": "critical"
      },
      {
        "trigger": "cross-border transfer",
        "action": "Validate sanctions list clearance",
        "severity": "critical"
      }
    ]
  },
  "performance": {
    "metrics": {
      "p99_latency": {
        "current": "450ms",
        "target": "200ms",
        "status": "2.25x over SLA",
        "action": "Open P1 incident within 4 hours when exceeded"
      },
      "db_pool_utilization": {
        "current": "95%",
        "target": "80%",
        "status": "saturation risk",
        "action": "Scale connection pool or add read replica when exceeds 90%"
      },
      "memory_growth": {
        "current": "8%/month",
        "target": "2%/month",
        "status": "OOM within 6 months",
        "action": "Investigate and remediate within 1 sprint when exceeds 2%/month"
      }
    }
  },
  "security": {
    "policies": [
      {
        "requirement": "TLS 1.3 for all API endpoints",
        "severity": "critical"
      },
      {
        "requirement": "No plaintext credential storage",
        "severity": "critical"
      }
    ]
  }
}
