@DOC ver=2.0 | id=payment-system-full | title="Payment Processing System (Full)" | kind=rule | profile=decl | fmt=min

@SEC name="Compliance Rules"
@RULE lvl=MUST | when="transaction > $10,000" | then="Report to FinCEN within 24 hours"
@RULE lvl=MUST | when="new account" | then="Complete KYC verification before first transaction"
@RULE lvl=MUST | when="cross-border transfer" | then="Validate sanctions list clearance"

@SEC name="Performance Requirements"
@MAP name="Performance Metrics" | id=PerformanceMetrics | pairs=["p99_latency"->"450ms (target: 200ms — 2.25x over SLA)","db_pool_utilization"->"95% (target: 80% — saturation risk)","memory_growth"->"8%/month (target: 2% — OOM within 6 months)"]
@RULE lvl=MUST | when="p99_latency exceeds 200ms" | then="Open P1 incident within 4 hours"
@RULE lvl=MUST | when="db_pool_utilization exceeds 90%" | then="Scale connection pool or add read replica"
@RULE lvl=MUST | when="memory_growth exceeds 2%/month" | then="Investigate memory leak and remediate within 1 sprint"
@CHECK rid="check:latency" | assert="p99_latency below SLA target" | fail=WARN | msg="Latency SLA breach — 2.25x over target"
@CHECK rid="check:db-pool" | assert="db_pool_utilization below 90%" | fail=WARN | msg="Connection pool near saturation"
@CHECK rid="check:memory" | assert="memory_growth below 2%/month" | fail=WARN | msg="Memory growth unsustainable — OOM risk within 6 months"

@SEC name="Security Policies"
@RULE lvl=MUST | when="API communication" | then="TLS 1.3 for all API endpoints"
@RULE lvl=MUST_NOT | when="storing credentials" | then="No plaintext credential storage"
