@DOC ver=2.0 | id=auth-config | title="Authentication Configuration" | kind=rule | profile=exec | fmt=min

@SEC name=Authentication
@MAP id=Auth | pairs=["Bearer token"->"OAuth2","Token TTL"->"3600s","Refresh"->"30-day, single-use"]
@RULE lvl=must | when="Rate limit exceeded" | then="429 + Retry-After on exceed"
@MAP id=Scope | pairs=["admin tokens"->"all orgs","user tokens"->"own org only"]
@RULE lvl=must | when="Making requests" | then="Authorization header required"
@NOTE text="Token endpoint: /auth/token"
