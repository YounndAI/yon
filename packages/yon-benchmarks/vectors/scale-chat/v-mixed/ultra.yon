@DOC ver=2.0 | id=api-authentication-rules | title="API Authentication Rules" | kind=rule | profile=exec | fmt=ultra
@SEC name=Authentication
@RULE lvl=must | when="API requests are made" | then="Include Authorization header with bearer token"
@SEC name="Rate Limiting"
@RULE lvl=must | when="Rate limit is exceeded" | then="Return 429 with Retry-After"
@MAP id=Authentication | pairs=["auth"->"Bearer token OAuth2, 3600s TTL, 30d refresh"]
@MAP id=RateLimiting | pairs=["rate_limit"->"500 requests/min globally"]
@MAP id=TokenAccess | pairs=["token_access"->"Admin tokens: all orgs, User tokens: own org"]
@MAP id=TokenIssuance | pairs=["token_issuance"->"/auth/token endpoint, client credentials or auth code","refresh_tokens"->"Refresh tokens single-use, new issued with access token"]
