@DOC ver=2.0 | id=auth-system-rules | title="Authentication System Rules" | kind=rule | profile=exec | fmt=min

@SEC name="Authentication Tokens"
@RULE lvl=must | when="Using OAuth2" | then="OAuth2 Bearer tokens"
@RULE lvl=must | when="Token issued" | then="TTL 3600s"
@RULE lvl=must | when="Using refresh tokens" | then="Refresh tokens 30d"
@RULE lvl=must | when="Using refresh tokens" | then="Invalidate refresh tokens after use"

@SEC name="Rate Limiting"
@RULE lvl=must | when="Requests exceed rate limit" | then="429 with Retry-After on limit exceed"

@SEC name="Token Access"
@RULE lvl=must | when="Using admin tokens" | then="Admin tokens access all orgs"
@RULE lvl=must | when="Using regular user tokens" | then="User tokens access own org"

@SEC name="API Requests"
@RULE lvl=must | when="Making API request" | then="Authorization header with bearer token"

@SEC name="Token Issuance"
@RULE lvl=must | when="Issuing tokens" | then="/auth/token endpoint for issuance"
