@DOC ver=2.0 | id=landing-page-constraints | title="Landing Page Code Generation Constraints" | kind=rule | profile=decl | fmt=canon

@SEC name="Design Constraints"
@RULE lvl=MUST | then="The page MUST use semantic HTML5 elements (header, main, section, footer, nav). No div soup — every container must have a meaningful tag."
@RULE lvl=MUST | then="The page MUST be fully responsive using CSS Grid for the main layout and Flexbox for component-level alignment. No fixed pixel widths on containers."
@RULE lvl=MUST_NOT | then="The page MUST NOT use any inline styles. All styling must go through CSS custom properties (variables) defined in a :root block."
@RULE lvl=SHOULD | then="The page SHOULD use the color palette: primary #1A1A2E, secondary #16213E, accent #E94560, surface #F5F5F5. SHOULD prefer the accent color for interactive elements."
@RULE lvl=MUST | then="All images MUST have descriptive alt text. Decorative images must use alt=\"\" with role=\"presentation\"."
@RULE lvl=MUST_NOT | then="The page MUST NOT use JavaScript for layout or styling. JS is permitted only for interactivity (menu toggle, scroll animations)."
@RULE lvl=SHOULD | then="The page SHOULD include a skip-to-content link as the first focusable element for keyboard navigation accessibility."
