@DOC ver=2.0 | id=information-security-policy | title="Information Security Policy" | kind=policy | domain=technical | profile=decl | fmt=min
@INTENT goal="Establish rules and procedures for data protection" | audience=Organizations

@SEC name="Access Control"
@RULE lvl=MUST | then="Enforce MFA for user accounts; Rotate service accounts every 90 days, no passwords; RBAC with least privilege, quarterly reviews; Record privileged access for 12 months; Temporary access expires after 4 hours"

@SEC name="Data Classification"
@RULE lvl=MUST | then="Classify data into four tiers; Encrypt Restricted data with AES-256 and TLS 1.3; Apply labels within 48 hours; DPO approval for cross-border transfers [Data Protection Officer]; Backups maintain classification and encryption"

@SEC name="Incident Response"
@NOTE text="Severity levels P1-P4 with escalation"
@RULE lvl=MUST | then="Report incidents within 1 hour [Security Operations Center]; Notify executives within 4 hours; Complete reviews within 5 business days; Immediate evidence preservation"

@SEC name="Vulnerability Management"
@RULE lvl=MUST | then="Patch critical vulnerabilities within 72 hours [9.0]; Quarterly penetration testing [quarterly]; Weekly scans for third-party dependencies [weekly]; Review scan results within 24 hours; CISO approval for patching exceptions"

@SEC name="Network Security"
@RULE lvl=MUST | then="Segment networks with VLANs; Default-deny firewall rules, monthly review; Monitor DNS with threat intelligence; VPNs use WireGuard/IPSec; Encrypt east-west traffic with mutual TLS"

@SEC name="Compliance and Audit"
@RULE lvl=MUST | then="Annual SOC 2 Type II audits [annually]; Retain audit logs for 3 years; CISO and legal approval for policy changes; Complete training within 30 days of hire [annually]; Vendor assessments before onboarding, annually [every]"
