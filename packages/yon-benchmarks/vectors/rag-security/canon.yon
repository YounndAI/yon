@DOC ver=2.0 | id=information-security-policy | title="Information Security Policy" | kind=policy | domain=technical | profile=decl | fmt=canon

@INTENT goal="Establish rules and procedures for data protection" | audience="Organizations"
@SCOPE context="enterprise information security" | compliance="SOC 2, ISO 27001"

@SEC name="Access Control"
@RULE lvl=MUST | when="accessing production systems" | then="enforce multi-factor authentication"
@RULE lvl=MUST | when="service accounts" | then="rotate every 90 days; no password-based authentication"
@RULE lvl=MUST | when="assigning access" | then="follow least privilege with quarterly access reviews"
@RULE lvl=MUST | when="privileged access session" | then="record and retain for 12 months"
@RULE lvl=MUST | when="temporary elevated access" | then="auto-expire after 4 hours unless renewed"
@CHECK rid=chk:mfa | assert="all production access uses MFA" | fail=ABORT | msg="MFA is mandatory for production system access"

@SEC name="Data Classification"
@RULE lvl=MUST | when="any data created" | then="classify as Public, Internal, Confidential, or Restricted"
@RULE lvl=MUST | when="Restricted data" | then="encrypt at rest with AES-256 and in transit with TLS 1.3"
@RULE lvl=MUST | when="data created" | then="apply classification labels within 48 hours"
@RULE lvl=MUST | when="cross-border transfer of Confidential/Restricted data" | then="obtain DPO approval"
@RULE lvl=MUST | when="backup copies" | then="maintain same classification and encryption as original"
@CHECK rid=chk:encryption | assert="Restricted data encrypted AES-256 at rest and TLS 1.3 in transit" | fail=ABORT | msg="Encryption standards are mandatory for Restricted data"

@SEC name="Incident Response"
@RULE lvl=MUST | when="security incident detected" | then="report to SOC within 1 hour"
@RULE lvl=MUST | when="critical incident" | then="notify executive team within 4 hours"
@RULE lvl=MUST | when="post-incident review" | then="complete within 5 business days with root cause analysis"
@RULE lvl=MUST | when="incident detected" | then="begin evidence preservation immediately; follow chain of custody"
@NOTE text="Severity levels: P1 (critical breach) to P4 (informational) with escalation paths."

@SEC name="Vulnerability Management"
@RULE lvl=MUST | when="critical vulnerability (CVSS ≥ 9.0)" | then="patch within 72 hours of disclosure"
@RULE lvl=MUST | when="internet-facing application" | then="undergo penetration testing quarterly"
@RULE lvl=MUST | when="third-party dependencies" | then="scan for known vulnerabilities weekly"
@RULE lvl=MUST | when="vulnerability scan results" | then="security team review within 24 hours"
@RULE lvl=MUST | when="patching exception requested" | then="obtain CISO written approval; max 30 days"
@CHECK rid=chk:crit-patch | assert="CVSS ≥ 9.0 vulnerabilities patched within 72 hours" | fail=ABORT | msg="Critical vulnerability SLA breach"

@SEC name="Network Security"
@RULE lvl=MUST | when="production network" | then="implement network segmentation with dedicated VLANs per environment"
@RULE lvl=MUST | when="firewall rules" | then="follow default-deny policy; review monthly"
@RULE lvl=MUST | when="DNS queries" | then="monitor and filter through threat intelligence service"
@RULE lvl=MUST | when="VPN connections" | then="use WireGuard or IPSec with certificate-based authentication"
@RULE lvl=MUST | when="east-west microservice traffic" | then="encrypt using mutual TLS"

@SEC name="Compliance and Audit"
@RULE lvl=MUST | when="annually" | then="conduct SOC 2 Type II audit by accredited third-party"
@RULE lvl=MUST | when="audit logs" | then="store immutably for minimum 3 years"
@RULE lvl=MUST | when="security policy changes" | then="obtain CISO and legal department approval"
@RULE lvl=MUST | when="employee onboarding" | then="complete compliance training within 30 days and annually thereafter"
@RULE lvl=MUST | when="third-party vendor" | then="complete security assessment before onboarding; renew every 12 months"
