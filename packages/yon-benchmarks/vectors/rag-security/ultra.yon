@DOC ver=2.0 | id=information-security-policy | title="Information Security Policy" | kind=policy | domain=technical | profile=decl | fmt=ultra
@INTENT goal="Establish rules and procedures for data protection" | audience=Organizations
@SEC name="Access Control"
@RULE lvl=MUST | then="Enforce MFA for user accounts"
@RULE lvl=MUST | then="Rotate service accounts every 90 days, no passwords"
@RULE lvl=MUST | then="RBAC with least privilege, quarterly reviews"
@RULE lvl=MUST | then="Record privileged access for 12 months"
@RULE lvl=MUST | then="Temporary access expires after 4 hours"
@SEC name="Data Classification"
@RULE lvl=MUST | then="Classify data into four tiers"
@RULE lvl=MUST | then="Encrypt Restricted data with AES-256 and TLS 1.3"
@RULE lvl=MUST | then="Apply labels within 48 hours"
@RULE lvl=MUST | then="DPO approval for cross-border transfers [Data Protection Officer]"
@RULE lvl=MUST | then="Backups maintain classification and encryption"
@SEC name="Incident Response"
@RULE lvl=MUST | then="Report incidents within 1 hour [Security Operations Center]"
@RULE lvl=MUST | then="Notify executives within 4 hours"
@RULE lvl=MUST | then="Complete reviews within 5 business days"
@RULE lvl=MUST | then="Immediate evidence preservation"
@SEC name="Vulnerability Management"
@RULE lvl=MUST | then="Patch critical vulnerabilities within 72 hours [9.0]"
@RULE lvl=MUST | then="Quarterly penetration testing [quarterly]"
@RULE lvl=MUST | then="Weekly scans for third-party dependencies [weekly]"
@RULE lvl=MUST | then="Review scan results within 24 hours"
@RULE lvl=MUST | then="CISO approval for patching exceptions"
@SEC name="Network Security"
@RULE lvl=MUST | then="Segment networks with VLANs"
@RULE lvl=MUST | then="Default-deny firewall rules, monthly review"
@RULE lvl=MUST | then="Monitor DNS with threat intelligence"
@RULE lvl=MUST | then="VPNs use WireGuard/IPSec"
@RULE lvl=MUST | then="Encrypt east-west traffic with mutual TLS"
@SEC name="Compliance and Audit"
@RULE lvl=MUST | then="Annual SOC 2 Type II audits [annually]"
@RULE lvl=MUST | then="Retain audit logs for 3 years"
@RULE lvl=MUST | then="CISO and legal approval for policy changes"
@RULE lvl=MUST | then="Complete training within 30 days of hire [annually]"
@RULE lvl=MUST | then="Vendor assessments before onboarding, annually [every]"
@MAP id=IncidentResponse | pairs=["incident_severity"->"Severity levels P1-P4 with escalation"]
