@DOC ver=2.0 | id=chunk-1-4 | title="API and Endpoint Rules" | domain=technical | kind=rule | profile=exec | fmt=min
@INTENT goal="Define observability and service architecture" | audience="system architects"

@SEC name=Authentication
@RULE lvl=must | when=authenticating | then="Bearer token OAuth2, 3600s TTL, 30d refresh"
@RULE lvl=must | when="rate limited" | then="Rate limit 500/min, 429 on limit"
@RULE lvl=must | when="making API requests" | then="Authorization header required"
@RULE lvl=must | when="using refresh tokens" | then="Refresh tokens single-use"

@SEC name="Users Endpoint"
@RULE lvl=must | when="creating a user" | then="POST /users requires name, email, role"
@RULE lvl=must | when="email is provided" | then="Email unique per org"
@RULE lvl=must | when="GET /users" | then="GET /users paginated, limit 25-100"
@RULE lvl=must | when="GET /users/:id" | then="GET /users/:id returns user or 404"
@RULE lvl=must | when="PATCH /users/:id" | then="PATCH /users/:id partial update"
@RULE lvl=must | when="DELETE /users/:id" | then="DELETE /users/:id soft-delete"
@RULE lvl=must | when="user is already archived" | then="Archived user 410 Gone"

@SEC name="Orders Endpoint"
@RULE lvl=must | when="creating an order" | then="POST /orders requires customer_id, items, total, currency"
@RULE lvl=must | when="specifying currency" | then="Currency ISO 4217"
@RULE lvl=must | when="GET /orders" | then="GET /orders supports filtering"
@RULE lvl=must | when="order lifecycle" | then="Order lifecycle draft to delivered"
@RULE lvl=must | when="PATCH /orders/:id" | then="PATCH /orders/:id update items in draft"
@RULE lvl=must | when="POST /orders/:id/confirm" | then="Confirm order triggers payment"
@RULE lvl=must | when="POST /orders/:id/cancel" | then="Cancel order triggers refund"
@RULE lvl=must | when="DELETE /orders/:id" | then="DELETE /orders/:id not supported"

@SEC name="Error Codes"
@MAP id=Error Codes | pairs=["ERR_AUTH"->"invalid or expired token","ERR_NOT_FOUND"->"requested resource does not exist","ERR_VALIDATION"->"request body failed schema validation","ERR_CONFLICT"->"duplicate resource detected","ERR_RATE_LIMIT"->"too many requests","ERR_PAYMENT_FAILED"->"payment provider rejected transaction","ERR_INSUFFICIENT_FUNDS"->"account balance too low","ERR_PERMISSION_DENIED"->"token does not have required scope","ERR_RESOURCE_LOCKED"->"resource being modified by another process"]

@SEC name="Products Endpoint"
@RULE lvl=must | when="creating a product" | then="POST /products requires name, description, price, category, active"
@RULE lvl=must | when="specifying name" | then="Name max 255 chars"
@RULE lvl=must | when="specifying description" | then="Description max 2000 chars"
@RULE lvl=must | when="specifying price" | then="Price in cents"
@RULE lvl=must | when="specifying categories" | then="Predefined categories only"
@RULE lvl=must | when="GET /products" | then="GET /products supports filtering"
@RULE lvl=must | when="PATCH /products/:id" | then="PATCH /products/:id update any field"
@RULE lvl=must | when="product has active orders" | then="Active orders prevent deletion"

@SEC name="Invoices Endpoint"
@RULE lvl=must | when="creating an invoice" | then="POST /invoices requires customer_id, items, due_date, payment_terms"
@RULE lvl=must | when="specifying payment terms" | then="Payment terms net-15/30/60"
@RULE lvl=must | when="invoice lifecycle" | then="Invoice lifecycle draft to void"
@RULE lvl=must | when="POST /invoices/:id/pay" | then="Pay invoice returns 402 on failure"
@RULE lvl=must | when="POST /invoices/:id/void" | then="Void invoice, not if paid"
@RULE lvl=must | when="GET /invoices" | then="GET /invoices supports filtering"
@RULE lvl=must | when="invoice is overdue" | then="Overdue invoices trigger reminders"

@SEC name="Input Validation"
@RULE lvl=must | when="validating email fields" | then="Email RFC 5322"
@RULE lvl=must | when="validating phone fields" | then="Phone E.164 [1234567890]"
@RULE lvl=must | when="specifying monetary amounts" | then="Monetary amounts in cents"
@RULE lvl=must | when="specifying date fields" | then="Date ISO 8601 UTC [2026]"
@RULE lvl=must | when="specifying metadata objects" | then="Metadata 20 keys, 500 chars"
@RULE lvl=must | when="specifying array fields" | then="Array max 100 items"
@RULE lvl=must | when="specifying string fields" | then="Trim strings, empty as null"
@RULE lvl=must | when="specifying boolean fields" | then="Boolean true/false, 1/0, yes/no"
@RULE lvl=must | when="specifying enum fields" | then="Enum case-insensitive, stored lowercase"

@SEC name=Webhooks
@RULE lvl=must | when="processing webhook payloads" | then="Webhooks signed HMAC-SHA256"
@RULE lvl=must | when="responding to webhooks" | then="Respond 200 in 30s"
@RULE lvl=must | when="webhook delivery fails" | then="Retry backoff 1m to 10h"
@RULE lvl=must | when="all retries exhausted" | then="Notify owner on failure"
@RULE lvl=must | when="registering a webhook" | then="Register webhook POST /webhooks"
@RULE lvl=must | when="GET /webhooks/:id/deliveries" | then="GET /webhooks/:id/deliveries last 30d"

@SEC name=Subscriptions
@RULE lvl=must | when="POST /subscriptions" | then="Create subscription"
@RULE lvl=must | when="PATCH /subscriptions/:id" | then="Update subscription"
@RULE lvl=must | when="DELETE /subscriptions/:id" | then="Cancel subscription"

@SEC name=Payments
@RULE lvl=must | when="POST /payments" | then="Create payment"
@RULE lvl=must | when="POST /payments/:id/refund" | then="Create refund"

@SEC name="GDPR Compliance"
@RULE lvl=must | when="Encrypt PII" | then="Encrypt PII [1.3]"
@RULE lvl=must | when="Receive valid erasure request" | then="Right to erasure"
@RULE lvl=must | when="Data breach" | then="Report data breach"

@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | when="Access controls" | then="Least privilege"
@RULE lvl=must | when="Vulnerability scans" | then="Monthly scans"

@SEC name="PCI-DSS Level 1 Compliance"
@RULE lvl=must | when="Store card numbers" | then="Store card numbers"
@RULE lvl=must | when="Tokenize payment data" | then="Tokenize payment data"

@SEC name="Rate Limiting"
@RULE lvl=must | when="Global rate limit" | then="Global rate limit [1000]"
@RULE lvl=must | when="Per-user rate limit" | then="Per-user rate limit"

@SEC name=Shipping
@RULE lvl=must | when="POST /shipping" | then="Create shipment"
@RULE lvl=must | when="Generate shipping labels" | then="Generate labels"

@SEC name="Inventory Module"
@NOTE text="Tracks stock levels across warehouses."
@NOTE text="Tracked as available, reserved, damaged."
@RULE lvl=must | then="Reject zero adjustments."
@NOTE text="Reservation on order confirmation."
@NOTE text="Alerts on low stock below reorder point."
@NOTE text="Transfers tracked with transfer ID."
@NOTE text="Cycle counts via POST /inventory/count."
@RULE lvl=must | then="Log discrepancies, require manager approval."

@SEC name="Notification System"
@NOTE text="Supports email, SMS, push, in-app."
@NOTE text="Templates use Handlebars, versioned."
@NOTE text="Priority levels: critical, high, normal, low."
@NOTE text="Quiet hours 10 PM to 7 AM."
@NOTE text="Email via transactional provider, tracked by webhooks."
@NOTE text="SMS via gateway, international requires sender IDs."
@NOTE text="Push targets devices, multiple registrations."
@NOTE text="In-app persisted, read/unread status."
@NOTE text="Users can opt out per channel."
@RULE lvl=must | then="Queue bulk notifications at 1000/min."

@SEC name="Analytics Module"
@NOTE text="Provides real-time and historical data."
@NOTE text="Events via SDK/API, include timestamp, user_id, session_id."
@NOTE text="Dashboards update every 5 seconds."
@NOTE text="Aggregation by minute, hour, day, week, month."
@NOTE text="Custom events with 10 properties, alphanumeric names."
@NOTE text="Funnels track progression, auto drop-off rates."
@NOTE text="Cohort analysis by first event date."
@NOTE text="Retention: 13 months detailed, unlimited aggregated."
@NOTE text="Export via GET /analytics/export in CSV, Parquet."
@NOTE text="Optimized with column-oriented storage, date partitioning."

@SEC name="Reporting Module"
@NOTE text="Generates scheduled, on-demand reports."
@NOTE text="Standard reports: revenue, orders, customers, inventory, churn."
@NOTE text="Custom reports via SQL-like language."
@NOTE text="Schedule reports daily, weekly, monthly."
@NOTE text="Formats: PDF, CSV, Excel, JSON."
@NOTE text="Dashboards aggregate reports, 12 widgets max."
@NOTE text="Drill-down supported, opens detailed view."
@NOTE text="Caching prevents redundant computation."
@NOTE text="Access control by role, finance/admin for financial reports."
@NOTE text="Large date range reports queued, async processing."
@NOTE text="Notification on report ready."

@SEC name="HIPAA Compliance"
@RULE lvl=must | then="Role-based access to PHI, minimum necessary."
@RULE lvl=must | then="Log PHI access, 6-year retention."
@RULE lvl=must | then="Encrypt PHI: AES-256 at rest, TLS 1.3 in transit."
@RULE lvl=must | then="Notify breaches within 60 days."
@RULE lvl=must | then="Annual risk assessments, remediation plans."
@RULE lvl=must | then="Annual HIPAA training for PHI access."
@RULE lvl=must | then="Sign agreements with third parties for PHI."
@RULE lvl=must | then="Emergency access to PHI during outages."
@RULE lvl=must | then="Document, review, update policies annually."
@RULE lvl=must | then="Facility access controls, workstation security."
@RULE lvl=must | then="Unique ID, auto logoff, audit controls."

@SEC name="Caching Layer"
@NOTE text="Sits between API and database."
@NOTE text="Default TTL 300s, max 86400s."
@NOTE text="Stale-while-revalidate strategy. [stale-while-revalidate]"
@NOTE text="Event-driven invalidation via event bus."
@NOTE text="Redis 7.x, cluster mode, 3 primary, 3 replica."
@NOTE text="Keys: {service}:{resource}:{id}:{version}."
@NOTE text="Target 95% hit rate for read-heavy."
@NOTE text="Compress >1MB with LZ4."
@NOTE text="Cache warming during deployment."
@NOTE text="Per-tenant isolation in multi-tenant."

@SEC name=Observability
@NOTE text="Three pillars: tracing, metrics, logging"
@NOTE text="Tracing with OpenTelemetry, W3C Trace Context"
@NOTE text="Metrics in Prometheus format"
@NOTE text="Logging in JSON format"
@NOTE text="Log level: info, debug per-service"
@NOTE text="Trace sampling: 10% prod, 100% staging"
@NOTE text="Log retention: 90d search, 1y cold"
@NOTE text="Alerts as code with Terraform"
@NOTE text="Dashboards use RED method"
@NOTE text="SLO tracking, pages at 50% burn"

@SEC name="Service Architecture"
@NOTE text="gRPC internal, REST external"
@NOTE text="Event sourcing for order/payment"
@NOTE text="CQRS for read/write separation"
@NOTE text="Service owns database, API boundaries"
@NOTE text="Kafka with at-least-once delivery [Apache Kafka]"
@RULE lvl=must | when="external service calls" | then="Circuit breaker after 5 failures"
@NOTE text="Saga for distributed transactions"
@NOTE text="API gateway for cross-cutting concerns"
@NOTE text="Service mesh for TLS, observability"
@NOTE text="Blue-green, canary 5% traffic"
@NOTE text=order.created
@NOTE text=order.updated
@NOTE text=order.completed
@NOTE text=payment.succeeded
@NOTE text=payment.failed
@NOTE text=invoice.paid
@NOTE text=RateLimit
@NOTE text="Standard Contractual Clauses"
