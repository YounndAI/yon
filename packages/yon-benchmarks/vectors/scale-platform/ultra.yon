@DOC ver=2.0 | id=chunk-1-4 | title="API and Endpoint Rules" | domain=technical | kind=rule | profile=exec | fmt=ultra
@INTENT goal="Define observability and service architecture" | audience="system architects"
@SEC name=Authentication
@RULE lvl=must | when="API requests" | then="Include Authorization header"
@RULE lvl=must | when="rate limited" | then="Return 429 on rate limit"
@RULE lvl=must | when="refresh tokens used" | then="Invalidate refresh tokens after use"
@SEC name="Users Endpoint"
@RULE lvl=must | when="POST /users" | then="Create user with name, email, role"
@RULE lvl=must | when="GET /users" | then="Paginated list, default 25, max 100"
@RULE lvl=must | when="DELETE /users/:id" | then="Soft-delete sets status to archived"
@SEC name="Orders Endpoint"
@RULE lvl=must | when="POST /orders" | then="Create order with customer_id, items, total, currency"
@RULE lvl=must | when="PATCH /orders/:id" | then="Update items in draft only"
@RULE lvl=must | when="POST /orders/:id/confirm" | then="Confirm order, trigger payment"
@SEC name="Products Endpoint"
@RULE lvl=must | when="POST /products" | then="Create product with name, description, price, category, active"
@RULE lvl=must | when="PATCH /products/:id" | then="Update any field, active false prevents new orders"
@SEC name="Invoices Endpoint"
@RULE lvl=must | when="POST /invoices" | then="Create invoice with customer_id, items, due_date, payment_terms"
@RULE lvl=must | when="POST /invoices/:id/pay" | then="Attempt payment, return 402 on failure"
@SEC name="Input Validation"
@RULE lvl=must | when="Email fields" | then="Email RFC 5322"
@RULE lvl=must | when="Phone fields" | then="Phone E.164 [1234567890]"
@SEC name=Webhooks
@RULE lvl=must | when="webhook payloads" | then="Sign payloads with HMAC-SHA256"
@RULE lvl=must | when="webhook endpoint does not respond" | then="Mark failed if no response"
@SEC name="Subscriptions Endpoint"
@RULE lvl=must | when="POST /subscriptions" | then="Create subscription"
@RULE lvl=must | then="Start after trial"
@RULE lvl=must | then="Auto invoice"
@RULE lvl=must | then="Set billing anchor"
@RULE lvl=must | then="Status flow"
@RULE lvl=must | when="PATCH /subscriptions/:id" | then="Update subscription"
@RULE lvl=must | when="DELETE /subscriptions/:id" | then="Cancel subscription"
@SEC name="Payments Endpoint"
@RULE lvl=must | when="POST /payments" | then="Create payment"
@RULE lvl=must | then="Synchronous processing"
@RULE lvl=must | then="Success 200"
@RULE lvl=must | then="Failure 402"
@RULE lvl=must | then="3D Secure"
@RULE lvl=must | when="POST /payments/:id/refund" | then="Create refund"
@SEC name="GDPR Compliance"
@RULE lvl=must | then="Encrypt PII [1.3]"
@RULE lvl=must | then="Erasure 30 days"
@RULE lvl=must | then="Maintain records"
@RULE lvl=must | then="Report breaches"
@RULE lvl=must | then="Annual DPIA"
@RULE lvl=must | then="Appoint DPO"
@RULE lvl=must | then="Obtain consent"
@RULE lvl=must | then="Portability 30 days [JSON]"
@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | then="Least privilege"
@RULE lvl=must | then="Record access"
@RULE lvl=must | then="Monthly scans"
@RULE lvl=must | then="Annual pentest"
@RULE lvl=must | then="Incident response"
@RULE lvl=must | then="Test BCP"
@RULE lvl=must | then="Encrypt backups"
@RULE lvl=must | then="Require MFA"
@RULE lvl=must | then="Background checks"
@RULE lvl=must | then="Annual vendor assessment"
@SEC name="PCI-DSS Level 1 Compliance"
@RULE lvl=must | then="No card storage"
@RULE lvl=must | then="Tokenize payment data"
@RULE lvl=must | then="Segment network"
@RULE lvl=must | then="Monitor traffic"
@RULE lvl=must | then="Rotate keys"
@RULE lvl=must | then="Restrict server access"
@RULE lvl=must | then="Review code"
@RULE lvl=must | then="ASV scans"
@SEC name="Rate Limiting"
@RULE lvl=must | then="Sliding window"
@RULE lvl=must | then="Include headers"
@RULE lvl=must | then="Retry-After header"
@RULE lvl=must | then="Higher limits"
@RULE lvl=must | then="Exclude webhooks"
@RULE lvl=must | then="Batch limits"
@SEC name="Shipping Module"
@RULE lvl=must | when="POST /shipping" | then="Create shipment"
@RULE lvl=must | then="Webhook updates"
@RULE lvl=must | then="Calculate costs"
@RULE lvl=must | then="Customs data"
@RULE lvl=must | when="POST /shipping/:id/label" | then="Generate labels"
@SEC name="Inventory Module"
@RULE lvl=must | when="Zero adjustments" | then="Zero adjustments rejected."
@RULE lvl=must | when="Discrepancies from cycle counts" | then="Discrepancies logged, manager approval needed."
@SEC name="HIPAA Compliance"
@RULE lvl=must | when="Handling PHI" | then="HIPAA mandatory for PHI."
@RULE lvl=must | when="Accessing PHI" | then="Role-based access for PHI."
@RULE lvl=must | when="Accessing PHI" | then="PHI access logged, 6-year retention."
@RULE lvl=must | when="PHI at rest" | then="PHI encrypted AES-256, TLS 1.3."
@RULE lvl=must | when="Breach occurs" | then="Notify breaches within 60 days."
@RULE lvl=must | when=Annually | then="Annual risk assessments, remediation plans."
@RULE lvl=must | when="PHI access" | then="Annual HIPAA training for PHI access."
@RULE lvl=must | when="Third parties access PHI" | then="BAAs for third parties accessing PHI."
@RULE lvl=must | when="System outages" | then="Emergency access for PHI during outages."
@RULE lvl=must | when=Annually | then="Document, review, update policies annually."
@RULE lvl=must | when="Physical safeguards" | then="Facility access, workstation security."
@RULE lvl=must | when="Technical safeguards" | then="Unique ID, logoff, audit controls."
@MAP id=ErrorCodes | pairs=["ERR_AUTH"->"invalid or expired token","ERR_NOT_FOUND"->"requested resource does not exist","ERR_VALIDATION"->"request body failed schema validation","ERR_CONFLICT"->"duplicate resource detected","ERR_RATE_LIMIT"->"too many requests","ERR_PAYMENT_FAILED"->"payment provider rejected transaction","ERR_INSUFFICIENT_FUNDS"->"account balance too low","ERR_PERMISSION_DENIED"->"token does not have required scope","ERR_RESOURCE_LOCKED"->"resource being modified by another process"]
@MAP id=SubscriptionsEndpoint | pairs=["customer_id"->"required","plan_id"->"required","trial_days"->"0-365","payment_method_id"->"required unless trial","create_prorations"->"default","none"->"option","always_invoice"->"option"]
@MAP id=PaymentsEndpoint | pairs=["amount"->"integer cents","currency"->"ISO 4217","method_id"->"required","description"->"required"]
@MAP id=RateLimiting | pairs=["global"->"1000 requests per minute","per-user"->"100 requests per minute","burst"->"50 requests in 1-second window"]
@MAP id=ShippingModule | pairs=["order_id"->"required","carrier"->"required","tracking_number"->"required","estimated_delivery"->"required","ups"->"supported","fedex"->"supported","dhl"->"supported","usps"->"supported","custom"->"requires tracking URL template"]
@MAP id=InventoryModule | pairs=["inventory_tracking"->"Tracks stock levels across warehouses.","stock_levels"->"Tracked as available, reserved, damaged.","inventory_adjustment"->"POST /inventory/adjust for adjustments.","reservation"->"Reservation on order confirmation.","low_stock_alerts"->"Low-stock alerts on reorder point.","inventory_transfers"->"Transfers tracked with transfer ID.","cycle_counts"->"Cycle counts via POST /inventory/count."]
@MAP id=NotificationSystem | pairs=["notification_channels"->"Supports email, SMS, push, in-app.","notification_templates"->"Templates use Handlebars, versioned.","notification_priority"->"Priority levels: critical, high, normal, low.","quiet_hours"->"Quiet hours 10 PM to 7 AM.","email_notifications"->"Email uses transactional provider, tracked via webhooks.","sms_notifications"->"SMS via gateway, international needs sender IDs.","push_notifications"->"Push targets devices, multiple registrations.","in_app_notifications"->"In-app persisted, read/unread status.","notification_preferences"->"Preferences allow opt-out per channel.","bulk_notifications"->"Bulk queued, 1000/min rate."]
@MAP id=AnalyticsModule | pairs=["analytics_data"->"Provides real-time, historical data.","event_collection"->"Events via SDK, API; include timestamp, user_id, session_id.","real_time_dashboards"->"Dashboards update every 5s for 15min data.","historical_queries"->"Aggregation by minute, hour, day, week, month.","custom_events"->"Custom events: 10 properties, alphanumeric names.","funnels"->"Funnels track progression, auto drop-off rates.","cohort_analysis"->"Cohort analysis by first event date.","data_retention"->"Retention: 13 months detailed, unlimited aggregated.","data_export"->"Export via GET /analytics/export in CSV, Parquet.","query_performance"->"Optimized with column storage, date partitioning."]
@MAP id=ReportingModule | pairs=["reporting_module"->"Generates scheduled, on-demand reports.","standard_reports"->"Standard reports: revenue, orders, customers, inventory, churn.","custom_reports"->"Custom reports via SQL-like language.","report_scheduling"->"Scheduled daily, weekly, monthly; email delivery.","report_formats"->"Formats: PDF, CSV, Excel, JSON.","dashboards"->"Dashboards aggregate reports, 12 widgets max.","drill_down"->"Drill-down on standard reports.","report_caching"->"Caching prevents redundant computation.","access_control"->"Access control by role, finance/admin for financial reports.","report_generation"->"Large date ranges queued, async processing.","report_notification"->"Notification on report readiness."]
@MAP id=CachingLayer | pairs=["caching_layer"->"Between API and database for frequent resources.","cache_ttl"->"Default TTL 300s, max 86400s.","cache_strategy"->"Stale-while-revalidate strategy. [stale-while-revalidate]","cache_invalidation"->"Event-driven invalidation via event bus.","cache_backend"->"Redis 7.x cluster, 3 primary, 3 replica.","cache_keys"->"Keys: {service}:{resource}:{id}:{version}.","cache_hit_rates"->"Target 95% hit rate for read-heavy.","large_objects"->"Compress >1MB with LZ4.","cache_warming"->"Warming prevents cold-start spikes.","cache_isolation"->"Per-tenant isolation prevents noisy neighbors."]
@MAP id=Observability | pairs=["pillars"->"Three pillars: tracing, metrics, logging","tracing"->"Tracing with OpenTelemetry, W3C Trace Context","metrics"->"Metrics in Prometheus format","logging"->"Logging in JSON format","log_level"->"Log level: info, debug per-service","trace_sampling"->"Trace sampling: 10% prod, 100% staging","log_retention"->"Log retention: 90d index, 1y cold","alerts"->"Alerts via Terraform","dashboards"->"Dashboards use RED method","slo_tracking"->"SLO tracking, 50% budget page"]
@MAP id=ServiceCommunication | pairs=["communication"->"gRPC internal, REST external","event_sourcing"->"Event sourcing for audit history","cqrs"->"CQRS for read/write separation","data_ownership"->"Service-owned databases, API boundaries","event_bus"->"Kafka with at-least-once delivery [Apache Kafka]","circuit_breaker"->"Circuit breaker after 5 failures","saga_pattern"->"Saga for distributed transactions","api_gateway"->"API gateway for cross-cutting concerns","service_mesh"->"Service mesh for TLS, observability","deployments"->"Blue-green, canary releases [5%]","note"->"order.created","note"->"order.updated","note"->"order.completed","note"->"payment.succeeded","note"->"payment.failed","note"->"invoice.paid","note"->"410","note"->"3600","note"->"2000","note"->"8601","note"->"2026","note"->"RateLimit","note"->"Standard Contractual Clauses","note"->"UTC"]
