@DOC ver=2.0 | id=chunk-1-5 | title="API Rules and Error Codes" | domain=technical | kind=rule | profile=exec | fmt=ultra
@INTENT goal="Extract semantic structure of API rules and error codes"
@SEC name=Authentication
@RULE lvl=must | when="using OAuth2" | then="OAuth2 Bearer tokens"
@RULE lvl=must | when="token issued" | then="Token TTL 3600s"
@RULE lvl=must | when="rate limit exceeded" | then="429 with Retry-After on limit"
@RULE lvl=must | when="using admin tokens" | then="Admin tokens access all orgs"
@RULE lvl=must | when="using regular tokens" | then="User tokens own org only"
@RULE lvl=must | when="API request" | then="Auth header required"
@RULE lvl=must | when="using refresh token" | then="Refresh tokens single use"
@SEC name="Users API"
@RULE lvl=must | when="creating user" | then="POST /users requires fields"
@RULE lvl=must | when="email address" | then="Email unique per org"
@RULE lvl=must | when="role not specified" | then="Default role member"
@RULE lvl=must | when="updating user" | then="Email change needs verification"
@RULE lvl=must | when="deleting user" | then="Soft delete to archived"
@RULE lvl=must | when="deleting archived user" | then="410 on archived delete"
@SEC name="Orders API"
@RULE lvl=must | when="creating order" | then="POST /orders requires fields"
@RULE lvl=must | when="validating order" | then="Total equals item sum"
@RULE lvl=must | when="using currency" | then="Currency ISO 4217"
@RULE lvl=must | when="mixing currencies" | then="No mixed currencies"
@RULE lvl=must | when="modifying order" | then="Modify in draft only"
@RULE lvl=must | when="deleting order" | then="Use cancel for delete"
@SEC name="Error Codes"
@RULE lvl=must | when="authentication fails" | then="ERR_AUTH on auth fail"
@RULE lvl=must | when="resource not found" | then="ERR_NOT_FOUND on missing"
@RULE lvl=must | when="validation fails" | then="ERR_VALIDATION on fail"
@RULE lvl=must | when="conflict detected" | then="ERR_CONFLICT on conflict"
@RULE lvl=must | when="rate limit exceeded" | then="ERR_RATE_LIMIT on exceed"
@RULE lvl=must | when="payment fails" | then="ERR_PAYMENT_FAILED on fail"
@RULE lvl=must | when="insufficient funds" | then="ERR_INSUFFICIENT_FUNDS on low funds"
@RULE lvl=must | when="permission denied" | then="ERR_PERMISSION_DENIED on deny"
@RULE lvl=must | when="resource locked" | then="ERR_RESOURCE_LOCKED on lock"
@SEC name="Products API"
@RULE lvl=must | when="POST /products" | then="POST /products creates product"
@RULE lvl=must | when="name field" | then="Name max 255 chars"
@RULE lvl=must | when="description field" | then="Description max 2000 chars"
@RULE lvl=must | when="price field" | then="Price in cents"
@RULE lvl=must | when="GET /products" | then="Filter products by category, status, price"
@RULE lvl=must | when="PATCH /products/:id" | then="PATCH updates product fields"
@RULE lvl=must | when="active field set to false" | then="Inactive products excluded from new orders"
@RULE lvl=must | when="delete product" | then="Deactivate before delete if active orders"
@SEC name="Invoices API"
@RULE lvl=must | when="POST /invoices" | then="POST /invoices creates invoice"
@RULE lvl=must | when="invoice status" | then="Invoice statuses: draft, open, paid, void"
@RULE lvl=must | when="invoice in draft" | then="Draft invoices editable"
@RULE lvl=must | when="POST /invoices/:id/pay" | then="POST /invoices/:id/pay charges"
@RULE lvl=must | when="payment fails" | then="Payment fail 402"
@RULE lvl=must | when="POST /invoices/:id/void" | then="Void invoice with POST /invoices/:id/void"
@RULE lvl=must | when="invoice paid" | then="Paid invoices require refund"
@SEC name="Input Validation"
@RULE lvl=must | when="email field" | then="Email RFC 5322 validation"
@RULE lvl=must | when="phone number field" | then="Phone E.164 format"
@RULE lvl=must | when="monetary amounts" | then="Money in positive cents"
@RULE lvl=must | when="date fields" | then="Dates ISO 8601 UTC"
@RULE lvl=must | when="metadata objects" | then="Metadata 20 keys, 500 chars"
@RULE lvl=must | when="array fields" | then="Array max 100 items"
@RULE lvl=must | when="string fields" | then="Trim string whitespace"
@RULE lvl=must | when="empty strings" | then="Empty strings as null"
@RULE lvl=must | when="boolean fields" | then="Boolean true/false, 1/0, yes/no"
@RULE lvl=must | when="enum fields" | then="Enum case-insensitive"
@SEC name=Webhooks
@RULE lvl=must | then="Verify HMAC-SHA256 signature."
@RULE lvl=must | then="Respond 200 in 30s."
@RULE lvl=must | then="HTTPS for endpoints."
@SEC name=Subscriptions
@RULE lvl=must | then="Fields: customer_id, plan_id, trial_days, payment_method_id."
@SEC name=Payments
@RULE lvl=must | then="Fields: amount, currency, method_id, description."
@SEC name="GDPR Compliance"
@RULE lvl=must | then="Encrypt PII: AES-256, TLS 1.3."
@RULE lvl=must | then="Right to erasure: 30 days."
@RULE lvl=must | then="Report breaches: 72 hours."
@RULE lvl=must | then="Annual DPIAs."
@RULE lvl=must | then="Explicit consent required."
@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | then="Least privilege access."
@RULE lvl=must | then="Monthly scans, 48h remediation."
@SEC name="PCI-DSS Compliance"
@RULE lvl=must | when="processing payments" | then="PCI-DSS Level 1 compliance"
@RULE lvl=must | when="storing card numbers" | then="Store last four digits and fingerprint"
@RULE lvl=must | when="storing payment data" | then="Tokenize payment data"
@RULE lvl=must | when="network segmentation" | then="Segment network with firewalls"
@RULE lvl=must | when="monitoring network traffic" | then="Real-time intrusion detection"
@RULE lvl=must | when="managing encryption keys" | then="Rotate keys annually"
@RULE lvl=must | when="accessing servers" | then="Restrict server access"
@RULE lvl=must | when="deploying payment processing code" | then="Security review before deployment"
@RULE lvl=must | when="conducting ASV scans" | then="Quarterly ASV scans"
@SEC name="Rate Limiting"
@RULE lvl=must | when="configuring rate limits" | then="Multi-level rate limiting"
@RULE lvl=must | when="setting global rate limit" | then="Global limit 1000/min"
@RULE lvl=must | when="setting per-user rate limit" | then="Per-user limit 100/min"
@RULE lvl=must | when="setting burst limit" | then="Burst limit 50/1s"
@RULE lvl=must | when=throttling | then="Sliding window throttle"
@RULE lvl=must | when="including rate limit headers" | then="Include rate limit headers [RateLimit]"
@RULE lvl=must | when="rate limited" | then="Use Retry-After header"
@RULE lvl=must | when="handling authenticated requests" | then="Higher limits for authenticated"
@RULE lvl=must | when="handling webhook deliveries" | then="Webhooks not counted"
@RULE lvl=must | when="handling batch endpoints" | then="Batch limits per item"
@SEC name="Shipping Module"
@RULE lvl=must | when="creating shipment" | then="POST /shipping with required fields"
@RULE lvl=must | when="updating status" | then="Propagate status updates"
@RULE lvl=must | when="calculating shipping costs" | then="Calculate costs, cache 15min"
@RULE lvl=must | when="handling international shipments" | then="Require customs data"
@RULE lvl=must | when="generating shipping labels" | then="Generate labels via POST"
@SEC name="Inventory Module"
@RULE lvl=must | when="tracking stock levels" | then="Track stock levels"
@RULE lvl=must | when="adjusting inventory" | then="Adjust inventory via POST"
@RULE lvl=must | when="making adjustments" | then="Allow positive/negative, reject zero"
@RULE lvl=must | when="reserving stock" | then="Reserve on order confirmation"
@RULE lvl=must | when="low-stock alerts" | then="Low-stock alerts below reorder point"
@RULE lvl=must | when="transferring inventory" | then="Track transfers with ID"
@RULE lvl=must | when="initiating cycle counts" | then="Initiate cycle counts via POST"
@RULE lvl=must | when="logging discrepancies" | then="Log discrepancies, require approval"
@SEC name="Notification System"
@RULE lvl=must | when="using notification templates" | then="Handlebars templates"
@RULE lvl=must | when="setting notification priority" | then="Critical bypass quiet hours"
@RULE lvl=must | when="configuring quiet hours" | then="Quiet hours 10 PM to 7 AM"
@RULE lvl=must | when="sending email notifications" | then="Email via provider, track delivery"
@RULE lvl=must | when="sending SMS notifications" | then="SMS via gateway, sender IDs"
@RULE lvl=must | when="sending push notifications" | then="Push to specific devices"
@RULE lvl=must | when="handling in-app notifications" | then="In-app notifications persisted"
@RULE lvl=must | when="setting notification preferences" | then="Opt-out per channel"
@RULE lvl=must | when="processing bulk notifications" | then="Bulk process 1000/min"
@SEC name="Analytics Module"
@RULE lvl=must | when="collecting events" | then="Collect events with SDK/API"
@RULE lvl=must | when="updating real-time dashboards" | then="Dashboards update every 5s"
@RULE lvl=must | when="supporting historical queries" | then="Aggregate historical queries"
@RULE lvl=must | when="defining custom events" | then="Custom events with 10 properties"
@RULE lvl=must | when="tracking funnels" | then="Track funnels, auto drop-off"
@RULE lvl=must | when="performing cohort analysis" | then="Cohort analysis by event date"
@RULE lvl=must | when="retaining data" | then="Retain data 13 months"
@RULE lvl=must | when="exporting analytics data" | then="Export analytics via GET"
@RULE lvl=must | when="optimizing query performance" | then="Optimize queries with column storage"
@SEC name="Reporting Module"
@RULE lvl=must | when="generating reports" | then="Standard reports list"
@RULE lvl=must | when="defining custom reports" | then="Define custom reports with SQL-like language"
@RULE lvl=must | when="scheduling reports" | then="Schedule reports with email delivery"
@RULE lvl=must | when="supporting report formats" | then="Support multiple report formats [JSON]"
@RULE lvl=must | when="aggregating dashboards" | then="Aggregate dashboards with 12 widgets"
@RULE lvl=must | when="supporting drill-down" | then="Support drill-down on reports"
@RULE lvl=must | when="caching reports" | then="Cache reports, TTL based on freshness"
@RULE lvl=must | when="controlling access" | then="Control access by role"
@RULE lvl=must | when="generating large reports" | then="Queue large reports, notify when ready"
@SEC name="HIPAA Compliance"
@RULE lvl=must | when="handling PHI" | then="HIPAA compliance for PHI"
@RULE lvl=must | when="accessing PHI" | then="Role-based access for PHI"
@RULE lvl=must | when="accessing PHI" | then="Log PHI access, 6 years"
@RULE lvl=must | when="PHI is at rest" | then="Encrypt PHI at rest"
@RULE lvl=must | when="PHI is in transit" | then="Encrypt PHI in transit [1.3]"
@RULE lvl=must | when="a breach occurs" | then="Notify breaches in 60 days"
@RULE lvl=must | when="conducting risk assessments" | then="Annual risk assessments"
@RULE lvl=must | when="workforce members access PHI" | then="Annual HIPAA training"
@RULE lvl=must | when="third parties access PHI" | then="Sign BAAs for PHI access"
@RULE lvl=must | when="system outages occur" | then="Emergency PHI access"
@RULE lvl=must | when="documenting policies" | then="Review policies annually"
@RULE lvl=must | when="implementing physical safeguards" | then="Physical safeguards for PHI"
@RULE lvl=must | when="implementing technical safeguards" | then="Technical safeguards for PHI"
@SEC name="Service Architecture"
@RULE lvl=must | when="making external service calls" | then="Circuit breaker for external calls"
@MAP id=Webhooks | pairs=["webhooks"->"Webhooks for events: order.created, order.updated, order.completed, payment.succeeded, payment.failed, invoice.paid.","retry_strategy"->"Retry with backoff: 1m, 5m, 25m, 2h, 10h."]
@MAP id=Subscriptions | pairs=["status_flow"->"Status flow: trialing → active → past_due → canceled."]
@MAP id=Payments | pairs=["payment_response"->"200 on success, 402 on failure."]
@MAP id=ShippingModule | pairs=["ups"->"supported","fedex"->"supported","dhl"->"supported","usps"->"supported","custom"->"requires tracking URL template","created"->"status","picked_up"->"status","in_transit"->"status","out_for_delivery"->"status","delivered"->"status","failed"->"status","returned"->"status"]
@MAP id=CachingLayer | pairs=["cache_layer"->"Cache between API and DB","cache_ttl"->"Cache TTL: 5min default, 24h max [86400]","cache_strategy"->"Stale-while-revalidate strategy [stale-while-revalidate]","cache_invalidation"->"Event-driven cache invalidation","cache_backend"->"Redis 7.x cluster mode","cache_keys"->"Cache key pattern","cache_hit_rate"->"95% cache hit target","cache_compression"->"Compress >1MB with LZ4","cache_warming"->"Cache warming on deploy","cache_isolation"->"Per-tenant cache isolation"]
@MAP id=Observability | pairs=["observability"->"Observability pillars","tracing"->"OpenTelemetry tracing","metrics"->"Prometheus metrics","logging"->"Structured JSON logging","log_level"->"Log level: info","trace_sampling"->"Trace sampling: 10% prod, 100% staging","log_retention"->"Log retention: 90d index, 1y cold","alerts"->"Terraform alerts","dashboards"->"RED method dashboards","slo_tracking"->"SLO tracking, 50% budget"]
@MAP id=ServiceArchitecture | pairs=["service_communication"->"gRPC internal, REST external","event_sourcing"->"Event sourcing for orders/payments","cqrs"->"CQRS pattern","service_databases"->"Service-owned databases","event_bus"->"Kafka event bus [at-least-once] [Apache Kafka]","saga_pattern"->"Saga pattern for transactions","api_gateway"->"API gateway functions","service_mesh"->"Service mesh features","deployments"->"Blue-green, canary releases [5%]","note"->"1999","note"->"1234567890","note"->"2026","note"->"19.99","note"->"Standard Contractual Clauses","note"->"PST"]
