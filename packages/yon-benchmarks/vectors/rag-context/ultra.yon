@DOC ver=2.0 | id=financial-policy | title="Financial Policy" | kind=policy | profile=decl | fmt=ultra
@SEC name="Financial Transactions"
@RULE lvl=MUST | then="Report transactions >$10,000 within 24h [within 24 hours]"
@RULE lvl=MUST | then="LEI required for corporate wire transfers"
@RULE lvl=MUST | then="ID verification for individual accounts"
@SEC name="Investment Recommendations"
@RULE lvl=MUST | then="Include risk disclosure in recommendations"
@RULE lvl=MUST | then="Reference risk category and 3-year performance"
@SEC name="Trading Desk"
@NOTE text="Restricted list updated every Monday 9:00 AM ET"
@RULE lvl=MUST_NOT | then="No personal trades on restricted list"
@SEC name="Customer Complaints"
@RULE lvl=MUST | then="Log complaints in CRM within 4h"
@RULE lvl=MUST | then="Track complaints with ID, respond in 48h"
@SEC name="Stress Testing"
@RULE lvl=MUST | then="Quarterly stress testing per Appendix C"
@RULE lvl=MUST | then="No position >15% in worst-case"
@SEC name="AML Training"
@RULE lvl=MUST | then="Annual AML training mandatory [annually]"
@RULE lvl=MUST | then="New hires: AML training in 30 days [within 30 days]"
@RULE lvl=MUST | then="Refresher covers FinCEN, FATF updates"
@SEC name="Data Retention"
@RULE lvl=MUST | then="Trade records: 7-year retention"
@RULE lvl=MUST | then="Archive trading communications 5 years"
@RULE lvl=MUST | then="Scan/store documents in 90 days [within 90 days]"
@SEC name="Chinese Wall Policy"
@RULE lvl=MUST | then="No info sharing between analysts/bankers"
@RULE lvl=MUST | then="Crossing wall needs CCO approval [Chief Compliance Officer]"
@SEC name="Account Reconciliation"
@RULE lvl=MUST | then="Reconcile accounts by 5th business day [by the 5] [Monthly]"
@RULE lvl=MUST | then="Escalate discrepancies >$500 in 24h [within 24 hours]"
@SEC name="Marketing Materials"
@RULE lvl=MUST | then="Use net-of-fees in marketing returns"
@RULE lvl=MUST | then="Include disclaimer in materials [Past performance does not guarantee future results.]"
@RULE lvl=MUST | then="Compliance review before distribution"
@SEC name="Whistleblower Reports"
@RULE lvl=MUST | then="Submit reports anonymously"
@RULE lvl=MUST | then="No retaliation against reporters"
@RULE lvl=MUST | then="Investigate within 7 business days"

