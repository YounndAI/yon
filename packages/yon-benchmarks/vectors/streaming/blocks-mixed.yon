@DOC ver=2.0 | kind=data | id=blocks-mixed | title="Mixed Blocks and Sections" | profile=exec | fmt=canon

@SEC name="Configuration"

@CFG key=app_name | val="BenchmarkApp"
@CFG key=version | val="2.1.0"
@CFG key=environment | val="production"

@NOTE text="The following section embeds code blocks interleaved with records."

@SEC name="Server Setup"

@RULE lvl=MUST | when="starting server" | then="validate config before binding port"
@RULE lvl=SHOULD | when="production" | then="enable request logging"

@BEGIN lang=typescript | id=server-config
import { createServer } from 'node:http';

const server = createServer((req, res) => {
  res.writeHead(200, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify({ status: 'ok' }));
});

server.listen(3000, () => {
  console.log('Server running on port 3000');
});
@END

@SEC name="Database"

@CFG key=db_host | val="localhost"
@CFG key=db_port | val:int=5432
@CFG key=db_name | val="benchmarks"

@BEGIN lang=sql | id=schema
CREATE TABLE IF NOT EXISTS results (
  id SERIAL PRIMARY KEY,
  suite_id VARCHAR(100) NOT NULL,
  test_id VARCHAR(100) NOT NULL,
  passed BOOLEAN NOT NULL,
  metric_value NUMERIC(10,4),
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_results_suite ON results(suite_id);
@END

@SEC name="Monitoring"

@MAP id=Alerts | pairs=["error"->"/alerts/error","warning"->"/alerts/warning","info"->"/alerts/info"]

@NOTE text="Health check endpoint returns 200 with JSON body."

@BEGIN lang=json | id=health-response
{
  "status": "healthy",
  "uptime": 86400,
  "version": "2.1.0",
  "checks": {
    "database": "connected",
    "cache": "available",
    "queue": "processing"
  }
}
@END

@SEC name="Deployment"

@STEP rid=step:build | n:int=1 | op=build | desc="Compile TypeScript and bundle assets"
@STEP rid=step:test | n:int=2 | op=test | desc="Run full test suite"
@STEP rid=step:deploy | n:int=3 | op=deploy | desc="Push container to registry"
@STEP rid=step:verify | n:int=4 | op=verify | desc="Run smoke tests against staging"

@BEGIN lang=bash | id=deploy-script
#!/bin/bash
set -euo pipefail

echo "Building..."
npm run build

echo "Testing..."
npm test

echo "Deploying..."
docker build -t app:latest .
docker push registry.example.com/app:latest

echo "Verifying..."
curl -sf https://staging.example.com/health || exit 1
echo "Deploy complete."
@END

