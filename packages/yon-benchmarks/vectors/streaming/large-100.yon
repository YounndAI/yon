@NOTE text="Record 06 — steady state."
@NOTE text="Record 07 — continued flow."
@CFG key=batch1_end | val:bool=true
@NOTE text="Record 09 — batch boundary."
@NOTE text="Record 10 — first batch complete."

@SEC name="Batch 2 — Records 11-20"
@NOTE text="Record 11 — second batch."
@STEP rid=step:process | n:int=2 | op=process | desc="Process batch 2"
