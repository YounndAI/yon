@DOC ver=2.0 | kind=benchmark | id=large-100 | title="100-Record Streaming Vector" | profile=exec | fmt=canon

@SEC name="Header"
@CFG key=purpose | val="Validate incremental streaming parse across 100 records"
@CFG key=records | val:int=100

@SEC name="Batch 1 — Records 1-10"
@NOTE text="Record 01 — stream begins."
@RULE lvl=MUST | when="first record" | then="begin processing immediately"
@NOTE text="Record 03 — early stream."
@MAP id=Batch1 | pairs=["a"->"1","b"->"2","c"->"3"]
