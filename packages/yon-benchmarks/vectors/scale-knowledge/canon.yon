@DOC ver=2.0 | id=chunk-1-5 | title="API and Endpoint Rules" | domain=technical | kind=rule | profile=exec | fmt=canon

@SEC name=Authentication
@RULE lvl=must | when="using Bearer token OAuth2" | then="Authentication uses Bearer token OAuth2 with a 3600 second TTL and 30-day refresh."
@RULE lvl=must | when="rate limited" | then="Rate limit is 500 requests per minute globally. When rate limited, return 429 with Retry-After header."
@RULE lvl=must | when="using admin tokens" | then="Admin tokens can access all organizations. User tokens can only access their own organization."
@RULE lvl=must | when="making API requests" | then="All API requests must include the Authorization header with a valid bearer token."
@RULE lvl=must | when="issuing tokens" | then="Tokens are issued by the /auth/token endpoint using client credentials or authorization code flow."
@RULE lvl=must | when="using refresh tokens" | then="Refresh tokens can be used once and are invalidated after use. A new refresh token is issued with each access token."

@SEC name="Users Endpoint"
@RULE lvl=must | when="POST /users" | then="The users endpoint at POST /users creates a new user. Required fields are name, email, and role."
@RULE lvl=must | when="assigning email" | then="Email must be unique per organization."
@RULE lvl=must | when="assigning roles" | then="Roles are admin, member, or viewer. Default role is member."
@RULE lvl=must | when="GET /users" | then="GET /users returns a paginated list with cursor-based pagination. Default limit is 25, max is 100."
@RULE lvl=must | when="GET /users/:id" | then="GET /users/:id returns a single user or 404 if not found. Includes last_login and created_at."
@RULE lvl=must | when="PATCH /users/:id" | then="PATCH /users/:id does a partial update with merge semantics. Cannot change email without verification."
@RULE lvl=must | when="DELETE /users/:id" | then="DELETE /users/:id soft-deletes by setting status to archived. Archived users cannot log in."
@RULE lvl=must | when="user already archived" | then="If the user is already archived, return 410 Gone."

@SEC name="Orders Endpoint"
@RULE lvl=must | when="POST /orders" | then="The orders endpoint at POST /orders creates a new order. Required fields are customer_id, items, total, and currency."
@RULE lvl=must | when="defining items" | then="Each item must have product_id, quantity, and unit_price. Total must equal sum of (quantity * unit_price)."
@RULE lvl=must | when="defining currency" | then="Currency must be ISO 4217 (USD, EUR, GBP, CAD, AUD, JPY). Mixed currencies in one order are not allowed."
@RULE lvl=must | when="GET /orders" | then="GET /orders supports filtering by customer_id, status, date range, and minimum total amount."
@RULE lvl=must | when="order lifecycle" | then="Orders go through a lifecycle: draft → confirmed → processing → shipped → delivered. Can be canceled before shipped."
@RULE lvl=must | when="PATCH /orders/:id" | then="PATCH /orders/:id allows updating items only in draft status. Status changes use dedicated endpoints."
@RULE lvl=must | when="POST /orders/:id/confirm" | then="POST /orders/:id/confirm moves from draft to confirmed and triggers payment authorization."
@RULE lvl=must | when="POST /orders/:id/cancel" | then="POST /orders/:id/cancel marks as canceled and triggers refund if payment was captured."
@RULE lvl=must | when="DELETE /orders/:id" | then="DELETE /orders/:id is not supported. Use cancel instead."

@SEC name="Error Codes"
@RULE lvl=must | when=ERR_AUTH | then="ERR_AUTH means invalid or expired token."
@RULE lvl=must | when=ERR_NOT_FOUND | then="ERR_NOT_FOUND means the requested resource does not exist."
@RULE lvl=must | when=ERR_VALIDATION | then="ERR_VALIDATION means the request body failed schema validation."
@RULE lvl=must | when=ERR_CONFLICT | then="ERR_CONFLICT means a duplicate resource was detected (e.g., duplicate email)."
@RULE lvl=must | when=ERR_RATE_LIMIT | then="ERR_RATE_LIMIT means too many requests."
@RULE lvl=must | when=ERR_PAYMENT_FAILED | then="ERR_PAYMENT_FAILED means the payment provider rejected the transaction."
@RULE lvl=must | when=ERR_INSUFFICIENT_FUNDS | then="ERR_INSUFFICIENT_FUNDS means the account balance is too low."
@RULE lvl=must | when=ERR_PERMISSION_DENIED | then="ERR_PERMISSION_DENIED means the token does not have the required scope."
@RULE lvl=must | when=ERR_RESOURCE_LOCKED | then="ERR_RESOURCE_LOCKED means the resource is being modified by another process."

@SEC name="Subscriptions Endpoint"
@RULE lvl=must | when="POST /subscriptions" | then="POST /subscriptions creates a new subscription"
@MAP id=Required Fields name="Required Fields" | pairs=["customer_id"->"required","plan_id"->"required","trial_days"->"0-365","payment_method_id"->"required unless trial"]
@RULE lvl=must | then="Subscriptions start immediately or after the trial period"
@RULE lvl=must | then="First invoice is created automatically unless in trial"
@RULE lvl=must | then="Billing cycle anchor can be set to a specific date"
@MAP id=Proration Behavior name="Proration Behavior" | pairs=["create_prorations"->"default","none"->"option","always_invoice"->"option"]
@RULE lvl=must | then="Status flow is trialing → active → past_due → canceled"
@RULE lvl=must | when="PATCH /subscriptions/:id" | then="PATCH /subscriptions/:id can update items, payment method, and metadata"
@RULE lvl=must | when="DELETE /subscriptions/:id" | then="DELETE /subscriptions/:id cancels the subscription"

@SEC name="Payments Endpoint"
@RULE lvl=must | when="POST /payments" | then="POST /payments creates a payment"
@MAP id=Required Fields name="Required Fields" | pairs=["amount"->"integer cents","currency"->"ISO 4217","method_id"->"required","description"->"required"]
@RULE lvl=must | then="Payments are processed synchronously"
@RULE lvl=must | then="Success returns 200 with transaction_id"
@RULE lvl=must | then="Failure returns 402 with error details"
@RULE lvl=must | then="3D Secure is triggered when required"
@RULE lvl=must | when="POST /payments/:id/refund" | then="Refunds are created via POST /payments/:id/refund"
@MAP id=Payment Methods name="Payment Methods" | pairs=["cards"->"method","bank transfers"->"method","digital wallets"->"method"]

@SEC name="GDPR Compliance"
@RULE lvl=must | then="Encrypt all PII at rest using AES-256 and in transit using TLS 1.3"
@RULE lvl=must | then="Right to erasure must be implemented and completed within 30 days"
@RULE lvl=must | then="Data processing records must be maintained and available for audit at all times"
@RULE lvl=must | then="Data breaches must be reported to the supervisory authority within 72 hours"
@RULE lvl=must | then="Data protection impact assessments must be conducted annually"
@RULE lvl=must | then="A data protection officer must be appointed and their contact details published on the privacy page"
@RULE lvl=must | then="Explicit consent must be obtained before processing personal data"
@RULE lvl=must | then="Data portability requests must be fulfilled in a machine-readable format (JSON or CSV) within 30 days"
@RULE lvl=must | then="Cross-border data transfers require Standard Contractual Clauses or adequacy decisions"

@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | then="Access controls must follow the principle of least privilege"
@RULE lvl=must | then="Audit logs must record all data access events"
@RULE lvl=must | then="Vulnerability scans must be conducted monthly"
@RULE lvl=must | then="Penetration testing must be performed annually"
@RULE lvl=must | then="Incident response procedures must include detection, triage, containment, eradication, and post-mortem phases"
@RULE lvl=must | then="Business continuity plans must be tested semi-annually"
@RULE lvl=must | then="Backups must be encrypted at rest and tested for recoverability quarterly"
@RULE lvl=must | then="Multi-factor authentication is required for all administrative access"
@RULE lvl=must | then="Employee background checks must be completed before granting system access"
@RULE lvl=must | then="Vendor security assessments must be conducted annually"

@SEC name="PCI-DSS Level 1 Compliance"
@RULE lvl=must | then="Full card numbers must never be stored after authorization"
@RULE lvl=must | then="Payment data must be tokenized before storage"
@RULE lvl=must | then="The payment processing network must be segmented from other internal networks with firewall rules"
@RULE lvl=must | then="Intrusion detection systems must monitor all network traffic in the payment segment in real-time"
@RULE lvl=must | then="Encryption keys must be rotated annually"
@RULE lvl=must | then="Physical access to servers processing cardholder data must be restricted to authorized personnel only"
@RULE lvl=must | then="All payment processing code must undergo security review before deployment"
@RULE lvl=must | then="Quarterly ASV scans must be conducted by an approved scanning vendor"

@SEC name="Rate Limiting"
@MAP id=Rate Limits name="Rate Limits" | pairs=["global"->"1000 requests per minute","per-user"->"100 requests per minute","burst"->"50 requests in 1-second window"]
@RULE lvl=must | then="Throttle strategy is sliding window"
@RULE lvl=must | then="Rate limit headers are included in all responses"
@RULE lvl=must | then="Retry-After header specifies the number of seconds to wait when rate limited"
@RULE lvl=must | then="Authenticated requests have higher limits than anonymous requests"
@RULE lvl=must | then="Webhook deliveries do not count against rate limits"
@RULE lvl=must | then="Batch endpoints have separate rate limits calculated per item, not per request"

@SEC name="Shipping Module"
@RULE lvl=must | when="POST /shipping" | then="POST /shipping creates a shipment for an order"
@MAP id=Required Fields name="Required Fields" | pairs=["order_id"->"required","carrier"->"required","tracking_number"->"required","estimated_delivery"->"required"]
@MAP id=Supported Carriers name="Supported Carriers" | pairs=["ups"->"carrier","fedex"->"carrier","dhl"->"carrier","usps"->"carrier","custom"->"carrier"]
@RULE lvl=must | then="Custom carriers require a tracking URL template"
@MAP id=Shipment Statuses name="Shipment Statuses" | pairs=["created"->"status","picked_up"->"status","in_transit"->"status","out_for_delivery"->"status","delivered"->"status","failed"->"status","returned"->"status"]
@RULE lvl=must | then="Status updates come from carrier webhooks"
@RULE lvl=must | then="Shipping costs are calculated based on weight, dimensions, origin, and destination"
@RULE lvl=must | then="Quotes are cached for 15 minutes"
@RULE lvl=must | then="International shipments require customs declaration data including HS codes and declared values"
@RULE lvl=must | when="POST /shipping/:id/label" | then="Shipping labels can be generated via POST /shipping/:id/label in PDF or ZPL format"

@SEC name="Inventory Module"
@NOTE text="The inventory module tracks stock levels across warehouses. Each product can exist in multiple locations."
@NOTE text="Stock levels are tracked as available, reserved, and damaged quantities."
@RULE lvl=must | when="POST /inventory/adjust" | then="POST /inventory/adjust creates an inventory adjustment with reason, quantity change, and reference ID."
@RULE lvl=must | then="Zero adjustments are rejected."
@RULE lvl=must | when="order is confirmed" | then="Reservation occurs when an order is confirmed."
@RULE lvl=must | then="Reserved stock cannot be sold to other customers."
@RULE lvl=must | when="available quantity drops below reorder point" | then="Low-stock alerts fire when available quantity drops below the reorder point configured per product per warehouse."
@NOTE text="Inventory transfers between warehouses are tracked as paired adjustments with a transfer ID."
@RULE lvl=must | when="POST /inventory/count" | then="Cycle counts can be initiated via POST /inventory/count to verify physical stock matches system records."
@RULE lvl=must | then="Discrepancies from cycle counts are logged and require manager approval before adjustment."

@SEC name="Notification System"
@NOTE text="The notification system supports email, SMS, push, and in-app channels."
@NOTE text="Notification templates use Handlebars syntax with variable substitution. Templates are versioned."
@NOTE text="Each notification has a priority level: critical, high, normal, low. Critical notifications bypass quiet hours."
@CFG id=Quiet Hours | set=[set="configurable per user from 10 PM to 7 AM local time by default"]
@NOTE text="Email notifications use the transactional email provider. Delivery status is tracked via webhooks."
@NOTE text="SMS notifications are sent via the SMS gateway. International SMS requires country-specific sender IDs."
@NOTE text="Push notifications target specific devices. Users can have multiple devices registered."
@NOTE text="In-app notifications are persisted and shown in the notification center with read/unread status."
@RULE lvl=must | then="Notification preferences allow users to opt out of specific notification types per channel."
@RULE lvl=must | then="Bulk notifications are queued and processed at a rate of 1000 per minute to prevent provider throttling."

@SEC name="Analytics Module"
@NOTE text="The analytics module provides real-time and historical data about system usage."
@NOTE text="Events are collected via a client SDK and server-side API. All events include timestamp, user_id, and session_id."
@RULE lvl=must | then="Real-time dashboards update every 5 seconds for the last 15 minutes of data."
@NOTE text="Historical queries support aggregation by minute, hour, day, week, and month."
@RULE lvl=must | then="Custom events can be defined with up to 10 properties each. Property names must be alphanumeric with underscores."
@NOTE text="Funnels track user progression through defined step sequences. Drop-off rates are calculated automatically."
@NOTE text="Cohort analysis groups users by first event date and tracks retention over time."
@NOTE text="Data retention is 13 months for detailed events and unlimited for aggregated metrics."
@RULE lvl=must | when="GET /analytics/export" | then="Analytics data can be exported via GET /analytics/export in CSV or Parquet format."
@NOTE text="Query performance is optimized using column-oriented storage with automatic partitioning by date."

@SEC name="Reporting Module"
@NOTE text="The reporting module generates scheduled and on-demand business reports."
@NOTE text="Standard reports include revenue, orders, customers, inventory, and churn metrics."
@RULE lvl=must | then="Custom reports can be defined using a SQL-like query language against the analytics data warehouse."
@CFG id=Report Scheduling | set=[set="daily, weekly, or monthly with email delivery to distribution lists"]
@NOTE text="Report formats supported are PDF, CSV, Excel, and JSON. Each format has different configuration options."
@NOTE text="Dashboards aggregate multiple reports into a single view. Up to 12 widgets per dashboard."
@RULE lvl=must | then="Drill-down is supported on all standard reports. Clicking a metric opens the detailed view."
@NOTE text="Report caching prevents redundant computation. Cache TTL depends on data freshness requirements."
@RULE lvl=must | then="Access control limits report visibility by role. Financial reports require finance or admin role."
@RULE lvl=must | when="large date ranges" | then="Report generation for large date ranges is queued and processed asynchronously."
@RULE lvl=must | then="A notification is sent when the report is ready for download."

@SEC name="HIPAA Compliance"
@RULE lvl=must | then="HIPAA compliance requirements are mandatory for all protected health information (PHI) handling."
@RULE lvl=must | then="Access controls must enforce role-based access to PHI with the minimum necessary standard."
@RULE lvl=must | then="All PHI access must be logged in tamper-proof audit trails retained for 6 years."
@RULE lvl=must | then="PHI must be encrypted at rest using AES-256 and in transit using TLS 1.3."
@RULE lvl=must | then="Breach notification procedures must be in place. Affected individuals must be notified within 60 days."
@RULE lvl=must | then="Risk assessments must be conducted annually and documented with remediation plans."
@RULE lvl=must | then="All workforce members with PHI access must complete HIPAA training annually."
@RULE lvl=must | then="Business associate agreements must be signed with all third parties that access PHI."
@RULE lvl=must | then="Emergency access procedures must allow authorized personnel to access PHI during system outages."
@RULE lvl=must | then="Policies and procedures must be documented, reviewed annually, and updated as needed."
@NOTE text="Physical safeguards include facility access controls and workstation security."
@NOTE text="Technical safeguards include unique user identification, automatic logoff, and audit controls."

@SEC name="Caching Layer"
@NOTE text="The caching layer sits between the API and database for frequently accessed resources."
@CFG id=Cache TTL | set=[set="Default 300 seconds (5 minutes), Maximum 86400 seconds (24 hours)"]
@NOTE text="Cache strategy is stale-while-revalidate: serve stale content while fetching fresh data in the background."
@RULE lvl=must | then="Cache invalidation is event-driven. Database writes trigger cache key invalidation via the event bus."
@NOTE text="The cache backend is Redis 7.x running in cluster mode with 3 primary and 3 replica nodes."
@RULE lvl=must | then="Cache keys follow the pattern: {service}:{resource}:{id}:{version}. Version is incremented on each write."
@NOTE text="Cache hit rates are monitored. Target is 95% for read-heavy endpoints."
@RULE lvl=must | when="Large objects >1MB" | then="Large objects (>1MB) are compressed with LZ4 before caching. Decompression is transparent to consumers."
@RULE lvl=must | then="Cache warming runs during deployment to prevent cold-start latency spikes."
@RULE lvl=must | then="Per-tenant cache isolation prevents noisy neighbors in multi-tenant deployments."

@SEC name=Observability
@NOTE text="Observability is built on three pillars: tracing, metrics, and logging."
@NOTE text="Distributed tracing uses OpenTelemetry with W3C Trace Context propagation."
@NOTE text="Metrics are exported in Prometheus format."
@NOTE text="Logging uses structured JSON format."
@NOTE text="Default log level is info."
@NOTE text="Sampling rate for traces is 10% in production and 100% in staging."
@NOTE text="Log retention is 90 days in the search index and 1 year in cold storage."
@NOTE text="Alerts are defined as code using Terraform."
@NOTE text="Dashboards follow the RED method: Rate, Errors, Duration for every service."
@NOTE text="SLO tracking monitors error budget consumption."

@SEC name=Communication
@NOTE text="All services communicate via gRPC for internal calls and REST for external-facing APIs."

@SEC name="Event Sourcing and CQRS"
@NOTE text="Event sourcing is used for order and payment domains to maintain a complete audit history of all state changes."
@NOTE text="CQRS pattern separates read and write models for high-throughput reporting without impacting write performance."

@SEC name="Service Architecture"
@NOTE text="Each service owns its database. Cross-service data access goes through well-defined API boundaries."
@NOTE text="The event bus uses Apache Kafka with guaranteed at-least-once delivery."
@RULE lvl=must | when="external service calls" | then="Circuit breaker pattern is mandatory for all external service calls."
@NOTE text="Saga pattern is used for distributed transactions spanning multiple services with compensating transactions."

@SEC name="API Gateway and Service Mesh"
@NOTE text="API gateway handles cross-cutting concerns: authentication, rate limiting, request logging, and CORS."
@NOTE text="Service mesh provides mutual TLS, observability, and fine-grained traffic management between services."

@SEC name="Deployment Strategies"
@NOTE text="Blue-green deployments ensure zero-downtime releases."
@NOTE text="Canary releases route 5% of traffic to new versions."

@SEC name="Compliance Module"
@NOTE text="The compliance module manages regulatory requirements across jurisdictions."
@NOTE text="Compliance records are immutable after approval."
@NOTE text="Access to compliance data requires role-based authorization with at least compliance-officer role."
@NOTE text="Compliance reports are generated daily and retained for 7 years per regulatory requirements."
@NOTE text="Compliance data must be backed up every 6 hours with point-in-time recovery capability."
@NOTE text="Automated compliance checks run on every deployment."
@NOTE text="Regulatory updates are tracked via RSS feeds and reviewed by the compliance team monthly."

@SEC name="Legal Module"
@NOTE text="The legal module manages contracts, terms of service, and privacy policies."
@NOTE text="Legal documents go through a review workflow: draft → legal review → approval → published → archived."
@NOTE text="Version control tracks all changes with diff capability between any two versions."
@NOTE text="Digital signatures are supported using eIDAS-compliant qualified electronic signatures."
@NOTE text="Redlining and commenting are available during the review phase for collaborative editing."
@NOTE text="Retention policies are configurable per document type. Default is 7 years after document expiry."
@NOTE text="Template library contains pre-approved clause templates for common contract terms."
@NOTE text="Conflict resolution documents reference specific clause numbers for traceability."
@NOTE text="Legal holds prevent deletion of documents involved in active litigation or regulatory investigation."

@SEC name="Finance Module"
@NOTE text="The finance module manages accounting, revenue recognition, and financial reporting."
@NOTE text="Double-entry bookkeeping ensures every transaction has equal debits and credits."
@NOTE text="Revenue recognition follows ASC 606 standards with five-step model implementation."
@NOTE text="Chart of accounts is configurable per organization with standard GAAP categories pre-loaded."
@NOTE text="Bank reconciliation compares book entries with bank statements imported via OFX or CSV."
@NOTE text="Multi-currency support handles foreign exchange with real-time rates from ECB and fallback to cached rates."
@NOTE text="Tax calculation integrates with external tax engines for jurisdiction-specific rates and rules."
@NOTE text="Financial period closing is a multi-step process with validation checks before finalization."
@NOTE text="Audit trail captures all journal entries with authorization chain and supporting document references."

@SEC name="HR Module"
@NOTE text="The HR module manages employee records, time tracking, and benefits administration."
@NOTE text="Employee records include personal information, employment history, compensation, and emergency contacts."
@NOTE text="Time tracking supports clock-in/clock-out, timesheets, and project-based time allocation."
@NOTE text="PTO management tracks vacation, sick leave, and personal days with accrual rules per employment tier."
@NOTE text="Benefits enrollment windows open annually. Mid-year changes require qualifying life events."
@NOTE text="Performance reviews follow a quarterly cycle with goal setting, self-assessment, and manager evaluation."
@NOTE text="Onboarding checklists are automatically generated based on department and role."
@NOTE text="Offboarding procedures ensure access revocation, equipment return, and knowledge transfer tasks."
@NOTE text="Org chart visualization shows reporting hierarchy with department and location grouping."

@SEC name="Marketing Module"
@NOTE text="The marketing module manages campaigns, leads, and analytics."
@NOTE text="Campaign management supports email, social media, and paid advertising channels."
@NOTE text="Lead scoring assigns points based on engagement, demographics, and firmographics."
@NOTE text="Lead routing distributes qualified leads to sales representatives based on territory and capacity."
@NOTE text="A/B testing framework supports multivariate tests on email subject lines, content, and send times."
@NOTE text="Attribution modeling supports first-touch, last-touch, linear, and data-driven models."
@NOTE text="Marketing automation workflows trigger sequences based on user behavior and time delays."
@NOTE text="UTM parameter tracking captures campaign source, medium, and content for all inbound traffic."
@NOTE text="Landing page builder creates mobile-responsive pages with drag-and-drop components."

@SEC name="Support Module"
@NOTE text="The support module manages customer tickets, knowledge base, and SLA tracking."
@NOTE text="Tickets are created via email, web form, chat, or API. Auto-categorization uses ML classification."
@NOTE text="SLA policies define response and resolution times by priority: P1 (1h/4h), P2 (4h/24h), P3 (24h/72h), P4 (48h/1w)."
@NOTE text="Escalation rules trigger when SLA thresholds approach. First escalation at 75%, second at 90%."
@NOTE text="Knowledge base articles have categories, tags, and version history. Articles can be internal or public."
@NOTE text="Canned responses are template replies for common questions. Agents can personalize before sending."
@NOTE text="Customer satisfaction surveys are sent after ticket closure with a 1-5 rating scale."
@NOTE text="Ticket merging combines duplicate tickets while preserving all communications."
@NOTE text="Macro automation handles routine tickets automatically based on content matching."

@SEC name="Engineering Module"
@NOTE text="The engineering module manages repositories, deployments, and developer tooling."
@RULE lvl=must | then="Repository standards enforce branch naming, commit message format, and required CI checks."
@RULE lvl=must | then="Deployment pipelines support staging, canary, and production environments with manual gates."
@RULE lvl=must | then="Feature flags control gradual rollout percentages and are automatically cleaned up after 30 days."
@RULE lvl=must | then="Code review requires at least two approvals with at least one from a code owner."
@RULE lvl=must | then="Dependency scanning runs on every commit and blocks merges with known critical vulnerabilities."
@RULE lvl=must | then="Infrastructure as code manages all cloud resources. Manual changes in production are detected and alerted."
@NOTE text="Runbook library documents operational procedures for all services with step-by-step troubleshooting."
@RULE lvl=must | then="Post-incident reviews are mandatory for all P1 and P2 incidents within 48 hours."

@SEC name="Security Module"
@NOTE text="The security module manages access control, threat detection, and vulnerability management."
@RULE lvl=must | then="Identity management supports SAML 2.0, OIDC, and SCIM for enterprise SSO integration."
@RULE lvl=must | then="Role hierarchy defines permissions at organization, team, and project levels with inheritance."
@RULE lvl=must | then="Session management enforces maximum session duration of 24 hours with configurable idle timeout."
@RULE lvl=must | then="Threat detection uses behavioral analytics to identify anomalous access patterns."
@RULE lvl=must | then="Vulnerability management tracks findings from SAST, DAST, and dependency scanning tools."
@RULE lvl=must | then="Secret management uses a centralized vault with automatic rotation for database and API credentials."
@RULE lvl=must | then="Network security enforces zero-trust principles with micro-segmentation and identity-aware proxies."
@RULE lvl=must | then="Incident response playbooks define automated containment actions for common attack patterns."

@SEC name="Operations Module"
@NOTE text="The operations module manages infrastructure, monitoring, and capacity planning."
@RULE lvl=must | then="Infrastructure provisioning uses Terraform with pre-approved modules for networking, compute, and storage."
@RULE lvl=must | then="Auto-scaling policies define minimum, maximum, and target utilization for each service tier."
@RULE lvl=must | then="Cost allocation tags track spending by team, project, and environment for chargeback reporting."
@RULE lvl=must | then="Disaster recovery plans define RPO (1 hour) and RTO (4 hours) for all production services."
@RULE lvl=must | then="Chaos engineering experiments run weekly in staging to validate resilience and recovery procedures."
@RULE lvl=must | then="Capacity planning models project resource needs 90 days ahead based on historical growth trends."
@RULE lvl=must | then="Change management requires approval for production changes with rollback plans documented."
@NOTE text="On-call rotation follows a weekly schedule with primary and secondary responders per service."

@SEC name="Partner Module"
@NOTE text="The partner module manages integrations, marketplace listings, and partner programs."
@RULE lvl=must | then="Partner API provides read-only access to product catalog, pricing, and inventory availability."
@RULE lvl=must | then="OAuth 2.0 scopes control partner access at resource level. Token rotation is required every 90 days."
@RULE lvl=must | then="Webhook subscriptions allow partners to receive real-time updates for events they are authorized to access."
@NOTE text="Partner dashboard shows API usage metrics, revenue share calculations, and support ticket status."
@RULE lvl=must | then="Marketplace listings require approval and periodic review. Inactive listings are delisted after 90 days."
@RULE lvl=must | then="Revenue sharing models support percentage-based, fixed-fee, and tiered commission structures."
@NOTE text="Integration testing sandbox provides realistic data sets without exposing production information."
@RULE lvl=must | then="Partner SLA guarantees 99.9% API availability with degraded fallback for non-critical operations."

@SEC name="ISO 27001 Compliance"
@RULE lvl=must | then="Risk assessments based on asset inventory must be conducted before any system change."
@RULE lvl=must | then="Security controls must be proportional to identified risks and documented in the statement of applicability."
@RULE lvl=must | then="Internal audits must be conducted annually with findings tracked to resolution."
@RULE lvl=must | then="Management reviews must occur quarterly to evaluate ISMS effectiveness and update risk treatment plans."
@RULE lvl=must | then="Corrective actions for non-conformities must be implemented within 30 days and verified."
@RULE lvl=must | then="Security personnel must maintain current certifications and complete continuing education annually."
@RULE lvl=must | then="Supplier security assessments must evaluate data handling practices before contract signing."
@RULE lvl=must | then="Incident management capability must include detection, classification, and communication procedures."
@RULE lvl=must | then="Change management for security controls requires impact assessment and approval before implementation."
@RULE lvl=must | then="Security awareness training must be completed by all staff within 30 days of hire and annually thereafter."
@RULE lvl=must | then="Documentation must be version controlled with clear ownership and review schedules."
@NOTE text=HMAC-SHA256
@NOTE text=order.created
@NOTE text=order.updated
@NOTE text=order.completed
@NOTE text=payment.succeeded
@NOTE text=payment.failed
@NOTE text=invoice.paid
@NOTE text=2000
@NOTE text=5322
@NOTE text=1234567890
@NOTE text=8601
@NOTE text=2026
@NOTE text="50%"
@NOTE text=RateLimit
@NOTE text=UTC
