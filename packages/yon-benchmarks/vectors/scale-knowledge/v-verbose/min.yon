@DOC ver=2.0 | id=chunk-1-6 | title="API Rules and Error Handling" | domain=technical | kind=rule | profile=exec | fmt=min
@INTENT goal="Extract semantic structure of API rules and error handling"

@SEC name=Authentication
@RULE lvl=must | when="using OAuth2" | then="OAuth2 with Bearer tokens"
@RULE lvl=must | when="token issued" | then="Token TTL 3600s"
@RULE lvl=must | when="using refresh tokens" | then="Refresh tokens 30d"
@RULE lvl=must | when="rate limit exceeded" | then="429 with Retry-After on limit"
@RULE lvl=must | when="using admin tokens" | then="Admin tokens access all orgs"
@RULE lvl=must | when="using regular user tokens" | then="User tokens own org only"
@RULE lvl=must | when="making API request" | then="Auth header required"
@RULE lvl=must | when="using refresh token" | then="Refresh token single use"

@SEC name="Users API"
@RULE lvl=must | when="creating user" | then="POST /users requires fields"
@RULE lvl=must | when="assigning email" | then="Email unique per org"
@RULE lvl=must | when="role not specified" | then="Default role: member"
@RULE lvl=must | when="GET /users" | then="GET /users paginated"
@RULE lvl=must | when="GET /users/:id" | then="GET /users/:id full object"
@RULE lvl=must | when="PATCH /users/:id" | then="PATCH /users/:id partial update"
@RULE lvl=must | when="changing email" | then="Email change needs verification"
@RULE lvl=must | when="DELETE /users/:id" | then="DELETE /users soft delete"
@RULE lvl=must | when="deleting archived user" | then="410 on archived delete"

@SEC name="Orders API"
@RULE lvl=must | when="creating order" | then="POST /orders requires fields"
@RULE lvl=must | when="validating total" | then="Total equals item sum"
@RULE lvl=must | when="using currency" | then="Currency ISO 4217"
@RULE lvl=must | when="mixing currencies" | then="No mixed currencies"
@RULE lvl=must | when="PATCH /orders/:id" | then="PATCH in draft only"
@RULE lvl=must | when="DELETE /orders/:id" | then="DELETE /orders not supported"

@SEC name="Error Codes"
@RULE lvl=must | when=ERR_AUTH | then="ERR_AUTH token issue"
@RULE lvl=must | when=ERR_NOT_FOUND | then="ERR_NOT_FOUND missing resource"
@RULE lvl=must | when=ERR_VALIDATION | then="ERR_VALIDATION schema fail"
@RULE lvl=must | when=ERR_CONFLICT | then="ERR_CONFLICT resource exists"
@RULE lvl=must | when=ERR_RATE_LIMIT | then="ERR_RATE_LIMIT limit exceeded"
@RULE lvl=must | when=ERR_PAYMENT_FAILED | then="ERR_PAYMENT_FAILED transaction fail"
@RULE lvl=must | when=ERR_INSUFFICIENT_FUNDS | then="ERR_INSUFFICIENT_FUNDS low balance"
@RULE lvl=must | when=ERR_PERMISSION_DENIED | then="ERR_PERMISSION_DENIED scope issue"
@RULE lvl=must | when=ERR_RESOURCE_LOCKED | then="ERR_RESOURCE_LOCKED concurrent mod"

@SEC name="Products API"
@RULE lvl=must | when="POST /products" | then="POST /products creates product"
@RULE lvl=must | when="name field" | then="Name max 255 chars"
@RULE lvl=must | when="description field" | then="Description max 2000 chars"
@RULE lvl=must | when=price | then="Price in smallest unit"
@RULE lvl=must | when="GET /products" | then="Filter by category, status, price"
@RULE lvl=must | when="PATCH /products/:id" | then="PATCH updates fields"
@RULE lvl=must | when="active field set to false" | then="Active false excludes from orders"
@RULE lvl=must | when="delete product" | then="Deactivate before delete"

@SEC name="Invoices API"
@RULE lvl=must | when="POST /invoices" | then="Create invoice from order/subscription"
@RULE lvl=must | when="invoice status" | then="Invoice status stages"
@RULE lvl=must | when="POST /invoices/:id/pay" | then="Charge default payment method"
@RULE lvl=must | when="payment fails" | then="Payment fail 402"
@RULE lvl=must | when="POST /invoices/:id/void" | then="Void invoice"
@RULE lvl=must | when="invoice past due_date" | then="Reminder emails 1, 7, 14 days"

@SEC name="Input Validation"
@RULE lvl=must | when="email field" | then="Email RFC 5322"
@RULE lvl=must | when="phone number field" | then="Phone E.164"
@RULE lvl=must | when="monetary amounts" | then="Amounts in cents"
@RULE lvl=must | when="date fields" | then="Date ISO 8601 UTC"
@RULE lvl=must | when="metadata objects" | then="Metadata 20 keys, 500 chars"
@RULE lvl=must | when="array fields" | then="Array limit 100 items"
@RULE lvl=must | when="string fields" | then="Trim strings, empty as null"
@RULE lvl=must | when="boolean fields" | then="Boolean true/false, 1/0, yes/no"
@RULE lvl=must | when="enum fields" | then="Enum case-insensitive, lowercase"

@SEC name=Webhooks
@NOTE text="Real-time notifications for events [order.created] [order.updated] [order.completed] [payment.succeeded] [payment.failed] [invoice.paid]"
@RULE lvl=must | then="Verify HMAC-SHA256 signature"
@RULE lvl=must | then="Respond 200 in 30s"
@NOTE text="Exponential backoff retries"
@RULE lvl=must | then="HTTPS for URLs"

@SEC name=Subscriptions
@RULE lvl=must | then="Required fields for subscriptions"
@NOTE text="Proration options"

@SEC name=Payments
@RULE lvl=must | then="Required fields for payments"
@NOTE text="Payment response codes [200] [402]"

@SEC name="GDPR Compliance"
@RULE lvl=must | then="Encrypt PII with AES-256, TLS 1.3"
@RULE lvl=must | then="Right to erasure in 30d"

@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | then="Least privilege access"
@RULE lvl=must | then="Monthly vulnerability scans"

@SEC name="PCI-DSS Compliance"
@RULE lvl=must | when="processing payments" | then="PCI-DSS Level 1 governs payment processing."
@RULE lvl=must | when="storing card numbers" | then="Store only last four digits and fingerprint."
@RULE lvl=must | when="storing payment data" | then="Tokenize payment data before storage."
@RULE lvl=must | when="networking payment processing" | then="Segment payment network with firewall."
@RULE lvl=must | when="monitoring network traffic" | then="Monitor payment traffic in real-time."
@RULE lvl=must | when="managing encryption keys" | then="Rotate keys annually or if compromised."
@RULE lvl=must | when="accessing servers" | then="Restrict server access to authorized personnel."
@RULE lvl=must | when="deploying payment processing code" | then="Security review before deployment."
@RULE lvl=must | when="conducting ASV scans" | then="Quarterly ASV scans by approved vendor."

@SEC name="Rate Limiting"
@RULE lvl=must | when="configuring rate limits" | then="Rate limit at global, user, endpoint levels."
@RULE lvl=must | when="applying global rate limit" | then="Global limit: 1000/min."
@RULE lvl=must | when="applying per-user rate limit" | then="User limit: 100/min."
@RULE lvl=must | when="applying burst limit" | then="Burst: 50/1s window."
@RULE lvl=must | when=throttling | then="Sliding window throttling."
@RULE lvl=must | when="including rate limit headers" | then="Include rate limit headers. [RateLimit]"
@RULE lvl=must | when="rate limited" | then="Use Retry-After for wait time."
@RULE lvl=must | when="handling authenticated requests" | then="Higher limits for authenticated."
@RULE lvl=must | when="handling webhook deliveries" | then="Exclude webhooks from limits."
@RULE lvl=must | when="handling batch endpoints" | then="Batch limits per item."

@SEC name="Shipping Module"
@RULE lvl=must | when="creating shipment" | then="POST /shipping with required fields."
@MAP id=Supported Carriers | pairs=["ups"->"","fedex"->"","dhl"->"","usps"->"","custom"->"requires tracking URL template"]
@MAP id=Shipment Statuses | pairs=["created"->"","picked_up"->"","in_transit"->"","out_for_delivery"->"","delivered"->"","failed"->"","returned"->""]
@RULE lvl=must | when="updating status" | then="Propagate status updates via webhooks."
@RULE lvl=must | when="calculating shipping costs" | then="Calculate costs based on weight, etc."
@RULE lvl=must | when="handling international shipments" | then="Require customs data for international."
@RULE lvl=must | when="generating shipping labels" | then="Generate labels via POST."

@SEC name="Inventory Module"
@RULE lvl=must | when="tracking stock levels" | then="Track stock as available, reserved, damaged."
@RULE lvl=must | when="adjusting inventory" | then="Adjust inventory via POST."
@RULE lvl=must | when="making adjustments" | then="Allow positive/negative, reject zero."
@RULE lvl=must | when="reserving stock" | then="Reserve stock on order confirmation."
@RULE lvl=must | when="low-stock alerts" | then="Alert on low stock below reorder point."
@RULE lvl=must | when="transferring inventory" | then="Track transfers as paired adjustments."
@RULE lvl=must | when="initiating cycle counts" | then="Initiate cycle counts via POST."
@RULE lvl=must | when="logging discrepancies" | then="Log discrepancies, require approval."

@SEC name="Notification System"
@RULE lvl=must | when="using notification templates" | then="Use Handlebars for templates."
@RULE lvl=must | when="setting notification priority" | then="Set priority: critical, high, normal, low."
@RULE lvl=must | when="configuring quiet hours" | then="Configure quiet hours per user."
@RULE lvl=must | when="sending email notifications" | then="Use provider, track via webhooks."
@RULE lvl=must | when="sending SMS notifications" | then="Send SMS via gateway, require sender IDs."
@RULE lvl=must | when="sending push notifications" | then="Target specific devices for push."
@RULE lvl=must | when="handling in-app notifications" | then="Persist in-app notifications."
@RULE lvl=must | when="setting notification preferences" | then="Allow opt-out per channel."
@RULE lvl=must | when="processing bulk notifications" | then="Queue bulk notifications at 1000/min."

@SEC name="Analytics Module"
@RULE lvl=must | when="collecting events" | then="Collect events with SDK/API."
@RULE lvl=must | when="updating real-time dashboards" | then="Update dashboards every 5s."
@RULE lvl=must | when="supporting historical queries" | then="Aggregate queries by time unit."
@RULE lvl=must | when="defining custom events" | then="Define custom events with 10 properties."
@RULE lvl=must | when="tracking funnels" | then="Track funnels, auto drop-off rates."
@RULE lvl=must | when="performing cohort analysis" | then="Group cohorts by first event date."
@RULE lvl=must | when="retaining data" | then="Retain data 13 months, unlimited aggregated."
@RULE lvl=must | when="exporting analytics data" | then="Export analytics via GET."
@RULE lvl=must | when="optimizing query performance" | then="Optimize queries with column storage."

@SEC name="Reporting Module"
@RULE lvl=must | when="generating reports" | then="Include standard reports: revenue, etc."
@RULE lvl=must | when="defining custom reports" | then="Define custom reports with SQL-like language."
@RULE lvl=must | when="scheduling reports" | then="Schedule reports with email delivery."
@RULE lvl=must | when="supporting report formats" | then="Support formats: PDF, CSV, Excel, JSON."
@RULE lvl=must | when="aggregating dashboards" | then="Aggregate dashboards with 12 widgets."
@RULE lvl=must | when="supporting drill-down" | then="Enable drill-down on reports."
@RULE lvl=must | when="caching reports" | then="Cache reports with TTL."
@RULE lvl=must | when="controlling access" | then="Limit report access by role."
@RULE lvl=must | when="generating large reports" | then="Queue large reports asynchronously."
@RULE lvl=must | when="report is ready" | then="Notify when report ready."

@SEC name="HIPAA Compliance"
@RULE lvl=must | when="handling PHI" | then="HIPAA compliance for PHI"
@RULE lvl=must | when="accessing PHI" | then="Role-based access for PHI"
@RULE lvl=must | when="accessing PHI" | then="Log PHI access, 6 years"
@RULE lvl=must | when="PHI is at rest" | then="Encrypt PHI at rest"
@RULE lvl=must | when="PHI is in transit" | then="Encrypt PHI in transit [1.3]"
@RULE lvl=must | when="a breach occurs" | then="Notify breaches in 60 days"
@RULE lvl=must | when="conducting risk assessments" | then="Annual risk assessments"
@RULE lvl=must | when="workforce members access PHI" | then="Annual HIPAA training"
@RULE lvl=must | when="third parties access PHI" | then="Sign BAAs for PHI"
@RULE lvl=must | when="system outages occur" | then="Emergency PHI access"
@RULE lvl=must | when="documenting policies" | then="Annual policy review"
@RULE lvl=must | when="implementing physical safeguards" | then="Physical safeguards"
@RULE lvl=must | when="implementing technical safeguards" | then="Technical safeguards"

@SEC name="Caching Layer"
@NOTE text="Cache between API and DB"
@RULE lvl=must | when="setting default cache TTL" | then="Default TTL 5min"
@RULE lvl=must | when="setting maximum cache TTL" | then="Max TTL 24h [86400]"
@RULE lvl=must | when="using cache strategy" | then="Stale-while-revalidate [stale-while-revalidate]"
@RULE lvl=must | when="database writes occur" | then="Event-driven invalidation"
@NOTE text="Redis 7.x cluster"
@RULE lvl=must | when="defining cache keys" | then="Cache key pattern"
@RULE lvl=must | when="monitoring cache hit rates" | then="95% hit rate target"
@RULE lvl=must | when="caching large objects" | then="Compress >1MB with LZ4"
@RULE lvl=must | when=deploying | then="Cache warming on deploy"
@RULE lvl=must | when="in multi-tenant deployments" | then="Per-tenant cache isolation"

@SEC name=Observability
@NOTE text="Tracing, metrics, logging"
@RULE lvl=must | when="using distributed tracing" | then="OpenTelemetry tracing"
@RULE lvl=must | when="exporting metrics" | then="Prometheus metrics"
@RULE lvl=must | when="using custom metrics" | then="Custom metrics naming"
@RULE lvl=must | when=logging | then="Structured JSON logging"
@RULE lvl=must | when=logging | then="Log line includes ID, service, level, timestamp"
@RULE lvl=must | when="setting default log level" | then="Default log level info"
@RULE lvl=must | when="enabling debug logging" | then="Enable debug logging per-service"
@RULE lvl=must | when="sampling traces" | then="Trace sampling 10% prod, 100% staging"
@RULE lvl=must | when="retaining logs" | then="Log retention 90d index, 1y cold"
@RULE lvl=must | when="defining alerts" | then="Alerts as code with Terraform"
@RULE lvl=must | when="creating dashboards" | then="RED method dashboards"
@RULE lvl=must | when="tracking SLO" | then="Monitor error budget"
@RULE lvl=must | when="error budget burn reaches 50% in 1-hour window" | then="Trigger pages at 50% burn"

