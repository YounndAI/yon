@DOC ver=2.0 | id=chunk-1-5 | title="API and Endpoint Rules" | domain=technical | kind=rule | profile=exec | fmt=min
@INTENT goal="Extract semantic structure of engineering, security, operations, partner, and compliance modules"

@SEC name=Authentication
@RULE lvl=must | when=authenticating | then="Bearer token OAuth2, 3600s TTL, 30d refresh"
@RULE lvl=must | when="rate limited" | then="Rate limit 500/min, 429 on limit"
@RULE lvl=must | when="using admin tokens" | then="Admin tokens access all orgs"
@RULE lvl=must | when="using user tokens" | then="User tokens access own org"
@RULE lvl=must | when="making API requests" | then="API requests need Authorization header"
@RULE lvl=must | when="issuing tokens" | then="/auth/token endpoint for tokens"
@RULE lvl=must | when="using refresh tokens" | then="Refresh tokens single-use, new issued"

@SEC name="Users Endpoint"
@RULE lvl=must | when="creating user" | then="POST /users needs name, email, role"
@RULE lvl=must | when="validating email" | then="Email unique per org"
@MAP id=Roles | pairs=["admin"->"full access","member"->"default role","viewer"->"limited access"]
@RULE lvl=must | when="GET /users" | then="GET /users paginated, limit 25-100"
@RULE lvl=must | when="GET /users/:id" | then="GET /users/:id single user, 404 if not found"
@RULE lvl=must | when="PATCH /users/:id" | then="PATCH /users/:id partial update"
@RULE lvl=must | when="DELETE /users/:id" | then="DELETE /users/:id soft-delete"
@RULE lvl=must | when="user already archived" | then="Archived user 410 Gone"

@SEC name="Orders Endpoint"
@RULE lvl=must | when="creating order" | then="POST /orders needs customer_id, items, total, currency"
@RULE lvl=must | when="validating items" | then="Items need product_id, quantity, unit_price"
@RULE lvl=must | when="validating currency" | then="Currency ISO 4217, no mixed"
@RULE lvl=must | when="GET /orders" | then="GET /orders filterable"
@MAP id=Order Lifecycle | pairs=["draft"->"initial state","confirmed"->"payment authorized","processing"->"being prepared","shipped"->"in transit","delivered"->"completed"]
@RULE lvl=must | when="PATCH /orders/:id" | then="PATCH /orders/:id update in draft"
@RULE lvl=must | when="POST /orders/:id/confirm" | then="Confirm order triggers payment"
@RULE lvl=must | when="POST /orders/:id/cancel" | then="Cancel order triggers refund"
@RULE lvl=must | when="DELETE /orders/:id" | then="DELETE /orders not supported"

@SEC name="Error Codes"
@MAP id=Error Codes | pairs=["ERR_AUTH"->"invalid or expired token","ERR_NOT_FOUND"->"requested resource does not exist","ERR_VALIDATION"->"request body failed schema validation","ERR_CONFLICT"->"duplicate resource detected","ERR_RATE_LIMIT"->"too many requests","ERR_PAYMENT_FAILED"->"payment provider rejected transaction","ERR_INSUFFICIENT_FUNDS"->"account balance too low","ERR_PERMISSION_DENIED"->"token lacks required scope","ERR_RESOURCE_LOCKED"->"resource being modified by another process"]

@SEC name="Products Endpoint"
@RULE lvl=must | when="creating product" | then="POST /products needs name, description, price, category, active"
@RULE lvl=must | when="validating name" | then="Name max 255 chars"
@RULE lvl=must | when="validating description" | then="Description max 2000 chars"
@RULE lvl=must | when="validating price" | then="Price in cents"
@MAP id=Categories | pairs=["software"->"predefined","hardware"->"predefined","service"->"predefined","subscription"->"predefined","addon"->"predefined"]
@RULE lvl=must | when="GET /products" | then="GET /products filterable"
@RULE lvl=must | when="PATCH /products/:id" | then="PATCH /products/:id update any field"
@RULE lvl=must | when="deleting products with active orders" | then="Deactivate before delete"

@SEC name="Invoices Endpoint"
@RULE lvl=must | when="creating invoice" | then="POST /invoices needs customer_id, items, due_date, payment_terms"
@MAP id=Payment Terms | pairs=["net-15"->"15 days","net-30"->"30 days","net-60"->"60 days"]
@MAP id=Invoice Statuses | pairs=["draft"->"editable","open"->"not editable","paid"->"completed","void"->"canceled"]
@RULE lvl=must | when="POST /invoices/:id/pay" | then="Pay invoice, 402 on failure"
@RULE lvl=must | when="POST /invoices/:id/void" | then="Void invoice, not if paid"
@RULE lvl=must | when="GET /invoices" | then="GET /invoices filterable"
@RULE lvl=must | when="invoice overdue" | then="Overdue invoices trigger reminders"

@SEC name="Input Validation"
@RULE lvl=must | when="validating email" | then="Email RFC 5322"
@RULE lvl=must | when="validating phone" | then="Phone E.164 [1234567890]"
@RULE lvl=must | when="validating monetary amounts" | then="Monetary amounts in cents"
@RULE lvl=must | when="validating date fields" | then="Date ISO 8601 UTC [2026]"
@RULE lvl=must | when="using metadata objects" | then="Metadata 20 keys, 500 chars"
@RULE lvl=must | when="using array fields" | then="Array max 100 items"
@RULE lvl=must | when="using string fields" | then="Trim strings, empty as null"
@RULE lvl=must | when="using boolean fields" | then="Boolean true/false, 1/0, yes/no"
@RULE lvl=must | when="using enum fields" | then="Enum case-insensitive, stored lowercase"

@SEC name=Webhooks
@MAP id=Webhook Events | pairs=["order.created"->"event","order.updated"->"event","order.completed"->"event","payment.succeeded"->"event","payment.failed"->"event","invoice.paid"->"event"]
@RULE lvl=must | when="processing webhook payloads" | then="Webhook signed HMAC-SHA256"
@RULE lvl=must | when="responding to webhook" | then="Respond 200 in 30s"
@RULE lvl=must | when="webhook delivery fails" | then="Retry backoff: 1m, 5m, 25m, 2h, 10h"
@RULE lvl=must | when="all retries exhausted" | then="Notify owner after retries"
@RULE lvl=must | when="registering webhook" | then="Register webhook POST /webhooks"
@RULE lvl=must | when="GET /webhooks/:id/deliveries" | then="GET /webhooks/:id/deliveries last 30d"

@SEC name="Subscriptions API"
@RULE lvl=must | when="POST /subscriptions" | then="Create subscription"
@MAP id=Required Fields | pairs=["customer_id"->"required","plan_id"->"required","trial_days"->"0-365","payment_method_id"->"required unless trial"]
@RULE lvl=must | then="Start after trial"
@RULE lvl=must | then="Auto invoice"
@MAP id=Proration Behavior | pairs=["create_prorations"->"default","none"->"option","always_invoice"->"option"]
@RULE lvl=must | then="Status flow"
@RULE lvl=must | when="PATCH /subscriptions/:id" | then="Update subscription"
@RULE lvl=must | when="DELETE /subscriptions/:id" | then="Cancel subscription"

@SEC name="Payments API"
@RULE lvl=must | when="POST /payments" | then="Create payment"
@MAP id=Required Fields | pairs=["amount"->"integer cents","currency"->"ISO 4217","method_id"->"required","description"->"required"]
@RULE lvl=must | then="Sync processing"
@RULE lvl=must | then="Success 200"
@RULE lvl=must | then="Failure 402"
@RULE lvl=must | then="3D Secure"
@RULE lvl=must | when="POST /payments/:id/refund" | then="Create refund"

@SEC name="GDPR Compliance"
@RULE lvl=must | then="Encrypt PII [1.3]"
@RULE lvl=must | then="Erasure 30 days"
@RULE lvl=must | then="Report breaches 72h"
@RULE lvl=must | then="Annual DPIA"
@RULE lvl=must | then="Obtain consent"

@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | then="Least privilege"
@RULE lvl=must | then="Record access"
@RULE lvl=must | then="Monthly scans"
@RULE lvl=must | then="Annual pen test"
@RULE lvl=must | then="MFA required"

@SEC name="PCI-DSS Level 1 Compliance"
@RULE lvl=must | then="No card storage"
@RULE lvl=must | then="Tokenize payment data"
@RULE lvl=must | then="Monitor traffic"

@SEC name="Rate Limiting"
@RULE lvl=must | then="Global limit 1000/min"
@RULE lvl=must | then="User limit 100/min"
@RULE lvl=must | then="Burst 50/1s"

@SEC name="Inventory Module"
@NOTE text="Tracks stock levels across warehouses."
@NOTE text="Tracked as available, reserved, damaged."
@RULE lvl=must | when="POST /inventory/adjust" | then="POST /inventory/adjust for adjustments."
@RULE lvl=must | when="adjustment is zero" | then="Reject zero adjustments."
@RULE lvl=must | when="order is confirmed" | then="Reserve stock on order confirmation."
@RULE lvl=must | when="available quantity drops below reorder point" | then="Low-stock alerts below reorder point."
@NOTE text="Transfers tracked as paired adjustments."
@RULE lvl=must | when="POST /inventory/count" | then="Initiate cycle counts via POST /inventory/count."
@RULE lvl=must | when="discrepancies from cycle counts" | then="Log discrepancies, require approval."

@SEC name="Notification System"
@NOTE text="Supports email, SMS, push, in-app."
@NOTE text="Templates use Handlebars, versioned."
@NOTE text="Priority levels: critical, high, normal, low."
@CFG id=Quiet Hours | set=[set="configurable per user from 10 PM to 7 AM local time by default"]
@NOTE text="Email uses transactional provider, tracked via webhooks."
@NOTE text="SMS via gateway, international requires sender IDs."
@NOTE text="Push targets devices, multiple registered."
@NOTE text="In-app persisted, read/unread status."
@CFG id=Notification Preferences | set=[set="users can opt out of specific notification types per channel"]
@RULE lvl=must | when="bulk notifications are queued" | then="Process bulk notifications at 1000/min."

@SEC name="Analytics Module"
@NOTE text="Provides real-time, historical data."
@NOTE text="Events via SDK, API; include timestamp, user_id, session_id."
@NOTE text="Dashboards update every 5s for 15min data."
@NOTE text="Aggregation by minute, hour, day, week, month."
@RULE lvl=must | when="defining custom events" | then="Custom events: 10 properties, alphanumeric."
@NOTE text="Funnels track progression, calculate drop-off rates."
@NOTE text="Cohort analysis by first event date."
@NOTE text="Retention: 13 months detailed, unlimited aggregated."
@NOTE text="Export via GET /analytics/export in CSV, Parquet."
@NOTE text="Optimized with column-oriented storage, partitioning."

@SEC name="Reporting Module"
@NOTE text="Generates scheduled, on-demand reports."
@NOTE text="Standard reports: revenue, orders, customers, inventory, churn."
@NOTE text="Custom reports via SQL-like language."
@CFG id=Report Scheduling | set=[set="daily, weekly, or monthly with email delivery"]
@NOTE text="Formats: PDF, CSV, Excel, JSON."
@NOTE text="Dashboards aggregate reports, 12 widgets max."
@NOTE text="Drill-down supported, opens detailed view."
@NOTE text="Caching prevents redundant computation."
@RULE lvl=must | when="accessing financial reports" | then="Financial reports require finance/admin role."
@RULE lvl=must | when="report generation for large date ranges" | then="Queue large date range reports."
@RULE lvl=must | when="report is ready" | then="Notify when report ready."

@SEC name="HIPAA Compliance"
@RULE lvl=must | when="handling PHI" | then="Role-based access for PHI."
@RULE lvl=must | when="accessing PHI" | then="Log PHI access, retain 6 years."
@RULE lvl=must | when="PHI is at rest" | then="Encrypt PHI with AES-256, TLS 1.3."
@RULE lvl=must | when="breach occurs" | then="Notify breaches within 60 days."
@RULE lvl=must | when="conducting risk assessments" | then="Annual risk assessments, document plans."
@RULE lvl=must | when="workforce members access PHI" | then="Annual HIPAA training for PHI access."
@RULE lvl=must | when="third parties access PHI" | then="Sign agreements with third parties."
@RULE lvl=must | when="system outages occur" | then="Emergency access during outages."
@RULE lvl=must | when="documenting policies" | then="Document, review, update policies annually."
@NOTE text="Physical safeguards: access controls, security."
@NOTE text="Technical safeguards: user ID, logoff, audit."

@SEC name="Caching Layer"
@NOTE text="Caching layer between API and database."
@CFG id=Cache TTL | set=[set="default 300 seconds, maximum 86400 seconds"]
@NOTE text="Stale-while-revalidate strategy. [stale-while-revalidate]"
@RULE lvl=must | when="database writes occur" | then="Invalidate cache on writes via event bus."
@NOTE text="Redis 7.x in cluster mode, 3 primary, 3 replica."
@RULE lvl=must | when="caching large objects" | then="Compress large objects with LZ4. [1MB]"
@NOTE text="Cache warming during deployment."
@NOTE text="Per-tenant cache isolation."

@SEC name=Observability
@NOTE text="Three pillars: tracing, metrics, logging"
@NOTE text="Tracing: OpenTelemetry, W3C Trace Context"
@NOTE text="Metrics: Prometheus format"
@NOTE text="Logging: JSON format"
@NOTE text="Log level: info"
@NOTE text="Trace sampling: 10% prod, 100% staging"
@NOTE text="Log retention: 90d index, 1y cold"

@SEC name=Communication
@NOTE text="gRPC internal, REST external"

@SEC name="Event Sourcing"
@NOTE text="Event sourcing: order, payment domains"

@SEC name="CQRS Pattern"
@NOTE text="CQRS: separate read/write models"

@SEC name="Event Bus"
@NOTE text="Event bus: Apache Kafka, at-least-once"

@SEC name="Circuit Breaker"
@RULE lvl=must | when="external service calls" | then="Circuit breaker: mandatory, trips after 5 failures"

@SEC name="Saga Pattern"
@NOTE text="Saga: distributed transactions, compensating"

@SEC name="API Gateway"
@NOTE text="API gateway: auth, rate limit, logging, CORS"

@SEC name="Service Mesh"
@NOTE text="Service mesh: TLS, observability, traffic management"

@SEC name="Deployment Strategies"
@NOTE text="Blue-green: zero-downtime"
@NOTE text="Canary: 5% traffic"

@SEC name="Compliance Module"
@NOTE text="Compliance: regulatory management"

@SEC name="Legal Module"
@NOTE text="Legal: contracts, terms, privacy"

@SEC name="Finance Module"
@NOTE text="Finance: accounting, revenue, reporting"

@SEC name="HR Module"
@NOTE text="HR: records, time, benefits"

@SEC name="Marketing Module"
@NOTE text="Marketing: campaigns, leads, analytics"

@SEC name="Support Module"
@NOTE text="Support: tickets, knowledge, SLA"

@SEC name="Engineering Module"
@NOTE text="Manages repos, deployments, tooling"
@RULE lvl=must | then="Enforce branch naming, commit format, CI checks"
@RULE lvl=must | then="Support staging, canary, production with gates"
@RULE lvl=must | then="Control rollout, clean up after 30 days"
@RULE lvl=must | then="Require two approvals, one from owner"
@RULE lvl=must | then="Scan every commit, block critical vulnerabilities"
@NOTE text="IaC manages cloud resources"
@RULE lvl=must | then="Detect and alert manual changes"
@NOTE text="Runbook documents procedures, troubleshooting [step-by-step]"
@RULE lvl=must | then="Reviews for P1/P2 incidents within 48 hours"

@SEC name="Security Module"
@NOTE text="Manages access, threat, vulnerability"
@NOTE text="Supports SAML 2.0, OIDC, SCIM for SSO"
@RULE lvl=must | then="Define permissions with inheritance"
@RULE lvl=must | then="Enforce 24-hour session, idle timeout"
@RULE lvl=must | then="Identify anomalous access patterns"
@RULE lvl=must | then="Track findings from SAST, DAST"
@RULE lvl=must | then="Centralized vault, auto-rotate credentials"
@RULE lvl=must | then="Zero-trust, micro-segmentation, proxies"
@RULE lvl=must | then="Automated containment for attacks"

@SEC name="Operations Module"
@NOTE text="Manages infrastructure, monitoring, capacity"
@RULE lvl=must | then="Terraform with pre-approved modules"
@RULE lvl=must | then="Define utilization for service tiers"
@RULE lvl=must | then="Track spending for chargeback"
@RULE lvl=must | then="RPO 1 hour, RTO 4 hours"
@RULE lvl=must | then="Weekly chaos experiments in staging"
@RULE lvl=must | then="Project needs 90 days ahead"
@RULE lvl=must | then="Approval for changes, rollback plans"
@NOTE text="Weekly on-call rotation"

@SEC name="Partner Module"
@NOTE text="Manages integrations, listings, programs"
@RULE lvl=must | then="Read-only access to catalog, pricing"
@RULE lvl=must | then="Control access at resource level [2.0]"
@RULE lvl=must | then="Token rotation every 90 days"
@RULE lvl=must | then="Real-time updates for authorized events"
@NOTE text="Dashboard shows metrics, revenue, tickets"
@RULE lvl=must | then="Approval and review for listings"
@RULE lvl=must | then="Delist after 90 days"
@NOTE text="Support percentage, fixed, tiered models"
@NOTE text="Sandbox with realistic data sets"
@RULE lvl=must | then="99.9% availability, degraded fallback"

@SEC name="Compliance Module"
@RULE lvl=must | then="Require ISMS for compliance [27001]"
@RULE lvl=must | then="Risk assessments before changes"
@RULE lvl=must | then="Document controls in applicability statement"
@RULE lvl=must | then="Annual audits, track findings"
@RULE lvl=must | then="Quarterly reviews for ISMS"
@RULE lvl=must | then="Corrective actions within 30 days"
@RULE lvl=must | then="Maintain certifications, annual education"
@RULE lvl=must | then="Evaluate data handling before contracts"
@RULE lvl=must | then="Include detection, classification, communication"
@RULE lvl=must | then="Impact assessment before changes"
@RULE lvl=must | then="Training within 30 days, annually"
@RULE lvl=must | then="Version control documentation"
@NOTE text=point-in-time
@NOTE text=drag-and-drop
@NOTE text="95%"
@NOTE text="50%"
@NOTE text="75%"
@NOTE text="90%"
@NOTE text=RateLimit
@NOTE text="Standard Contractual Clauses"
