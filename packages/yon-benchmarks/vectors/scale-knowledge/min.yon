@DOC ver=2.0 | id=chunk-1-5 | title="API and Endpoint Rules" | domain=technical | kind=rule | profile=exec | fmt=min

@SEC name=Authentication
@RULE lvl=must | when="using Bearer token OAuth2" | then="Bearer token OAuth2, 3600s TTL, 30d refresh"
@RULE lvl=must | when="rate limited" | then="Rate limit 500/min, 429 on limit"
@RULE lvl=must | when="using admin tokens" | then="Admin tokens access all orgs"
@RULE lvl=must | when="making API requests" | then="API requests need Authorization header"
@RULE lvl=must | when="issuing tokens" | then="Tokens via /auth/token"
@RULE lvl=must | when="using refresh tokens" | then="Refresh tokens single-use"

@SEC name="Users Endpoint"
@RULE lvl=must | when="POST /users" | then="POST /users creates user"
@RULE lvl=must | when="assigning email" | then="Email unique per org"
@RULE lvl=must | when="assigning roles" | then="Roles: admin, member, viewer"
@RULE lvl=must | when="GET /users" | then="GET /users paginated"
@RULE lvl=must | when="GET /users/:id" | then="GET /users/:id single user"
@RULE lvl=must | when="PATCH /users/:id" | then="PATCH /users/:id partial update"
@RULE lvl=must | when="DELETE /users/:id" | then="DELETE /users/:id soft-delete"
@RULE lvl=must | when="user already archived" | then="Archived user 410 Gone"

@SEC name="Orders Endpoint"
@RULE lvl=must | when="POST /orders" | then="POST /orders creates order"
@RULE lvl=must | when="defining items" | then="Items need product_id, quantity, unit_price"
@RULE lvl=must | when="defining currency" | then="Currency ISO 4217"
@RULE lvl=must | when="GET /orders" | then="GET /orders filtering"
@RULE lvl=must | when="order lifecycle" | then="Order lifecycle stages"
@RULE lvl=must | when="PATCH /orders/:id" | then="PATCH /orders/:id update draft"
@RULE lvl=must | when="POST /orders/:id/confirm" | then="Confirm order, trigger payment"
@RULE lvl=must | when="POST /orders/:id/cancel" | then="Cancel order, trigger refund"
@RULE lvl=must | when="DELETE /orders/:id" | then="DELETE /orders/:id not supported"

@SEC name="Error Codes"
@RULE lvl=must | when=ERR_AUTH | then="ERR_AUTH invalid token"
@RULE lvl=must | when=ERR_NOT_FOUND | then="ERR_NOT_FOUND resource missing"
@RULE lvl=must | when=ERR_VALIDATION | then="ERR_VALIDATION schema fail"
@RULE lvl=must | when=ERR_CONFLICT | then="ERR_CONFLICT duplicate resource"
@RULE lvl=must | when=ERR_RATE_LIMIT | then="ERR_RATE_LIMIT too many requests"
@RULE lvl=must | when=ERR_PAYMENT_FAILED | then="ERR_PAYMENT_FAILED payment rejected"
@RULE lvl=must | when=ERR_INSUFFICIENT_FUNDS | then="ERR_INSUFFICIENT_FUNDS low balance"
@RULE lvl=must | when=ERR_PERMISSION_DENIED | then="ERR_PERMISSION_DENIED scope missing"
@RULE lvl=must | when=ERR_RESOURCE_LOCKED | then="ERR_RESOURCE_LOCKED resource locked"

@SEC name="Subscriptions Endpoint"
@RULE lvl=must | when="POST /subscriptions" | then="Create subscription"
@MAP id=Required Fields | pairs=["customer_id"->"required","plan_id"->"required","trial_days"->"0-365","payment_method_id"->"required unless trial"]
@RULE lvl=must | then="Start after trial"
@RULE lvl=must | then="Auto invoice"
@RULE lvl=must | then="Set billing anchor"
@MAP id=Proration Behavior | pairs=["create_prorations"->"default","none"->"option","always_invoice"->"option"]
@RULE lvl=must | then="Status flow"
@RULE lvl=must | when="PATCH /subscriptions/:id" | then="Update subscription"
@RULE lvl=must | when="DELETE /subscriptions/:id" | then="Cancel subscription"

@SEC name="Payments Endpoint"
@RULE lvl=must | when="POST /payments" | then="Create payment"
@MAP id=Required Fields | pairs=["amount"->"integer cents","currency"->"ISO 4217","method_id"->"required","description"->"required"]
@RULE lvl=must | then="Sync processing"
@RULE lvl=must | then="Success 200"
@RULE lvl=must | then="Failure 402"
@RULE lvl=must | then="3D Secure"
@RULE lvl=must | when="POST /payments/:id/refund" | then="Create refund"
@MAP id=Payment Methods | pairs=["cards"->"method","bank transfers"->"method","digital wallets"->"method"]

@SEC name="GDPR Compliance"
@RULE lvl=must | then="Encrypt PII [1.3]"
@RULE lvl=must | then="Erasure 30 days"
@RULE lvl=must | then="Maintain records"
@RULE lvl=must | then="Report breaches"
@RULE lvl=must | then="Annual DPIA"
@RULE lvl=must | then="Appoint DPO"
@RULE lvl=must | then="Obtain consent"
@RULE lvl=must | then="Portability 30 days [JSON]"
@RULE lvl=must | then="Cross-border SCC [Standard Contractual Clauses]"

@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | then="Least privilege"
@RULE lvl=must | then="Record access"
@RULE lvl=must | then="Monthly scans"
@RULE lvl=must | then="Annual pen test"
@RULE lvl=must | then="Incident response"
@RULE lvl=must | then="Test BCP"
@RULE lvl=must | then="Encrypt backups"
@RULE lvl=must | then="Require MFA"
@RULE lvl=must | then="Background checks"
@RULE lvl=must | then="Annual vendor assessment"

@SEC name="PCI-DSS Level 1 Compliance"
@RULE lvl=must | then="No card storage"
@RULE lvl=must | then="Tokenize payment"
@RULE lvl=must | then="Segment network"
@RULE lvl=must | then="Monitor IDS"
@RULE lvl=must | then="Rotate keys"
@RULE lvl=must | then="Restrict access"
@RULE lvl=must | then="Review code"
@RULE lvl=must | then="ASV scans"

@SEC name="Rate Limiting"
@MAP id=Rate Limits | pairs=["global"->"1000 requests per minute","per-user"->"100 requests per minute","burst"->"50 requests in 1-second window"]
@RULE lvl=must | then="Sliding window"
@RULE lvl=must | then="Include headers"
@RULE lvl=must | then="Retry-After header"
@RULE lvl=must | then="Higher limits"
@RULE lvl=must | then="Exclude webhooks"
@RULE lvl=must | then="Batch limits"

@SEC name="Shipping Module"
@RULE lvl=must | when="POST /shipping" | then="Create shipment"
@MAP id=Required Fields | pairs=["order_id"->"required","carrier"->"required","tracking_number"->"required","estimated_delivery"->"required"]
@MAP id=Supported Carriers | pairs=["ups"->"carrier","fedex"->"carrier","dhl"->"carrier","usps"->"carrier","custom"->"carrier"]
@RULE lvl=must | then="Custom tracking"
@MAP id=Shipment Statuses | pairs=["created"->"status","picked_up"->"status","in_transit"->"status","out_for_delivery"->"status","delivered"->"status","failed"->"status","returned"->"status"]
@RULE lvl=must | then="Webhook updates"
@RULE lvl=must | then="Calculate costs"
@RULE lvl=must | then="Cache quotes"
@RULE lvl=must | then="Customs data"
@RULE lvl=must | when="POST /shipping/:id/label" | then="Generate labels"

@SEC name="Inventory Module"
@NOTE text="Tracks stock levels across warehouses."
@NOTE text="Tracked as available, reserved, damaged."
@RULE lvl=must | when="POST /inventory/adjust" | then="POST /inventory/adjust creates adjustment."
@RULE lvl=must | then="Reject zero adjustments."
@RULE lvl=must | when="order is confirmed" | then="Reservation on order confirmation."
@RULE lvl=must | then="Reserved stock unsellable."
@RULE lvl=must | when="available quantity drops below reorder point" | then="Low-stock alerts below reorder point."
@NOTE text="Transfers tracked as paired adjustments."
@RULE lvl=must | when="POST /inventory/count" | then="Initiate cycle counts via POST /inventory/count."
@RULE lvl=must | then="Log discrepancies, require manager approval."

@SEC name="Notification System"
@NOTE text="Supports email, SMS, push, in-app."
@NOTE text="Templates use Handlebars, versioned."
@NOTE text="Priority levels: critical, high, normal, low."
@CFG id=Quiet Hours | set=[set="configurable per user from 10 PM to 7 AM local time by default"]
@NOTE text="Email uses transactional provider, tracked via webhooks."
@NOTE text="SMS via gateway, international requires sender IDs."
@NOTE text="Push targets devices, multiple registrations."
@NOTE text="In-app persisted, read/unread status."
@RULE lvl=must | then="Users can opt out per channel."
@RULE lvl=must | then="Queue bulk notifications 1000/min."

@SEC name="Analytics Module"
@NOTE text="Provides real-time, historical data."
@NOTE text="Events via SDK/API, include timestamp, user_id, session_id."
@RULE lvl=must | then="Dashboards update every 5s, 15min data."
@NOTE text="Aggregation by minute, hour, day, week, month."
@RULE lvl=must | then="Custom events: 10 properties, alphanumeric names."
@NOTE text="Funnels track progression, auto drop-off rates."
@NOTE text="Cohort analysis by first event date."
@NOTE text="Retention: 13 months detailed, unlimited aggregated."
@RULE lvl=must | when="GET /analytics/export" | then="Export via GET /analytics/export in CSV, Parquet."
@NOTE text="Optimized with column-oriented storage, date partitioning."

@SEC name="Reporting Module"
@NOTE text="Generates scheduled, on-demand reports."
@NOTE text="Standard reports: revenue, orders, customers, inventory, churn."
@RULE lvl=must | then="Define custom reports with SQL-like language."
@CFG id=Report Scheduling | set=[set="daily, weekly, or monthly with email delivery to distribution lists"]
@NOTE text="Formats: PDF, CSV, Excel, JSON."
@NOTE text="Dashboards aggregate reports, 12 widgets max."
@RULE lvl=must | then="Drill-down on standard reports."
@NOTE text="Caching prevents redundant computation."
@RULE lvl=must | then="Access control by role, finance/admin for financial reports."
@RULE lvl=must | when="large date ranges" | then="Queue large date range reports."
@RULE lvl=must | then="Notify when report ready."

@SEC name="HIPAA Compliance"
@RULE lvl=must | then="Mandatory HIPAA compliance for PHI."
@RULE lvl=must | then="Role-based access to PHI."
@RULE lvl=must | then="Log PHI access, retain 6 years."
@RULE lvl=must | then="Encrypt PHI: AES-256 rest, TLS 1.3 transit."
@RULE lvl=must | then="Notify breaches within 60 days."
@RULE lvl=must | then="Annual risk assessments, remediation plans."
@RULE lvl=must | then="Annual HIPAA training for PHI access."
@RULE lvl=must | then="Sign agreements with third parties for PHI."
@RULE lvl=must | then="Emergency access to PHI during outages."
@RULE lvl=must | then="Document, review, update policies annually."
@NOTE text="Physical safeguards: access controls, security."
@NOTE text="Technical safeguards: user ID, logoff, audit."

@SEC name="Caching Layer"
@NOTE text="Between API and database for frequent access."
@CFG id=Cache TTL | set=[set="Default 300 seconds (5 minutes), Maximum 86400 seconds (24 hours)"]
@NOTE text="Strategy: stale-while-revalidate."
@RULE lvl=must | then="Event-driven cache invalidation."
@NOTE text="Redis 7.x cluster mode, 3 primary, 3 replica."
@RULE lvl=must | then="Cache key pattern: {service}:{resource}:{id}:{version}."
@NOTE text="Target 95% hit rate for read-heavy."
@RULE lvl=must | when="Large objects >1MB" | then="Compress >1MB with LZ4."
@RULE lvl=must | then="Cache warming during deployment."
@RULE lvl=must | then="Per-tenant cache isolation."

@SEC name=Observability
@NOTE text="Three pillars: tracing, metrics, logging"
@NOTE text="Tracing with OpenTelemetry, W3C Trace Context"
@NOTE text="Metrics in Prometheus format"
@NOTE text="Logging in JSON format"
@NOTE text="Default log level: info"
@NOTE text="Trace sampling: 10% prod, 100% staging"
@NOTE text="Log retention: 90d search, 1y cold"
@NOTE text="Alerts via Terraform"
@NOTE text="Dashboards use RED method"
@NOTE text="SLO tracks error budget"

@SEC name=Communication
@NOTE text="gRPC internal, REST external"

@SEC name="Event Sourcing and CQRS"
@NOTE text="Event sourcing for audit history"
@NOTE text="CQRS separates read/write"

@SEC name="Service Architecture"
@NOTE text="Service owns database, API boundaries"
@NOTE text="Kafka with at-least-once delivery [Apache Kafka]"
@RULE lvl=must | when="external service calls" | then="Circuit breaker for external calls"
@NOTE text="Saga for distributed transactions"

@SEC name="API Gateway and Service Mesh"
@NOTE text="API gateway handles cross-cutting"
@NOTE text="Service mesh for TLS, observability"

@SEC name="Deployment Strategies"
@NOTE text="Blue-green for zero-downtime"
@NOTE text="Canary routes 5% traffic"

@SEC name="Compliance Module"
@NOTE text="Compliance manages regulations"
@NOTE text="Records immutable post-approval"
@NOTE text="Role-based access for compliance"
@NOTE text="Reports daily, 7-year retention"
@NOTE text="Backup every 6h, point-in-time recovery"
@NOTE text="Automated checks on deployment"
@NOTE text="Regulatory updates via RSS, monthly review"

@SEC name="Legal Module"
@NOTE text="Legal manages contracts, terms, policies"
@NOTE text="Review workflow: draft to archived"
@NOTE text="Version control with diff"
@NOTE text="eIDAS digital signatures"
@NOTE text="Redlining, commenting for collaboration"
@NOTE text="Retention: 7 years post-expiry"
@NOTE text="Template library for clauses"
@NOTE text="Conflict resolution references clauses"
@NOTE text="Legal holds prevent deletion"

@SEC name="Finance Module"
@NOTE text="Finance manages accounting, revenue, reporting"
@NOTE text="Double-entry bookkeeping"
@NOTE text="Revenue recognition ASC 606"
@NOTE text="Configurable chart of accounts"
@NOTE text="Bank reconciliation via OFX/CSV"
@NOTE text="Multi-currency with ECB rates"
@NOTE text="Tax calculation with external engines"
@NOTE text="Financial closing with validation"
@NOTE text="Audit trail for journal entries"

@SEC name="HR Module"
@NOTE text="HR manages records, time, benefits"
@NOTE text="Employee records: personal, history, compensation"
@NOTE text="Time tracking: clock-in/out, timesheets"
@NOTE text="PTO tracks vacation, sick, personal"
@NOTE text="Benefits enrollment annually"
@NOTE text="Quarterly performance reviews"
@NOTE text="Onboarding checklists auto-generated"
@NOTE text="Offboarding: access, equipment, knowledge"
@NOTE text="Org chart shows hierarchy"

@SEC name="Marketing Module"
@NOTE text="Marketing manages campaigns, leads, analytics"
@NOTE text="Campaigns: email, social, paid"
@NOTE text="Lead scoring: engagement, demographics"
@NOTE text="Lead routing by territory, capacity"
@NOTE text="A/B testing: subject, content, send"
@NOTE text="Attribution: first, last, linear, data-driven"
@NOTE text="Automation triggers by behavior, time"
@NOTE text="UTM tracks source, medium, content"
@NOTE text="Landing pages with drag-and-drop"

@SEC name="Support Module"
@NOTE text="Support manages tickets, knowledge, SLA"
@NOTE text="Tickets via email, form, chat, API"
@NOTE text="SLA: P1 1h/4h, P2 4h/24h, P3 24h/72h, P4 48h/1w"
@NOTE text="Escalation at 75%, 90%"
@NOTE text="Knowledge base: categories, tags, history"
@NOTE text="Canned responses for common questions"
@NOTE text="Surveys post-closure, 1-5 scale"
@NOTE text="Merging preserves communications"
@NOTE text="Macro automation for routine tickets"

@SEC name="Engineering Module"
@NOTE text="Manages repositories, deployments, tooling"
@RULE lvl=must | then="Enforce branch naming, commit format, CI checks"
@RULE lvl=must | then="Support staging, canary, production with gates"
@RULE lvl=must | then="Control rollout percentages, cleanup 30d"
@RULE lvl=must | then="Require two approvals, one code owner"
@RULE lvl=must | then="Run on commit, block critical vulnerabilities"
@RULE lvl=must | then="Manage cloud resources, alert manual changes"
@NOTE text="Documents procedures, step-by-step troubleshooting"
@RULE lvl=must | then="Mandatory reviews for P1/P2 within 48h"

@SEC name="Security Module"
@NOTE text="Manages access control, threat detection, vulnerability management"
@RULE lvl=must | then="Support SAML 2.0, OIDC, SCIM for SSO"
@RULE lvl=must | then="Define permissions with inheritance"
@RULE lvl=must | then="Max session 24h, idle timeout configurable"
@RULE lvl=must | then="Identify anomalous access patterns"
@RULE lvl=must | then="Track findings from SAST, DAST, scanning"
@RULE lvl=must | then="Centralized vault, auto-rotate credentials"
@RULE lvl=must | then="Zero-trust, micro-segmentation, proxies"
@RULE lvl=must | then="Automated containment for attack patterns"

@SEC name="Operations Module"
@NOTE text="Manages infrastructure, monitoring, capacity planning"
@RULE lvl=must | then="Terraform with pre-approved modules"
@RULE lvl=must | then="Define utilization for service tiers"
@RULE lvl=must | then="Track spending for chargeback reporting"
@RULE lvl=must | then="RPO 1h, RTO 4h for production"
@RULE lvl=must | then="Weekly chaos experiments in staging"
@RULE lvl=must | then="Project needs 90d ahead, growth trends"
@RULE lvl=must | then="Approval for changes, rollback plans"
@NOTE text="Weekly on-call rotation, responders"

@SEC name="Partner Module"
@NOTE text="Manages integrations, listings, programs"
@RULE lvl=must | then="Read-only access to catalog, pricing"
@RULE lvl=must | then="Control access, token rotation 90d [2.0]"
@RULE lvl=must | then="Real-time updates for authorized events"
@NOTE text="Dashboard shows metrics, revenue, tickets"
@RULE lvl=must | then="Approval, review, delist 90d"
@RULE lvl=must | then="Support percentage, fixed, tiered commissions"
@NOTE text="Sandbox with realistic data sets"
@RULE lvl=must | then="99.9% API availability, fallback"

@SEC name="ISO 27001 Compliance"
@RULE lvl=must | then="Conduct risk assessments before change"
@RULE lvl=must | then="Document controls proportional to risks"
@RULE lvl=must | then="Annual audits, track findings"
@RULE lvl=must | then="Quarterly reviews, evaluate ISMS"
@RULE lvl=must | then="Implement corrective actions 30d, verify"
@RULE lvl=must | then="Maintain certifications, education annually"
@RULE lvl=must | then="Evaluate supplier assessments before signing"
@RULE lvl=must | then="Include detection, classification, communication"
@RULE lvl=must | then="Impact assessment, approval for changes"
@RULE lvl=must | then="Training 30d of hire, annually"
@RULE lvl=must | then="Version control documentation, ownership"
@NOTE text=HMAC-SHA256
@NOTE text=order.created
@NOTE text=order.updated
@NOTE text=order.completed
@NOTE text=payment.succeeded
@NOTE text=payment.failed
@NOTE text=invoice.paid
@NOTE text=2000
@NOTE text=5322
