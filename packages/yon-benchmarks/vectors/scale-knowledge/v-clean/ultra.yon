@DOC ver=2.0 | id=chunk-1-5 | title="API and Compliance Rules" | domain=technical | kind=rule | profile=exec | fmt=ultra
@SEC name="Authentication and Rate Limiting"
@RULE lvl=must | when="Bearer token OAuth2" | then="OAuth2 token TTL: 3600s"
@RULE lvl=must | when="Rate limit exceeded" | then="Rate limit 500/min, 429 on exceed"
@RULE lvl=must | when="Authorization header missing" | then="Require Authorization header"
@SEC name="Users API"
@RULE lvl=must | when="POST /users" | then="Create user with name, email, role"
@RULE lvl=must | when="GET /users" | then="Paginated list, limit 25-100"
@RULE lvl=must | when="PATCH /users/:id" | then="Partial update, email verification"
@SEC name="Orders API"
@RULE lvl=must | when="POST /orders" | then="Create order with customer_id, items, total, currency"
@RULE lvl=must | when="Currency in order" | then="Currency ISO 4217, no mix"
@RULE lvl=must | when="POST /orders/:id/confirm" | then="Confirm draft, trigger payment"
@SEC name="Products API"
@RULE lvl=must | when="POST /products" | then="Create product with name, description, price, category, active [200] [2000]"
@RULE lvl=must | when="DELETE /products" | then="Delete blocked if active orders"
@SEC name="Invoices API"
@RULE lvl=must | when="POST /invoices" | then="Create invoice with customer_id, items, due_date, payment_terms"
@RULE lvl=must | when="POST /invoices/:id/pay" | then="Charge default method, 402 on fail"
@SEC name="Global Validation Rules"
@RULE lvl=must | when="Email validation" | then="Email RFC 5322"
@RULE lvl=must | when="Phone validation" | then="Phone E.164 [1234567890]"
@SEC name=Webhooks
@RULE lvl=must | when="Webhook delivery" | then="Respond 200 in 30s, retry on fail"
@SEC name="Subscriptions API"
@RULE lvl=must | when="POST /subscriptions" | then="Create subscription with customer_id, plan_id, trial_days, payment_method_id"
@SEC name="Payments API"
@RULE lvl=must | when="POST /payments" | then="Create payment with amount, currency, method_id, description [4217]"
@SEC name="GDPR Compliance"
@RULE lvl=must | when="PII at rest" | then="Encrypt PII with AES-256"
@RULE lvl=must | when="Data breach" | then="Report breach in 72h"
@SEC name="SOC 2 Type II Compliance"
@RULE lvl=must | when="Access controls" | then="Least privilege access"
@RULE lvl=must | when="Audit logs" | then="Audit logs record access events"
@RULE lvl=must | when="Vulnerability scans" | then="Monthly vulnerability scans"
@RULE lvl=must | when="Critical findings" | then="Remediate critical findings in 48h"
@RULE lvl=must | when="Penetration testing" | then="Annual penetration testing"
@RULE lvl=must | when="Incident response procedures" | then="Incident response phases"
@RULE lvl=must | when="Business continuity plans" | then="Test continuity plans semi-annually"
@RULE lvl=must | when="Recovery time objective" | then="RTO 4h for Tier 1"
@RULE lvl=must | when=Backups | then="Encrypt backups, test quarterly"
@RULE lvl=must | when="Multi-factor authentication" | then="MFA for admin access"
@RULE lvl=must | when="SMS-based MFA" | then="Deprecate SMS MFA"
@RULE lvl=must | when="Employee background checks" | then="Background checks before access"
@RULE lvl=must | when="Vendor security assessments" | then="Annual vendor security assessments"
@SEC name="PCI-DSS Level 1 Compliance"
@RULE lvl=must | when="Full card numbers" | then="Do not store full card numbers"
@RULE lvl=must | when="Payment data" | then="Tokenize payment data"
@RULE lvl=must | when="Payment processing network" | then="Segment payment network"
@RULE lvl=must | when="Intrusion detection systems" | then="Monitor payment traffic real-time"
@RULE lvl=must | when="Encryption keys" | then="Rotate keys annually"
@RULE lvl=must | when="Physical access to servers" | then="Restrict server access"
@RULE lvl=must | when="Payment processing code" | then="Security review for payment code"
@RULE lvl=must | when="Quarterly ASV scans" | then="Quarterly ASV scans"
@SEC name="Rate Limiting"
@RULE lvl=must | when="Global rate limit" | then="Global limit 1000/min"
@RULE lvl=must | when="Per-user rate limit" | then="User limit 100/min"
@RULE lvl=must | when="Burst limit" | then="Burst limit 50/1s"
@RULE lvl=must | when="Throttle strategy" | then="Sliding window throttle"
@RULE lvl=must | when="Rate limit headers" | then="Include rate limit headers [RateLimit]"
@RULE lvl=must | when="Rate limited" | then="Retry-After specifies wait"
@RULE lvl=must | when="Authenticated requests" | then="Higher limits for authenticated"
@RULE lvl=must | when="Webhook deliveries" | then="Webhooks not rate limited"
@RULE lvl=must | when="Batch endpoints" | then="Batch limits per item"
@SEC name="Shipping Module"
@RULE lvl=must | when="POST /shipping" | then="Create shipment via POST"
@RULE lvl=must | when="Required fields" | then="Required: order_id, carrier, tracking_number, estimated_delivery"
@RULE lvl=must | when="Supported carriers" | then="Carriers: ups, fedex, dhl, usps, custom"
@RULE lvl=must | when="Custom carriers" | then="Custom carriers need URL template"
@RULE lvl=must | when="Shipment statuses" | then="Statuses: created, picked_up, in_transit, out_for_delivery, delivered, failed, returned"
@RULE lvl=must | when="Status updates" | then="Status updates via webhooks"
@RULE lvl=must | when="Shipping costs" | then="Calculate costs: weight, dimensions, origin, destination"
@RULE lvl=must | when=Quotes | then="Cache quotes 15min"
@RULE lvl=must | when="International shipments" | then="Customs data for international"
@RULE lvl=must | when="Shipping labels" | then="Generate labels via POST"
@SEC name="Inventory Module"
@RULE lvl=must | when="Stock levels" | then="Track stock: available, reserved, damaged"
@RULE lvl=must | when="POST /inventory/adjust" | then="Adjust inventory via POST"
@RULE lvl=must | when=Adjustments | then="Adjustments: positive or negative"
@RULE lvl=must | when="Zero adjustments" | then="Reject zero adjustments"
@RULE lvl=must | when=Reservation | then="Reserve on order confirmation"
@RULE lvl=must | when="Reserved stock" | then="Reserved stock not for sale"
@RULE lvl=must | when="Low-stock alerts" | then="Low-stock alerts below reorder point"
@RULE lvl=must | when="Inventory transfers" | then="Track transfers with ID"
@RULE lvl=must | when="Cycle counts" | then="Initiate cycle counts via POST"
@RULE lvl=must | when="Discrepancies from cycle counts" | then="Log discrepancies, manager approval"
@SEC name="Notification System"
@RULE lvl=must | when="Notification templates" | then="Templates use Handlebars"
@RULE lvl=must | when=Templates | then="Versioned templates"
@RULE lvl=must | when="Notification priority" | then="Critical notifications bypass quiet hours"
@RULE lvl=must | when="Quiet hours" | then="Configurable quiet hours"
@RULE lvl=must | when="Email notifications" | then="Email via transactional provider"
@RULE lvl=must | when="SMS notifications" | then="SMS via gateway, country-specific IDs"
@RULE lvl=must | when="Push notifications" | then="Push to specific devices"
@RULE lvl=must | when="In-app notifications" | then="In-app notifications persisted"
@RULE lvl=must | when="Notification preferences" | then="Opt-out preferences per channel"
@RULE lvl=must | when="Bulk notifications" | then="Bulk notifications 1000/min"
@SEC name="Analytics Module"
@RULE lvl=must | when=Events | then="Collect events via SDK/API"
@RULE lvl=must | when=Events | then="Events include timestamp, user_id, session_id"
@RULE lvl=must | when="Real-time dashboards" | then="Dashboards update every 5s"
@RULE lvl=must | when="Historical queries" | then="Aggregate by minute, hour, day, week, month"
@RULE lvl=must | when="Custom events" | then="Custom events with 10 properties"
@RULE lvl=must | when="Property names" | then="Alphanumeric property names"
@RULE lvl=must | when=Funnels | then="Track progression with funnels"
@RULE lvl=must | when="Drop-off rates" | then="Automatic drop-off rates"
@RULE lvl=must | when="Cohort analysis" | then="Cohort analysis tracks retention"
@RULE lvl=must | when="Data retention" | then="13 months retention for events"
@RULE lvl=must | when="Analytics data" | then="Export analytics data via GET"
@RULE lvl=must | when="Query performance" | then="Optimize queries with column storage"
@SEC name="Reporting Module"
@RULE lvl=must | when="Access control limits report visibility by role" | then="Access control by role"
@SEC name="HIPAA Compliance"
@RULE lvl=must | when="Handling PHI" | then="HIPAA compliance for PHI"
@RULE lvl=must | when="Accessing PHI" | then="Role-based access to PHI"
@RULE lvl=must | when="Accessing PHI" | then="Log PHI access for 6 years"
@RULE lvl=must | when="PHI at rest" | then="Encrypt PHI with AES-256 [1.3]"
@RULE lvl=must | when="Breach occurs" | then="Notify breaches in 60 days"
@RULE lvl=must | when=Annually | then="Annual risk assessments"
@RULE lvl=must | when="PHI access" | then="Annual HIPAA training"
@RULE lvl=must | when="Third parties access PHI" | then="Sign agreements with third parties"
@RULE lvl=must | when="System outages" | then="Emergency access to PHI"
@RULE lvl=must | when=Annually | then="Review policies annually"
@RULE lvl=must | when="Physical safeguards" | then="Facility access controls"
@RULE lvl=must | when="Technical safeguards" | then="Technical safeguards"
@SEC name="Service Communication"
@RULE lvl=must | when="External service calls" | then="Circuit breaker for external calls"
@SEC name="Compliance Module"
@RULE lvl=must | when="Compliance records approved" | then="Immutable compliance records"
@RULE lvl=must | when="Accessing compliance data" | then="Role-based access to compliance data"
@RULE lvl=must | when="Compliance data" | then="Backup compliance data every 6 hours [point-in-time]"
@RULE lvl=must | when=Deployment | then="Automated compliance checks on deployment"
@SEC name="ISO 27001 Compliance"
@RULE lvl=must | when="before any system change" | then="Conduct risk assessments before changes"
@RULE lvl=must | then="Document proportional security controls"
@RULE lvl=must | when=annually | then="Annual internal audits"
@RULE lvl=must | when=quarterly | then="Quarterly management reviews"
@RULE lvl=must | when="within 30 days" | then="Corrective actions within 30 days"
@RULE lvl=must | then="Maintain certifications annually"
@RULE lvl=must | when="before contract signing" | then="Supplier assessments before signing"
@RULE lvl=must | then="Incident management procedures"
@RULE lvl=must | then="Impact assessment before changes"
@RULE lvl=must | when="within 30 days of hire and annually" | then="Training within 30 days of hire"
@RULE lvl=must | then="Version control documentation"
@MAP id=ErrorCodes | pairs=["ERR_AUTH"->"invalid/expired token","ERR_NOT_FOUND"->"resource doesn't exist","ERR_VALIDATION"->"request body failed schema validation","ERR_CONFLICT"->"duplicate resource","ERR_RATE_LIMIT"->"too many requests","ERR_PAYMENT_FAILED"->"payment provider rejected","ERR_INSUFFICIENT_FUNDS"->"account balance too low","ERR_PERMISSION_DENIED"->"token lacks required scope","ERR_RESOURCE_LOCKED"->"concurrent modification in progress"]
@MAP id=ReportingModule | pairs=["reporting"->"Generates scheduled/on-demand reports","Revenue"->"Standard report","Orders"->"Standard report","Customers"->"Standard report","Inventory"->"Standard report","Churn metrics"->"Standard report","custom_reports"->"Custom reports via SQL-like queries","Daily"->"Schedule option","Weekly"->"Schedule option","Monthly"->"Schedule option","PDF"->"Format","CSV"->"Format","Excel"->"Format","JSON"->"Format","dashboards"->"Dashboards: 12 widgets max","drill_down"->"Drill-down on standard reports","report_caching"->"Report caching with TTL","async_processing"->"Async processing for large date ranges","report_notification"->"Notification on report readiness"]
@MAP id=CachingLayer | pairs=["caching_layer"->"Caching between API and database","Default"->"300 seconds (5 minutes)","Maximum"->"86400 seconds (24 hours)","cache_strategy"->"Stale-while-revalidate strategy [stale-while-revalidate]","cache_invalidation"->"Event-driven cache invalidation","cache_backend"->"Redis 7.x cluster mode","cache_keys"->"Cache key pattern","cache_hit_rate"->"95% cache hit target","large_object_compression"->"Compress >1MB with LZ4","cache_warming"->"Cache warming during deployment","cache_isolation"->"Per-tenant cache isolation"]
@MAP id=Observability | pairs=["observability"->"Observability: tracing, metrics, logging","distributed_tracing"->"OpenTelemetry for tracing","metrics"->"Prometheus metrics","logging"->"Structured JSON logging","log_level"->"Log level: info, debug enabled","trace_sampling"->"Trace sampling: 10% prod, 100% staging","log_retention"->"Log retention: 90d index, 1y cold","alerts"->"Alerts via Terraform","dashboards_red"->"RED method dashboards","slo_tracking"->"SLO tracking: 50% budget burn"]
@MAP id=ServiceCommunication | pairs=["service_communication"->"gRPC internal, REST external","event_sourcing"->"Event sourcing for audit history","cqrs_pattern"->"CQRS for read/write separation","service_database"->"Service owns database","event_bus"->"Kafka event bus, idempotent consumers [at-least-once] [Apache Kafka]","saga_pattern"->"Saga for distributed transactions","api_gateway"->"API gateway for cross-cutting concerns","service_mesh"->"Service mesh for TLS and observability","deployments"->"Blue-green and canary deployments [5%]"]
@MAP id=ComplianceModule | pairs=["compliance_reports"->"Daily compliance reports, 7-year retention","compliance_cross_references"->"Stable identifiers for cross-references","regulatory_updates"->"Monthly review of regulatory updates"]
