@DOC ver=2.0 | id=api-rules | title="API Rules and Endpoints" | kind=rule | profile=exec | fmt=min

@SEC name=Authentication
@NOTE text="Bearer token OAuth2, 3600s TTL, 30d refresh"
@RULE lvl=must | when="rate limited" | then="Return 429 on rate limit"
@RULE lvl=must | when="API request" | then="Authorization header required"
@NOTE text="/auth/token issues tokens"
@NOTE text="Refresh tokens single-use"

@SEC name="Rate Limiting"
@NOTE text="500 req/min globally"

@SEC name="Token Access"
@NOTE text="Admin tokens: all orgs, User tokens: own org"

@SEC name="User Management"
@NOTE text="POST /users creates user"
@RULE lvl=must | when="creating user" | then="Email unique per org"
@MAP id=Roles | pairs=["admin"->"full access","member"->"default role","viewer"->"read-only"]
@NOTE text="GET /users paginated"
@NOTE text="GET /users/:id returns user"
@RULE lvl=must | when="PATCH /users/:id" | then="PATCH /users/:id, email verification required"
@NOTE text="DELETE /users/:id soft-delete"
@RULE lvl=must | when="user is already archived" | then="Return 410 if archived"
