@DOC ver=2.0 | id=rules-depth-5 | title="Architecture Standards" | kind=rule | mode=text | profile=decl | fmt=min

@SEC name="Global"
@RULE lvl=MUST | when="calling external APIs" | then="use async patterns with circuit breakers"
@RULE lvl=MUST_NOT | when="any service" | then="make synchronous external HTTP calls"

@SEC name="Domain: Financial"
@RULE lvl=MUST | when="processing payments" | then="validate all inputs before external calls"
@NOTE text="Financial domain has stricter retry policies — max 2 retries, 500ms timeout."

@SEC name="Service: Payments"
@RULE lvl=MUST | when="calling payment processors" | then="log full request/response for audit trail"
@RULE lvl=MUST | when="external API failure" | then="queue for retry, never block checkout"

@SEC name="Version: Payments-v2"
@NOTE text="v2 migrates from batch to real-time credit checks."
@RULE lvl=MUST | when="credit check in payments-v2" | then="use streaming pipeline with 200ms SLA"

@SEC name="Exception: Checkout Flow"
@RULE rid="payments-v2-sync-exception" | lvl=MUST | when="credit-check during checkout in payments-v2" | then="use synchronous call with 150ms hard timeout — async pipeline adds 800ms latency unacceptable for checkout UX"
@NOTE text="Approved exception: sync call acceptable ONLY during checkout, with mandatory circuit breaker and fallback to cached score."
