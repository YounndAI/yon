@DOC ver=2.0 | id=portfolio-landing-page | title="Portfolio Landing Page for Mara Chen" | profile=decl | fmt=canon

@SEC name="Hero Section"
@NOTE text="Hero section with Mara Chen's name big and bold, tagline 'Design that speaks before words do', warm off-white background with subtle grain texture."
@RULE lvl=must | then="CTA should say 'View My Work' and scroll to projects section."

@SEC name="Projects Section"
@MAP id=case-studies name="Featured Case Studies" | pairs=["Lumina Skincare"->"Rebrand: identity, packaging, website","BrewHaus"->"Craft brewery taproom redesign","Neon Athletics"->"Fitness app UI/UX, tagline 'movement redefined'","Olive & Stone"->"Boutique hotel brand identity","Wavelength Records"->"Indie record label visual system"]
@NOTE text="Each project card shows hero image, project name, category, and short blurb (2 sentences max)."

@SEC name="About Section"
@NOTE text="Mara Chen has 7 years of design experience, based in Portland OR, clients in hospitality, beauty, tech, music, studied at RISD, also does illustration."

@SEC name="Testimonials Section"
@NOTE text="Testimonial from Lumina Skincare founder about rebrand increasing online sales by 40%."
@NOTE text="Testimonial from BrewHaus owner about new look attracting younger crowd."
@NOTE text="Testimonial from agency director about Mara being reliable and creative."

@SEC name=Footer
@NOTE text="Footer with links to Instagram, Dribbble, LinkedIn, email contact form, copyright 2026."

@SEC name="Color Palette"
@MAP id=color-palette name="Color Palette" | pairs=["Primary"->"off-white #F5F0EB","Accent"->"coral #E8654A","Dark Text"->"#2D2926","Secondary"->"sage green #A8B5A0"]

@SEC name="Mobile Layout"
@RULE lvl=must | then="Mobile layout must stack properly, project grid from 2 columns to single column on phones."
@RULE lvl=must | then="Navbar should collapse into a hamburger menu on mobile."
