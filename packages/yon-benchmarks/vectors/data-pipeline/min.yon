@DOC ver=2.0 | id=analytics-pipeline | title="Analytics Data Pipeline" | kind=rule | fmt=min
@INTENT goal="3-source ETL into BigQuery analytics warehouse"
@SEC name=Sources
@MAP id=kafka | topic="user-events" | volume="2M/day" | format=JSON | fields="user_id, event_type, timestamp, properties, session_id, device_info"
@MAP id=s3 | bucket="partner-data-drops" | format=CSV | freq="daily 03:00 UTC" | size="500MB–2GB" | fields="partner_id, transaction_id, amount, currency, status, created_at, metadata_json"
@MAP id=cdc | db="legacy-crm" | tables="customers, orders" | volume="50k/day"
@SEC name=Processing
@RULE lvl=MUST | then="dedup on (user_id + event_type + timestamp)"
@RULE lvl=MUST | then="enrich events with CRM data (user_id = customer.external_id)"
@RULE lvl=MUST | then="normalize timestamps to UTC"
@RULE lvl=MUST | then="validate currency ISO 4217"
@RULE lvl=MUST | then="PII: SHA-256 hash email + phone"
@RULE lvl=MUST | then="bad records → DLQ, never block"
@SEC name=Destination
@MAP id=bq | dataset="analytics_prod" | partition="date" | cluster="event_type, user_id"
@MAP id=retention | raw="2 years" | aggregated="indefinite"
@SEC name=SLAs
@MAP id=latency | kafka="≤15min" | s3="≤2h" | cdc="≤30min" | uptime="99.9%"
@RULE lvl=MUST | when="lag > 2× SLA" | then="page on-call"
@SEC name=Stack
@MAP id=stack | stream=Flink | transforms=dbt | orchestration=Airflow
