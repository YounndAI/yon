@DOC ver=2.0 | id=invoiceflow-deploy | title="InvoiceFlow Deployment Configuration" | kind=config | profile=exec | fmt=canon

@SEC name="Environments"
@MAP id=env-dev | env=dev | url="dev.invoiceflow.internal" | db=invoiceflow_dev | flags_source="local config"
@MAP id=env-staging | env=staging | url="staging.invoiceflow.internal" | db=invoiceflow_staging | flags_source="remote config service"
@MAP id=env-prod | env=prod | url="api.invoiceflow.com" | db=invoiceflow_prod | flags_source="remote config service"

@SEC name="Deployment Rules"
@RULE lvl=MUST | when="deploying to dev" | then="any authenticated user. Auto-deploys on merge to develop branch."
@RULE lvl=MUST | when="deploying to staging" | then="require manager or admin role. Deploy from release/* branches."
@RULE lvl=MUST | when="deploying to prod" | then="require admin role only. Deploy from main branch. Require 1 admin approval."
@NOTE text="Prod rollback available for 72 hours after deploy."

@SEC name="Feature Flags"
@MAP id=flag-payment-flow | flag=new_payment_flow | dev=on | staging=on | prod=off | desc="Enables v2 payment processing with multi-currency. When off, POST /payments only accepts USD."
@MAP id=flag-email | flag=email_notifications | dev=off | staging=on | prod=on | desc="Controls whether POST /invoices/:id/send triggers email. When off, status changes but no email."
@MAP id=flag-audit-enrich | flag=audit_log_enrichment | dev=on | staging=on | prod=on | desc="Adds extra metadata to audit_log entries (client IP, user agent)."
@MAP id=flag-strict-val | flag=strict_validation | dev=on | staging=on | prod=on | desc="Enforces all validation. When off, only required fields validated (testing only)."

@SEC name="Rollback"
@RULE lvl=MUST | when="rolling back prod" | then="require admin role. Auto-disable feature flags enabled in rolled-back version."
@CFG key=rollback_window | val="72 hours"
