@DOC ver=2.0 | id=invoiceflow-monitoring | title="InvoiceFlow Monitoring & Alerts" | kind=config | profile=exec | fmt=min
@SEC name="SLOs"
@MAP id=s1 | ep="POST /invoices" | avail="99.9%" | p99="500ms" | err="<1%"
@MAP id=s2 | ep="GET /invoices" | avail="99.95%" | p99="200ms" | err="<0.5%"
@MAP id=s3 | ep="GET /invoices/:id" | avail="99.95%" | p99="200ms" | err="<0.5%"
@MAP id=s4 | ep="PUT /invoices/:id" | avail="99.9%" | p99="500ms" | err="<1%"
@MAP id=s5 | ep="POST /invoices/:id/send" | avail="99.5%" | p99="2000ms" | err="<2%"
@MAP id=s6 | ep="POST /payments" | avail="99.99%" | p99="300ms" | err="<0.1%"
@MAP id=s7 | ep="GET /payments" | avail="99.95%" | p99="200ms" | err="<0.5%"
@MAP id=s8 | ep="GET /health" | avail="99.99%" | p99="50ms" | err="0%"
@SEC name="Alerts"
@MAP id=a1 | metric="err rate any" | warn=">2%/5m" | crit=">5%/5m" | ch="Slack #alerts"
@MAP id=a2 | metric="p99 any" | warn=">2x SLO" | crit=">5x SLO" | ch="Slack+PagerDuty"
@MAP id=a3 | metric="/payments err" | warn=">0.1%/1m" | crit=">0.5%/1m" | ch="PagerDuty now"
@MAP id=a4 | metric="DB pool" | warn=">80%" | crit=">95%" | ch="Slack #infra"
@MAP id=a5 | metric="Disk" | warn=">80%" | crit=">95%" | ch="Slack+PagerDuty"
@SEC name="Severity"
@MAP id=p1 | sev=P1 | def="Payments down/data loss" | resp="15m" | paged="owning lead+platform lead"
@MAP id=p2 | sev=P2 | def="Core degraded" | resp="1h" | paged="owning lead"
@MAP id=p3 | sev=P3 | def="Non-critical degraded" | resp="4h" | paged="team Slack"
@MAP id=p4 | sev=P4 | def="Cosmetic" | resp="next day" | paged="auto ticket"
