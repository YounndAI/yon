@DOC ver=2.0 | id=invoiceflow-validation | title="InvoiceFlow Validation Rules" | kind=rule | profile=decl | fmt=min
@SEC name="Invoice Fields"
@RULE lvl=MUST | when="create" | then="customer_id=UUID, line_items≥1, each: desc(str≤200), qty(int≥1), unit_price(dec≥0.01)"
@RULE lvl=MUST | when="currency" | then="ISO 4217, 3 uppercase, default USD"
@RULE lvl=MUST | when="total" | then="auto-calc sum(qty×price), >0, read-only"
@RULE lvl=MUST | when="due_date" | then="future date, required before send"
@RULE lvl=MUST | when="payment_method" | then="admin only. Allowed: bank_transfer,credit_card,wire,check"
@SEC name="Invoice Business"
@RULE lvl=MUST_NOT | when="status=sent|paid|overdue" | then="allow updates"
@RULE lvl=MUST_NOT | when="no due_date" | then="allow send"
@RULE lvl=MUST_NOT | when="total≤0" | then="allow creation"
@SEC name="Payment Fields"
@RULE lvl=MUST | when="payment" | then="invoice status=sent|overdue; amount>0 ≤remaining; method required; reference unique/invoice"
@RULE lvl=MUST_NOT | when="invoice=draft|paid" | then="accept payment"
@SEC name="Payment Business"
@RULE lvl=MUST | when="sum(payments)=total" | then="auto-transition→paid"
@NOTE text="Partial OK, no status change. Overpayment rejected."
