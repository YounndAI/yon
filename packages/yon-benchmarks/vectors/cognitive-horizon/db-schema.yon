@DOC ver=2.0 | id=invoiceflow-schema | title="InvoiceFlow Database Schema" | kind=data | profile=decl | fmt=canon

@SEC name="users"
@NOTE text="Stores all platform users."
@MAP id=col-user-id | column=id | type=UUID | constraints="PRIMARY KEY" | notes="Auto-generated"
@MAP id=col-user-email | column=email | type="VARCHAR(255)" | constraints="UNIQUE, NOT NULL" | notes="PII — must be redacted in logs"
@MAP id=col-user-name | column=full_name | type="VARCHAR(128)" | constraints="NOT NULL" | notes="PII — must be redacted in logs"
@MAP id=col-user-phone | column=phone | type="VARCHAR(32)" | constraints=NULLABLE | notes="PII — must be redacted in logs"
@MAP id=col-user-role | column=role | type="ENUM('admin','manager','viewer')" | constraints="NOT NULL, DEFAULT 'viewer'"
@MAP id=col-user-team | column=team_id | type=UUID | constraints="FOREIGN KEY → teams.id"
@MAP id=col-user-created | column=created_at | type=TIMESTAMP | constraints="NOT NULL, DEFAULT NOW()"
@MAP id=col-user-login | column=last_login | type=TIMESTAMP | constraints=NULLABLE

@SEC name="invoices"
@NOTE text="Core invoice records."
@MAP id=col-inv-id | column=id | type=UUID | constraints="PRIMARY KEY"
@MAP id=col-inv-customer | column=customer_id | type=UUID | constraints="NOT NULL" | notes="External customer reference"
@MAP id=col-inv-status | column=status | type="ENUM('draft','sent','paid','overdue')" | constraints="NOT NULL, DEFAULT 'draft'"
@MAP id=col-inv-currency | column=currency | type="VARCHAR(3)" | constraints="NOT NULL, DEFAULT 'USD'" | notes="ISO 4217"
@MAP id=col-inv-total | column=total | type="DECIMAL(12,2)" | constraints="NOT NULL" | notes="Calculated from line_items"
@MAP id=col-inv-due | column=due_date | type=DATE | constraints=NULLABLE | notes="Required before sending"
@MAP id=col-inv-notes | column=notes | type=TEXT | constraints=NULLABLE
@MAP id=col-inv-payment | column=payment_method | type="VARCHAR(64)" | constraints=NULLABLE | notes="Set by admin only"
@MAP id=col-inv-created-by | column=created_by | type=UUID | constraints="FOREIGN KEY → users.id"
@MAP id=col-inv-created | column=created_at | type=TIMESTAMP | constraints="NOT NULL, DEFAULT NOW()"
@MAP id=col-inv-updated | column=updated_at | type=TIMESTAMP | constraints="NOT NULL" | notes="Auto-updated on change"

@SEC name="payments"
@NOTE text="Payment records linked to invoices."
@MAP id=col-pay-id | column=id | type=UUID | constraints="PRIMARY KEY"
@MAP id=col-pay-invoice | column=invoice_id | type=UUID | constraints="FOREIGN KEY → invoices.id, NOT NULL"
@MAP id=col-pay-amount | column=amount | type="DECIMAL(12,2)" | constraints="NOT NULL" | notes="Must be > 0"
@MAP id=col-pay-method | column=payment_method | type="VARCHAR(64)" | constraints="NOT NULL"
@MAP id=col-pay-ref | column=reference | type="VARCHAR(128)" | constraints="NOT NULL" | notes="External payment reference"
@MAP id=col-pay-recorded | column=recorded_by | type=UUID | constraints="FOREIGN KEY → users.id"
@MAP id=col-pay-created | column=created_at | type=TIMESTAMP | constraints="NOT NULL, DEFAULT NOW()"

@SEC name="audit_log"
@NOTE text="Immutable append-only log. Not exposed via REST. Written internally on every create, update, or status transition."
@MAP id=col-audit-id | column=id | type=BIGINT | constraints="PRIMARY KEY, AUTO_INCREMENT"
@MAP id=col-audit-entity-type | column=entity_type | type="VARCHAR(64)" | constraints="NOT NULL" | notes="'invoice' or 'payment'"
@MAP id=col-audit-entity-id | column=entity_id | type=UUID | constraints="NOT NULL"
@MAP id=col-audit-action | column=action | type="VARCHAR(32)" | constraints="NOT NULL" | notes="'create', 'update', 'status_change'"
@MAP id=col-audit-actor | column=actor_id | type=UUID | constraints="FOREIGN KEY → users.id"
@MAP id=col-audit-changes | column=changes | type=JSONB | constraints="NOT NULL" | notes="Before/after diff"
@MAP id=col-audit-created | column=created_at | type=TIMESTAMP | constraints="NOT NULL, DEFAULT NOW()"
